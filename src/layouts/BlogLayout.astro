---
import ContentLayout from './ContentLayout.astro';
import BreadcrumbNav from '../components/seo/BreadcrumbNav.astro';
import InlineEstimateBand from '../components/common/InlineEstimateBand.astro';
import ServiceTrustStrip from '../components/seo/ServiceTrustStrip.astro';
import { absoluteUrl } from '../data/business';
import { breadcrumbList, blogPostingSchema, webPage } from '../data/schema';
import { contentMaxClass, contentPaddingClass } from '../data/layout';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { data } = entry;
const pageUrl = absoluteUrl(`/blog/${data.slug}/`);
const title = data.seoTitle ?? `${data.title} | Elevate Your Space Handyman`;
const description =
  data.metaDescription ?? data.summary ?? `Homeowner tips and guides from Elevate Your Space Handyman.`;

const publishedDate = data.publishedAt.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const schemaGraph = [
  webPage(data.title, pageUrl, description),
  blogPostingSchema(data.title, pageUrl, description, data.publishedAt),
  breadcrumbList([
    { name: 'Home', url: absoluteUrl('/') },
    { name: 'Blog', url: absoluteUrl('/blog/') },
    { name: data.title, url: pageUrl },
  ]),
];
---

<ContentLayout
  seo={{ title, description, canonical: pageUrl, ogType: 'article' }}
  schemaGraph={schemaGraph}
>
  <article class="pb-16">
    <div class:list={['mx-auto', contentMaxClass, contentPaddingClass, 'pt-8']}>
      <BreadcrumbNav
        items={[
          { name: 'Home', url: '/' },
          { name: 'Blog', url: '/blog/' },
          { name: data.title, url: `/blog/${data.slug}/` },
        ]}
      />
    </div>

    <header class="eys-page-hero eys-on-dark">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 md:pt-16">
      <time datetime={data.publishedAt.toISOString()} class="eys-eyebrow eys-kicker text-eys-on-dark-2">
        {publishedDate}
      </time>
      <h1 class="eys-h1 mt-4 mb-5">{data.title}</h1>
      {
        data.summary && (
          <p class="eys-page-hero-lede eys-body">{data.summary}</p>
        )
      }
      {
        data.tags && data.tags.length > 0 && (
          <ul class="flex flex-wrap gap-2 mt-6">
            {data.tags.map((tag) => (
              <li class="text-xs font-medium bg-eys-panel text-eys-on-dark-2 px-3 py-1 rounded-full border border-eys-panel-line">
                {tag}
              </li>
            ))}
          </ul>
        )
      }
      </div>
      <div class="eys-stripe" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
    </header>

    <ServiceTrustStrip />

    <section class="bg-white border-t border-neutral-100">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 prose prose-gray">
        <slot />
      </div>
    </section>
    <InlineEstimateBand ctaLocation="blog_post_footer" />
  </article>
</ContentLayout>
