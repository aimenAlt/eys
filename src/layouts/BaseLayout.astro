---
import '../styles/global.css';
import SEOHead, { type SeoProps } from '../components/seo/SEOHead.astro';
import SchemaJsonLd from '../components/seo/SchemaJsonLd.astro';
import { site } from '../data/business';
import { wrapSchemaGraph } from '../data/schema';
import inter400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import inter700 from '@fontsource/inter/files/inter-latin-700-normal.woff2?url';

interface Props {
  seo?: SeoProps;
  schemaGraph?: unknown[];
}

const defaultSeo: SeoProps = {
  title: 'Handyman Services in Katy & West Houston | EYS',
  description:
    'Veteran-owned handyman service for repairs, installations, punch lists, finish carpentry and home upgrades across Katy and West Houston. Choose a photo estimate, To-Do List Visit or custom project estimate.',
  canonical: site.url,
};

const { seo = defaultSeo, schemaGraph = [] } = Astro.props;
const schemaData = schemaGraph.length ? wrapSchemaGraph(schemaGraph) : null;

// Only load analytics on the production domain, not in dev or GitHub Pages previews.
const enableAnalytics = import.meta.env.PROD && (import.meta.env.BASE_URL || '/') === '/';
const metaPixelId = '691010400673866';
---

<!doctype html>
<html lang="en-US" class="scroll-smooth">
  <head>
    <SEOHead {...seo} />
    <link rel="preload" href={inter400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={inter700} as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://d3ey4dbjkt2f6s.cloudfront.net" crossorigin />
    <link rel="preconnect" href="https://clienthub.getjobber.com" crossorigin />
    {schemaData && <SchemaJsonLd data={schemaData} />}
    {
      enableAnalytics && (
        <>
          <script async src="https://www.googletagmanager.com/gtag/js?id=G-9D5MCDT0L1" />
          <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', 'G-9D5MCDT0L1');
            // Google Ads conversion tracking - reuses the gtag.js library loaded above.
            gtag('config', 'AW-16988082106');
          </script>
          <!-- Meta Pixel -->
          <link rel="preconnect" href="https://connect.facebook.net" crossorigin />
          <script is:inline>
            !(function (f, b, e, v, n, t, s) {
              if (f.fbq) return;
              n = f.fbq = function () {
                n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
              };
              if (!f._fbq) f._fbq = n;
              n.push = n;
              n.loaded = !0;
              n.version = '2.0';
              n.queue = [];
              t = b.createElement(e);
              t.async = !0;
              t.src = v;
              s = b.getElementsByTagName(e)[0];
              s.parentNode.insertBefore(t, s);
            })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
            fbq('init', '691010400673866');
            fbq('track', 'PageView');
          </script>
        </>
      )
    }
  </head>
  <body
    class="font-sans text-brand-charcoal bg-brand-lightbg antialiased selection:bg-brand-red selection:text-white"
  >
    {
      enableAnalytics && (
        <noscript>
          <img
            height="1"
            width="1"
            style="display:none"
            src={`https://www.facebook.com/tr?id=${metaPixelId}&ev=PageView&noscript=1`}
            alt=""
          />
        </noscript>
      )
    }
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-white focus:text-brand-black focus:rounded-md focus:shadow-lg focus:ring-2 focus:ring-brand-red"
    >
      Skip to main content
    </a>
    <slot />
    <script>
      import '../scripts/conversion-analytics.ts';
    </script>
  </body>
</html>
