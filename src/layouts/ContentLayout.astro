---
import BaseLayout from './BaseLayout.astro';
import type { SeoProps } from '../components/seo/SEOHead.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import SiteBottomBar from '../components/site/SiteBottomBar.astro';
import VanBand from '../components/common/VanBand.astro';
import { isAdsLandingPage } from '../data/adsLandingPages';
import { getCollection } from 'astro:content';
import { buildNavMenus } from '../data/navMenus';
import { siteTheme } from '../data/sitePresentation';

interface Props {
  seo: SeoProps;
  schemaGraph?: unknown[];
  /** Hide the phone bottom bar (e.g. post-Jobber confirmation pages). */
  hideMobileStickyCta?: boolean;
}

const { seo, schemaGraph = [], hideMobileStickyCta = false } = Astro.props;

const [services, serviceAreas, communities] = await Promise.all([
  getCollection('services'),
  getCollection('serviceAreas'),
  getCollection('communities'),
]);

const navMenus = buildNavMenus(services, serviceAreas, communities);

/** Google Ads landing pages open with Eyad and the van (backlog 011). */
const showVanBand = isAdsLandingPage(Astro.url.pathname);
---

<!--
  Every page renders on `siteTheme`. Legacy page bodies inherit the system
  through the brand-* token re-map in global.css.
-->
<BaseLayout seo={seo} schemaGraph={schemaGraph} theme={siteTheme}>
  <SiteHeader navMenus={navMenus} />
  <main id="main-content">
    {showVanBand && <VanBand />}
    <slot />
  </main>
  {
    /* Breadcrumbs open the footer: same navy, dim text, no band of their own
       (Aimen, 26 Oct 2026). BreadcrumbList schema is emitted separately. */
    Astro.slots.has('breadcrumbs') && (
      <div class="eys-crumbs-strip bg-eys-ground">
        <div class="eys-container pt-8 lg:pt-10">
          <slot name="breadcrumbs" />
        </div>
      </div>
    )
  }
  <SiteFooter />
  {!hideMobileStickyCta && <SiteBottomBar />}
</BaseLayout>
