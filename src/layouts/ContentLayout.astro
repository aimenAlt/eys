---
import BaseLayout from './BaseLayout.astro';
import type { SeoProps } from '../components/seo/SEOHead.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import SiteBottomBar from '../components/site/SiteBottomBar.astro';
import VanBand from '../components/common/VanBand.astro';
import { isAdsLandingPage } from '../data/adsLandingPages';
import { getCollection } from 'astro:content';
import { buildNavMenus } from '../data/navMenus';

interface Props {
  seo: SeoProps;
  schemaGraph?: unknown[];
  /** Hide the phone bottom bar (e.g. post-Jobber confirmation pages). */
  hideMobileStickyCta?: boolean;
}

const { seo, schemaGraph = [], hideMobileStickyCta = false } = Astro.props;

const [services, serviceAreas, communities] = await Promise.all([
  getCollection('services'),
  getCollection('serviceAreas'),
  getCollection('communities'),
]);

const navMenus = buildNavMenus(services, serviceAreas, communities);

/** Google Ads landing pages open with Eyad and the van (backlog 011). */
const showVanBand = isAdsLandingPage(Astro.url.pathname);
---

<!--
  New site chrome (backlog 015) on the "black" theme: these page bodies still
  carry the legacy black heroes and #b00000 red buttons, so the chrome matches
  them (black grounds, #B00000 red, same gold). Each template switches to
  `siteTheme` when its body is redesigned.
-->
<BaseLayout seo={seo} schemaGraph={schemaGraph} theme="black">
  <SiteHeader navMenus={navMenus} />
  <main id="main-content">
    {showVanBand && <VanBand />}
    <slot />
  </main>
  <SiteFooter />
  {!hideMobileStickyCta && <SiteBottomBar />}
</BaseLayout>
