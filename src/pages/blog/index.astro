---
import { getCollection } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import PageHero from '../../components/common/PageHero.astro';
import ServiceTrustStrip from '../../components/seo/ServiceTrustStrip.astro';
import BreadcrumbNav from '../../components/seo/BreadcrumbNav.astro';
import InlineEstimateBand from '../../components/common/InlineEstimateBand.astro';
import BalancedGrid from '../../components/ui/BalancedGrid.astro';
import { absoluteUrl, localityShort, site } from '../../data/business';
import { breadcrumbList, webPage } from '../../data/schema';
import { contentMaxClass, contentPaddingClass } from '../../data/layout';

const posts = await getCollection('blog', ({ data }) => data.published === true);
posts.sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);

const postCards = posts.map((entry) => ({
  title: entry.data.title,
  description: entry.data.summary,
  href: `/blog/${entry.data.slug}/`,
  eyebrow: entry.data.publishedAt.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  }),
  eyebrowDatetime: entry.data.publishedAt.toISOString(),
}));

const title = `Blog | ${site.name}`;
const description =
  `Homeowner tips, project guides, and local handyman advice from Elevate Your Space Handyman in ${localityShort('and')}.`;
const canonical = absoluteUrl('/blog/');

const schemaGraph = [
  webPage('Blog', canonical, description),
  breadcrumbList([
    { name: 'Home', url: absoluteUrl('/') },
    { name: 'Blog', url: canonical },
  ]),
];
---

<ContentLayout seo={{ title, description, canonical }} schemaGraph={schemaGraph}>
  <article>

    <PageHero
      eyebrow="Homeowner Guides"
      title="Blog"
      description={`Practical advice on repairs, installations, and home improvements for homeowners in ${localityShort('and')}.`}
      layout="immersive"
      image={{
        src: '/images/projects/pergola-privacy-wall/eys-exterior-repair-wood-pergola-privacy-wall-during-p019-01.jpg',
        alt: 'Dark-stained wood pergola under construction on a concrete patio with an orange ladder.',
        width: 3840,
        height: 5120,
        position: '50% 45%',
      }}
    />

    <ServiceTrustStrip />

    <section class="py-10 md:py-12 bg-white">
      <div class:list={['mx-auto', contentMaxClass, contentPaddingClass]}>
        {
          postCards.length > 0 ? (
            <BalancedGrid variant="card" items={postCards} cols={2} gapClass="gap-6" />
          ) : (
            <p class="text-neutral-600 max-w-2xl">
              Articles on repairs, pricing factors, and homeowner tips will appear here as they are published.
            </p>
          )
        }
      </div>
    </section>
    <InlineEstimateBand ctaLocation="blog_index_footer" />
  </article>
  <BreadcrumbNav
    slot="breadcrumbs"
    items={[
      { name: 'Home', url: '/' },
      { name: 'Blog', url: '/blog/' },
    ]}
  />
</ContentLayout>
