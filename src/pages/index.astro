---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import MobileStickyCTA from '../components/layout/MobileStickyCTA.astro';
import HomeCurrentPage from '../components/home/HomeCurrentPage.astro';
import HomeSmallRepairPage from '../components/home/HomeSmallRepairPage.astro';
import { getCollection } from 'astro:content';
import { absoluteUrl } from '../data/business';
import { defaultOgImageAlt } from '../data/images';
import { homePageSchema, homeFaqs } from '../data/schema';
import { buildNavMenus } from '../data/navMenus';
import { homepageVariant } from '../data/sitePresentation';

const [publishedReviews, allServices, serviceAreas, communities] = await Promise.all([
  getCollection('reviews', ({ data }) => data.published === true),
  getCollection('services'),
  getCollection('serviceAreas', ({ data }) => data.published === true),
  getCollection('communities', ({ data }) => data.published === true),
]);

const navMenus = buildNavMenus(allServices, serviceAreas, communities);

const cityLinks = serviceAreas.map((a) => ({ title: a.data.title, slug: a.data.slug }));
const communityLinks = communities.map((c) => ({
  title: c.data.title,
  citySlug: c.data.citySlug,
  slug: c.data.slug,
}));

const seo = {
  title: 'Handyman Services in Katy & West Houston | EYS',
  description:
    'Veteran-owned handyman service for repairs, installations, punch lists, finish carpentry and home upgrades across Katy and West Houston. Choose a photo estimate, To-Do List Visit or custom project estimate.',
  canonical: absoluteUrl('/'),
  ogImageAlt: defaultOgImageAlt,
};

const schemaGraph = homePageSchema(homeFaqs);

const pageProps = {
  projectCount: serviceAreas.length,
  publishedReviews,
  cityLinks,
  communityLinks,
};
---

<BaseLayout seo={seo} schemaGraph={schemaGraph}>
  <Header navMenus={navMenus} />
  <main id="main-content">
    {
      homepageVariant === 'small-repair' ? (
        <HomeSmallRepairPage {...pageProps} />
      ) : (
        <HomeCurrentPage {...pageProps} />
      )
    }
  </main>
  <Footer />
  <MobileStickyCTA />
</BaseLayout>
