---
import BaseLayout from '../layouts/BaseLayout.astro';
import VanBand from '../components/common/VanBand.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import SiteBottomBar from '../components/site/SiteBottomBar.astro';
import HomeRedesignPage from '../components/home/redesign/HomeRedesignPage.astro';
import HomeCurrentPage from '../components/home/HomeCurrentPage.astro';
import HomeSmallRepairPage from '../components/home/HomeSmallRepairPage.astro';
import { getCollection } from 'astro:content';
import { absoluteUrl, googleReviews } from '../data/business';
import { defaultOgImageAlt } from '../data/images';
import { homePageSchema, homeFaqs } from '../data/schema';
import { buildNavMenus } from '../data/navMenus';
import { homepageVariant, siteTheme } from '../data/sitePresentation';

const [publishedReviews, allServices, serviceAreas, communities] = await Promise.all([
  getCollection('reviews', ({ data }) => data.published === true),
  getCollection('services'),
  getCollection('serviceAreas', ({ data }) => data.published === true),
  getCollection('communities', ({ data }) => data.published === true),
]);

const navMenus = buildNavMenus(allServices, serviceAreas, communities);

const cityLinks = serviceAreas.map((a) => ({ title: a.data.title, slug: a.data.slug }));
const communityLinks = communities.map((c) => ({
  title: c.data.title,
  citySlug: c.data.citySlug,
  slug: c.data.slug,
}));

const seo = {
  title: 'Katy Handyman | Elevate Your Space Handyman',
  description:
    `Veteran-owned, insured Katy handyman: repairs, installs, punch lists, finish carpentry ` +
    `and media walls in Katy, Fulshear & Cypress. ${googleReviews.rating.toFixed(1)}-rated on Google.`,
  canonical: absoluteUrl('/'),
  ogImageAlt: defaultOgImageAlt,
};

const schemaGraph = homePageSchema(homeFaqs);

/**
 * Eyad and the van lead the old homepage (backlog 011). The redesign (013/014)
 * already uses the same photo as its hero, so it never gets the band.
 */
const isRedesign = homepageVariant === 'redesign';
const showVanBand = !isRedesign;

const pageProps = {
  projectCount: serviceAreas.length,
  publishedReviews,
  cityLinks,
  communityLinks,
};
---

{
  isRedesign ? (
    <BaseLayout seo={seo} schemaGraph={schemaGraph} theme={siteTheme}>
      <SiteHeader navMenus={navMenus} />
      <main id="main-content">
        <HomeRedesignPage {...pageProps} />
      </main>
      <SiteFooter />
      <SiteBottomBar />
    </BaseLayout>
  ) : (
<BaseLayout seo={seo} schemaGraph={schemaGraph} theme="black">
  <SiteHeader navMenus={navMenus} />
  <main id="main-content">
    {showVanBand && <VanBand />}
    {
      homepageVariant === 'small-repair' ? (
        <HomeSmallRepairPage {...pageProps} />
      ) : (
        <HomeCurrentPage {...pageProps} />
      )
    }
  </main>
  <SiteFooter />
  <SiteBottomBar />
</BaseLayout>
  )
}
