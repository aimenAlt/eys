---
import '../../styles/global.css';
import SEOHead from '../../components/seo/SEOHead.astro';
import { absoluteUrl } from '../../data/business';
import {
  GO_DEFAULT_TONE,
  goLinksByGroup,
  goMessagesByTone,
  goRowLabel,
  goTone,
  goTones,
} from '../../data/goLinks';

/**
 * Essa's private share page — the notes-app replacement.
 *
 * Deliberately does NOT use BaseLayout. BaseLayout is where gtag.js, the Ads
 * tag, the Meta Pixel and conversion-analytics.ts load, and Essa opens this
 * page many times a day. Routing his own visits into GA4 would inflate every
 * conversion rate on the site, so this page ships its own <html> shell with no
 * analytics of any kind. Do not "tidy" it onto BaseLayout.
 *
 * DENSITY IS THE FEATURE. The first version rendered each link as a card with
 * the whole message printed inside it: twelve links became four screens of
 * scrolling to reach the one he wanted. All twelve now fit on a 390x844 phone
 * without scrolling — one row each, name on the left, Share and Copy on the
 * right. The full message is not shown (it never changes, and he wrote it); it
 * rides along in the row's `title` so a long-press still reveals it.
 */

const rows = (group: 'phone-leads' | 'searchable') =>
  goLinksByGroup(group).map((entry) => ({
    label: goRowLabel(entry),
    // All three openers ship with every row; the switcher just decides which
    // one Share and Copy read. Cheaper than re-rendering, and it means the
    // page keeps working with no network.
    texts: goMessagesByTone(entry),
    search: `${entry.label} ${entry.keywords}`.toLowerCase(),
  }));

const pinned = rows('phone-leads');
const searchable = rows('searchable');

const seo = {
  title: 'Send a link — EYS internal',
  description: 'Private share page: ready-made text messages for EYS request forms.',
  canonical: absoluteUrl('/essa/'),
  noindex: true,
};

const headingClass =
  'flex items-center gap-2 text-[0.6875rem] font-bold uppercase tracking-[0.13em] text-brand-muted';
const rowClass =
  'flex items-center gap-1.5 rounded-lg border border-brand-line bg-white py-[3px] pl-3 pr-[3px]';
const pinnedRowClass = `${rowClass} border-l-[3px] border-l-brand-red`;
const nameClass = 'min-w-0 flex-1 truncate text-[0.875rem] font-bold text-brand-black';
const shareClass =
  'h-11 w-[4.25rem] shrink-0 rounded-md bg-brand-red text-[0.8125rem] font-bold text-white transition-colors active:bg-brand-redhover';
const copyClass =
  'h-11 w-[3.75rem] shrink-0 rounded-md border border-brand-line text-[0.8125rem] font-bold text-brand-charcoal transition-colors active:bg-brand-lightbg';

const toneButtonClass =
  'h-10 rounded-md border px-0.5 text-[0.75rem] font-bold leading-tight transition-colors aria-pressed:border-brand-red aria-pressed:bg-brand-red aria-pressed:text-white';
const toneIdleClass = 'border-brand-line bg-white text-brand-charcoal';
---

<!doctype html>
<html lang="en-US">
  <head>
    <SEOHead {...seo} />
    <!--
      Installable as a home-screen app, for this page only. The manifest and
      the service worker both live under /essa/, which is what keeps the
      worker's scope off the rest of the site.
    -->
    <link rel="manifest" href="/essa/manifest.webmanifest" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="EYS Links" />
  </head>
  <body class="bg-brand-lightbg font-sans text-brand-charcoal antialiased">
    <main class="mx-auto max-w-lg px-3 pb-3 pt-3">
      <h1 class="sr-only">Send a client a request-form link</h1>

      <!--
        Who he is texting, chosen once for the whole page rather than per row —
        eleven rows times three buttons would not fit a phone, and he knows the
        situation before he knows which form he wants.

        Deliberately NOT remembered between visits. Opening the page fresh
        resets to "Answered", because the expensive mistake here is sending
        "Nice talking with you" to someone he has never spoken to, not having
        to tap a button twice during a batch.
      -->
      <div
        class="grid grid-cols-4 gap-1"
        role="group"
        aria-label="Who are you texting?"
        data-go-tones
      >
        {
          goTones.map((tone) => (
            <button
              type="button"
              class:list={[toneButtonClass, toneIdleClass]}
              data-go-tone={tone.id}
              data-go-opener={tone.preview ?? tone.opener}
              aria-pressed={tone.id === GO_DEFAULT_TONE ? 'true' : 'false'}
            >
              {tone.label}
            </button>
          ))
        }
      </div>
      <!-- The rows show no message text, so this is his only sight of the opener. -->
      <p
        class="mt-1 truncate text-[0.6875rem] leading-tight text-brand-muted"
        data-go-tone-preview
      >
        {goTone(GO_DEFAULT_TONE).preview ?? goTone(GO_DEFAULT_TONE).opener}
      </p>

      <section class="mt-3" aria-labelledby="essa-phone-leads">
        <h2 id="essa-phone-leads" class={headingClass}>
          <span class="h-[3px] w-6 rounded-full bg-brand-red" aria-hidden="true"></span>
          Phone leads
        </h2>
        <div class="mt-1.5 space-y-1.5">
          {
            pinned.map((row) => (
              <div
                class={pinnedRowClass}
                data-go-item
                data-text-answered={row.texts.answered}
                data-text-missed={row.texts.missed}
                data-text-cold={row.texts.cold}
                data-text-link={row.texts.link}
                title={row.texts.answered}
              >
                <span class={nameClass}>{row.label}</span>
                <button type="button" class={shareClass} data-go-share aria-label={`Share ${row.label}`}>
                  Share
                </button>
                <button type="button" class={copyClass} data-go-copy aria-label={`Copy ${row.label}`}>
                  Copy
                </button>
              </div>
            ))
          }
        </div>
      </section>

      <section class="mt-4" aria-labelledby="essa-other-links">
        <h2 id="essa-other-links" class={headingClass}>
          <span class="h-[3px] w-6 rounded-full bg-brand-charcoal" aria-hidden="true"></span>
          Other links
        </h2>

        <label class="sr-only" for="go-search">Search links</label>
        <input
          id="go-search"
          type="search"
          inputmode="search"
          enterkeyhint="search"
          autocomplete="off"
          autocorrect="off"
          spellcheck="false"
          placeholder="Search — tv, curtains, bathroom…"
          class="mt-1.5 h-11 w-full rounded-lg border border-brand-line bg-white px-3 text-[0.9375rem] text-brand-black placeholder:text-brand-muted focus:border-brand-red focus:outline-none"
          data-go-search
        />

        <div class="mt-1.5 space-y-1.5" data-go-results>
          {
            searchable.map((row) => (
              <div
                class={rowClass}
                data-go-item
                data-search={row.search}
                data-text-answered={row.texts.answered}
                data-text-missed={row.texts.missed}
                data-text-cold={row.texts.cold}
                data-text-link={row.texts.link}
                title={row.texts.answered}
              >
                <span class={nameClass}>{row.label}</span>
                <button type="button" class={shareClass} data-go-share aria-label={`Share ${row.label}`}>
                  Share
                </button>
                <button type="button" class={copyClass} data-go-copy aria-label={`Copy ${row.label}`}>
                  Copy
                </button>
              </div>
            ))
          }
          <p
            class="rounded-lg border border-dashed border-brand-line px-3 py-4 text-center text-[0.8125rem] text-brand-muted"
            data-go-empty
            hidden
          >
            No link matches that.
          </p>
        </div>
      </section>

      <!--
        Install prompt. Sits at the BOTTOM on purpose: the eleven rows are
        sized to fit one 390x844 screen with ~95px to spare, and a banner above
        them would push the last link off. Hidden until Chrome actually offers
        `beforeinstallprompt`, so it never appears once the app is installed.
      -->
      <div
        class="mt-3 flex items-center gap-2.5 rounded-lg border border-brand-line bg-brand-black py-2 pl-3 pr-2 text-white"
        data-pwa-banner
        hidden
      >
        <img
          src="/essa/icon-192.png"
          alt=""
          width="192"
          height="192"
          class="h-8 w-8 shrink-0 rounded-md"
          aria-hidden="true"
        />
        <span class="min-w-0 flex-1 text-[0.8125rem] font-bold leading-tight">
          Hey Essa &mdash; add this to your Home Screen
        </span>
        <button
          type="button"
          class="h-9 shrink-0 rounded-md bg-brand-red px-3 text-[0.8125rem] font-bold text-white"
          data-pwa-install
        >
          Add
        </button>
        <button
          type="button"
          class="h-9 w-8 shrink-0 rounded-md text-[0.9375rem] font-bold text-white/60"
          data-pwa-dismiss
          aria-label="Not now"
        >
          &times;
        </button>
      </div>
    </main>

    <!--
      is:inline so nothing here is bundled with the site's shared client
      modules. This page must stay analytics-free.
    -->
    <script is:inline>
      (function () {
        var RESET_MS = 1600;

        /* ---- Which opener Share and Copy use --------------------------- */

        // Never persisted: a fresh page is always "Answered". Sending "Nice
        // talking with you" to someone he has never spoken to is the mistake
        // worth designing against.
        var activeTone = 'answered';
        var toneButtons = [].slice.call(document.querySelectorAll('[data-go-tone]'));
        var tonePreview = document.querySelector('[data-go-tone-preview]');

        /** The text for one row, in whichever tone is currently selected. */
        function textFor(item) {
          return (
            item.getAttribute('data-text-' + activeTone) ||
            item.getAttribute('data-text-answered') ||
            ''
          );
        }

        function selectTone(id) {
          activeTone = id;
          toneButtons.forEach(function (button) {
            var on = button.getAttribute('data-go-tone') === id;
            button.setAttribute('aria-pressed', on ? 'true' : 'false');
            if (on && tonePreview) {
              tonePreview.textContent = button.getAttribute('data-go-opener') || '';
            }
          });
          // Keep the long-press tooltip honest about what would actually send.
          [].slice.call(document.querySelectorAll('[data-go-item]')).forEach(function (item) {
            item.setAttribute('title', textFor(item));
          });
        }

        toneButtons.forEach(function (button) {
          button.addEventListener('click', function () {
            selectTone(button.getAttribute('data-go-tone') || 'answered');
          });
        });

        function flash(button, mark) {
          if (!button) return;
          if (!button.dataset.idleLabel) button.dataset.idleLabel = button.textContent || '';
          button.textContent = mark;
          var row = button.closest('[data-go-item]');
          if (row) row.classList.add('ring-2', 'ring-brand-red');
          window.clearTimeout(Number(button.dataset.resetTimer || 0));
          button.dataset.resetTimer = String(
            window.setTimeout(function () {
              button.textContent = button.dataset.idleLabel;
              if (row) row.classList.remove('ring-2', 'ring-brand-red');
            }, RESET_MS),
          );
        }

        /** execCommand path for Android WebViews and any non-secure context. */
        function legacyCopy(text) {
          var area = document.createElement('textarea');
          area.value = text;
          area.setAttribute('readonly', '');
          area.style.position = 'fixed';
          area.style.top = '0';
          area.style.left = '0';
          area.style.opacity = '0';
          document.body.appendChild(area);
          area.select();
          area.setSelectionRange(0, text.length);
          var ok = false;
          try {
            ok = document.execCommand('copy');
          } catch (err) {
            ok = false;
          }
          document.body.removeChild(area);
          return ok;
        }

        async function copyText(text, button) {
          var ok = false;
          try {
            if (navigator.clipboard && navigator.clipboard.writeText) {
              await navigator.clipboard.writeText(text);
              ok = true;
            }
          } catch (err) {
            ok = false;
          }
          if (!ok) ok = legacyCopy(text);
          flash(button, ok ? '✓' : '✗');
        }

        async function shareText(text, button) {
          if (navigator.share) {
            try {
              // `text` only, never `url`: a `url` field is appended after the
              // text by most share targets, which would put the link below the
              // sign-off instead of in the middle of the message.
              await navigator.share({ text: text });
              return;
            } catch (err) {
              // The user closing the share sheet is not a failure.
              if (err && (err.name === 'AbortError' || err.name === 'NotAllowedError')) return;
            }
          }
          // Falls back on the button that was actually pressed, so the feedback
          // lands where he tapped.
          await copyText(text, button);
        }

        document.addEventListener('click', function (event) {
          var trigger = event.target.closest('[data-go-share], [data-go-copy]');
          if (!trigger) return;
          var item = trigger.closest('[data-go-item]');
          if (!item) return;
          var text = textFor(item);
          if (trigger.hasAttribute('data-go-share')) {
            shareText(text, trigger);
          } else {
            copyText(text, trigger);
          }
        });

        /* ---- Home-screen install ------------------------------------- */

        var DISMISS_KEY = 'eys_essa_install_dismissed';
        var banner = document.querySelector('[data-pwa-banner]');
        var deferredPrompt = null;

        function hideBanner() {
          if (banner) banner.hidden = true;
        }

        if ('serviceWorker' in navigator) {
          window.addEventListener('load', function () {
            // `scope` is explicit and matches the file's own directory.
            // Registering a worker from anywhere else would widen this to the
            // whole site.
            //
            // `updateViaCache: 'none'` is what actually guarantees a new
            // worker is picked up promptly. Cloudflare serves /essa/sw.js with
            // a four-hour max-age, but the default ('imports') already
            // bypasses the HTTP cache for the worker script itself; 'none'
            // states that intent outright and keeps holding if this file ever
            // grows an importScripts() call.
            navigator.serviceWorker
              .register('/essa/sw.js', { scope: '/essa/', updateViaCache: 'none' })
              .catch(function () {
                /* no worker, no install prompt — the page itself still works */
              });
          });
        }

        window.addEventListener('beforeinstallprompt', function (event) {
          event.preventDefault();
          deferredPrompt = event;
          var dismissed = false;
          try {
            dismissed = localStorage.getItem(DISMISS_KEY) === '1';
          } catch (err) {
            dismissed = false;
          }
          if (!dismissed && banner) banner.hidden = false;
        });

        window.addEventListener('appinstalled', function () {
          deferredPrompt = null;
          hideBanner();
        });

        var installButton = document.querySelector('[data-pwa-install]');
        if (installButton) {
          installButton.addEventListener('click', async function () {
            if (!deferredPrompt) {
              hideBanner();
              return;
            }
            hideBanner();
            deferredPrompt.prompt();
            try {
              await deferredPrompt.userChoice;
            } catch (err) {
              /* dialog dismissed — nothing to do */
            }
            // A prompt can only be used once. Chrome fires a fresh
            // beforeinstallprompt if he declines and comes back later.
            deferredPrompt = null;
          });
        }

        var dismissButton = document.querySelector('[data-pwa-dismiss]');
        if (dismissButton) {
          dismissButton.addEventListener('click', function () {
            hideBanner();
            try {
              localStorage.setItem(DISMISS_KEY, '1');
            } catch (err) {
              /* private mode — it simply reappears next visit */
            }
          });
        }

        /* ---- Search ---------------------------------------------------- */

        var search = document.querySelector('[data-go-search]');
        var results = document.querySelector('[data-go-results]');
        var empty = document.querySelector('[data-go-empty]');
        if (search && results) {
          var items = Array.prototype.slice.call(results.querySelectorAll('[data-search]'));
          search.addEventListener('input', function () {
            var terms = search.value.toLowerCase().split(/\s+/).filter(Boolean);
            var shown = 0;
            items.forEach(function (item) {
              var haystack = item.getAttribute('data-search') || '';
              var match = terms.every(function (term) {
                return haystack.indexOf(term) !== -1;
              });
              item.hidden = !match;
              if (match) shown += 1;
            });
            if (empty) empty.hidden = shown !== 0;
          });
        }
      })();
    </script>
  </body>
</html>
