---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteTheme } from '../../data/sitePresentation';
import {
  absoluteUrl,
  googleReviewCountDisplay,
  googleReviewProfileUrl,
  googleReviews,
  site,
} from '../../data/business';
import {
  GO_CHOOSER_PATH,
  GO_DEFAULT_REVIEW,
  goCtaLocation,
  goReviewExcerpt,
  goReviewIsTrimmed,
  resolveGoChooser,
} from '../../data/goLinks';

/**
 * Unlisted service chooser — the one link Quo's missed-call texts send, and the
 * one Hamid or Essa share when they do not know the job yet. Two taps at most,
 * no free text, no AI: every path ends on one of the `goLinks` forms.
 *
 * Same shell as /go/[slug]/: no header, nav, footer, sticky bar or second
 * destination. The hero and the review block mirror that page's markup; it is
 * not shared through a component because that page's scoped <style> stamps a
 * cid on every element, and extracting it would change /go/<slug>/ output.
 *
 * Step 1's four options must clear the fold on a 390x844 phone — measure
 * before adding height above them.
 *
 * Without JS every step renders in order under its own heading, and the step-1
 * options that open a step are plain #anchors to it, so the page still works.
 * With JS the later steps are hidden and swap in place, with a Back button.
 */

// Throws, failing the build, if an option names a goLinks slug that does not
// exist or a form the chooser must never use.
const steps = resolveGoChooser();

const review = await getEntry('reviews', GO_DEFAULT_REVIEW);
if (!review) {
  throw new Error(`go/: review "${GO_DEFAULT_REVIEW}" is missing from src/content/reviews/.`);
}
if (review.data.published !== true) {
  throw new Error(`go/: review "${GO_DEFAULT_REVIEW}" is not published.`);
}

const rating = googleReviews.rating.toFixed(1);
const reviewCount = googleReviewCountDisplay();
const gbpUrl = googleReviewProfileUrl();
const reviewText = goReviewExcerpt(review.data.text);
const reviewTrimmed = goReviewIsTrimmed(review.data.text);
const pageUrl = absoluteUrl(GO_CHOOSER_PATH);

const portrait = '/images/team/essa-portrait.webp';
const portraitAlt = 'Essa, owner of Elevate Your Space Handyman';

// Unlisted, like /go/<slug>/: kept out of the index, not walled off.
const seo = {
  title: "Let's get your project started — EYS Handyman",
  description: `From Essa, owner of Elevate Your Space Handyman · ★ ${rating} on Google`,
  canonical: pageUrl,
  ogImage: '/images/team/essa-og.jpg',
  ogImageAlt: portraitAlt,
  noindex: true,
};

const stepId = (id: string) => `go-${id}`;

const optionClass =
  'flex min-h-[3.5rem] w-full items-center justify-between gap-3 rounded-xl border border-brand-line bg-white py-3 pl-4 pr-3.5 text-left text-[1.0625rem] font-bold leading-snug text-brand-black shadow-card transition-colors hover:border-brand-red active:bg-brand-lightbg focus-visible:border-brand-red';
---

<BaseLayout seo={seo} theme={siteTheme}>
  <main id="main-content" class="min-h-screen bg-brand-lightbg">
    <section
      class="border-t-[3px] border-brand-red bg-brand-black px-5 pb-5 pt-5 text-white sm:px-6 sm:pb-8 sm:pt-8"
    >
      <div
        class="mx-auto flex max-w-lg flex-col items-center gap-3.5 text-center sm:flex-row sm:items-center sm:gap-5 sm:text-left"
      >
        <img
          src={portrait}
          alt={portraitAlt}
          width="512"
          height="512"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="h-40 w-40 shrink-0 rounded-2xl object-cover ring-1 ring-white/20 sm:h-32 sm:w-32 sm:rounded-xl"
        />
        <h1 class="text-[1.45rem] font-bold leading-[1.2] tracking-tight sm:text-[1.7rem]">
          Hi, I&rsquo;m Essa &mdash; I own EYS, and I write every quote myself.
        </h1>
      </div>
    </section>

    <div class="mx-auto max-w-lg px-5 pb-14 pt-5 sm:px-6 sm:pt-7">
      <div class="space-y-7" data-go-chooser>
        {
          steps.map((step) => (
            <section
              id={stepId(step.id)}
              data-go-step={step.id}
              aria-labelledby={`${stepId(step.id)}-heading`}
            >
              {step.id !== 'start' && (
                <button
                  type="button"
                  data-go-back
                  hidden
                  class="-ml-1 mb-1 inline-flex min-h-[2.75rem] items-center gap-1 rounded-md px-1 text-[0.9375rem] font-bold text-brand-charcoal transition-colors hover:text-brand-red"
                >
                  <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true" class="shrink-0">
                    <path
                      d="M12.5 4.5 7 10l5.5 5.5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.25"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  Back
                </button>
              )}
              <h2
                id={`${stepId(step.id)}-heading`}
                tabindex="-1"
                class="text-[1.3rem] leading-tight text-brand-black focus:outline-none sm:text-[1.45rem]"
              >
                {step.heading}
              </h2>
              <ul class="mt-3 space-y-2" role="list">
                {step.options.map((option) => (
                  <li>
                    {option.kind === 'form' ? (
                      // Plain same-tab anchor: the GA4 cross-domain linker only
                      // decorates a click it can see, and target="_blank" loses
                      // the session. Same rule as /go/<slug>/.
                      <a
                        href={option.href}
                        data-cta-location={option.ctaLocation}
                        data-booking-type={option.bookingType}
                        class={optionClass}
                      >
                        <span>{option.label}</span>
                        <svg
                          width="20"
                          height="20"
                          viewBox="0 0 20 20"
                          aria-hidden="true"
                          class="shrink-0 text-brand-red"
                        >
                          <path
                            d="M7.5 4.5 13 10l-5.5 5.5"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.25"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      </a>
                    ) : (
                      <a
                        href={`#${stepId(option.step)}`}
                        data-go-open={option.step}
                        data-cta-id="go_chooser_step"
                        data-cta-location={option.ctaLocation}
                        class={optionClass}
                      >
                        <span>{option.label}</span>
                        <svg
                          width="20"
                          height="20"
                          viewBox="0 0 20 20"
                          aria-hidden="true"
                          class="shrink-0 text-brand-red"
                        >
                          <path
                            d="M7.5 4.5 13 10l-5.5 5.5"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.25"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>

      <!--
        Inline and directly after the steps, so the later steps are hidden
        before first paint rather than flashing in and collapsing.
      -->
      <script is:inline>
        (function () {
          var root = document.querySelector('[data-go-chooser]');
          if (!root) return;
          var steps = [].slice.call(root.querySelectorAll('[data-go-step]'));
          var lastOpener = null;

          function show(id) {
            var shown = null;
            steps.forEach(function (step) {
              var on = step.getAttribute('data-go-step') === id;
              step.hidden = !on;
              if (on) shown = step;
            });
            return shown;
          }

          [].slice.call(root.querySelectorAll('[data-go-back]')).forEach(function (button) {
            button.hidden = false;
            button.addEventListener('click', function () {
              show('start');
              if (lastOpener) lastOpener.focus();
            });
          });

          [].slice.call(root.querySelectorAll('[data-go-open]')).forEach(function (opener) {
            opener.addEventListener('click', function (event) {
              var step = show(opener.getAttribute('data-go-open'));
              if (!step) return;
              // Swap in place, never jump: no hash in the URL and no history
              // entry (a history change would also count as a page view).
              event.preventDefault();
              lastOpener = opener;
              var heading = step.querySelector('h2');
              if (heading) {
                heading.focus({ preventScroll: true });
                if (heading.getBoundingClientRect().top < 0) heading.scrollIntoView();
              }
            });
          });

          show('start');
        })();
      </script>

      <!-- Opens the Google profile in a new tab, so the chooser stays put. -->
      <figure
        class="mt-8 rounded-xl border border-brand-line border-l-[3px] border-l-brand-red bg-white shadow-card"
      >
        <a
          href={gbpUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-cta-location={goCtaLocation('chooser', 'review')}
          class="block rounded-xl p-3.5 transition-colors hover:bg-brand-lightbg sm:p-5"
        >
          <blockquote class="text-[0.95rem] leading-relaxed text-brand-ink sm:text-base">
            &ldquo;{reviewText}&rdquo;
          </blockquote>
          <figcaption
            class="mt-3 flex flex-wrap items-center gap-x-1.5 text-[0.7rem] font-bold uppercase tracking-[0.1em] text-brand-muted"
          >
            <span>{review.data.author} &middot; Google review</span>
            <span class="text-brand-red normal-case tracking-normal">
              {reviewTrimmed ? 'Read it on Google →' : 'See on Google →'}
            </span>
          </figcaption>
        </a>
      </figure>

      <p class="mt-3 flex flex-wrap items-baseline gap-x-1.5 text-[0.8125rem] font-semibold text-brand-muted">
        <span class="text-[0.9375rem] leading-none text-brand-red" aria-hidden="true">★</span>
        <span>
          <span class="sr-only">Rated </span>{rating} &middot;{' '}
          <a
            href={gbpUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-cta-location={goCtaLocation('chooser', 'review_count')}
            class="underline decoration-brand-line underline-offset-2 hover:text-brand-red hover:decoration-brand-red"
          >
            {reviewCount} Google reviews
          </a> &middot; Veteran-owned
        </span>
      </p>

      <p class="mt-5 text-center text-sm text-brand-muted">
        <a
          href={`tel:+1${site.phoneTel}`}
          data-cta-location={goCtaLocation('chooser', 'call')}
          class="font-semibold text-brand-charcoal underline decoration-brand-line underline-offset-4 transition-colors hover:text-brand-red hover:decoration-brand-red"
        >
          Rather talk? Call {site.phone}
        </a>
      </p>
    </div>
  </main>
</BaseLayout>
