---
import { getEntry } from 'astro:content';
import HandoffPage from '../../components/go/HandoffPage.astro';
import { absoluteUrl, googleReviews, site } from '../../data/business';
import {
  GO_DEFAULT_REVIEW,
  goCtaLocation,
  goJobberUrl,
  goLinks,
  goPagePath,
  type GoLink,
} from '../../data/goLinks';

/**
 * Unlisted client handoff page. Essa texts `/go/<slug>/` after a phone call and
 * the client lands here instead of on a bare clienthub.getjobber.com URL: one
 * face, one review, one button.
 *
 * The page itself (portrait, review card, rating line, button, countdown,
 * auto-open) is `HandoffPage`, shared with the `/q/<code>` quote intro. This
 * file supplies only the copy and the destination. Items above the button are
 * sized to clear the fold on a 390x844 phone — measure before adding height.
 */

export function getStaticPaths() {
  return goLinks.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

interface Props {
  entry: GoLink;
}

const { entry } = Astro.props as Props;

// Imported, never retyped: the same review records `/reviews/` renders. Each
// form shows the review closest to its own work where one exists (see
// `GoLink.reviewId`), and GO_DEFAULT_REVIEW where none does.
const reviewId = entry.reviewId ?? GO_DEFAULT_REVIEW;
const review = await getEntry('reviews', reviewId);
if (!review) {
  throw new Error(
    `go/${entry.slug}: review "${reviewId}" is missing from src/content/reviews/.`,
  );
}
if (review.data.published !== true) {
  throw new Error(`go/${entry.slug}: review "${reviewId}" is not published.`);
}

const rating = googleReviews.rating.toFixed(1);
const pageUrl = absoluteUrl(goPagePath(entry.slug));
const portraitAlt = 'Essa, owner of Elevate Your Space Handyman';

// Unlisted: reached only from a text message. `follow` (not nofollow) matches
// /start/ and /van/ — kept out of the index, not walled off.
const seo = {
  title: "Let's get your project started — EYS Handyman",
  description: `From Essa, owner of Elevate Your Space Handyman · ★ ${rating} on Google`,
  canonical: pageUrl,
  // 1200x630 crop of the same photo — the card a text message or WhatsApp
  // renders is his face, not a generic project shot.
  ogImage: '/images/team/essa-og.jpg',
  ogImageAlt: portraitAlt,
  noindex: true,
};
---

<HandoffPage
  seo={seo}
  review={review.data}
  reviewCtaLocation={goCtaLocation(entry.slug, 'review')}
  reviewCountCtaLocation={goCtaLocation(entry.slug, 'review_count')}
  ctaHref={goJobberUrl(entry)}
  ctaLabel={entry.buttonLabel}
  ctaLocation={goCtaLocation(entry.slug)}
  bookingType={entry.bookingType}
  handoffNoun="your form"
  callLabel={`Rather talk? Call ${site.phone}`}
  callCtaLocation={goCtaLocation(entry.slug, 'call')}
>
  <Fragment slot="headline">Hi, I&rsquo;m Essa &mdash; I own EYS, and I write every quote myself.</Fragment>

  <p class="mt-4 text-[0.95rem] font-bold leading-snug text-brand-black sm:text-base">
    Every quote is itemized &mdash; no surprise fees.
  </p>

  <p class="mt-1.5 text-[0.9375rem] leading-relaxed text-brand-muted">
    {entry.next}
  </p>
</HandoffPage>
