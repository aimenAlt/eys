---
/**
 * Paid landing page — Google Ads ad group "Built-Ins, Shelving & Storage"
 * (campaign 24242755343). Backlog item docs/claude-code-backlog/002.
 *
 * NOT an SEO page: noindex,follow, self-canonical, excluded from the sitemap
 * (`/lp/` filter in astro.config.mjs). `/services/custom-carpentry/` stays the
 * organic page for this demand — do not link it as a replacement for that page.
 *
 * Phone first: every paid Google lead in Aug 29–Oct 10 2026 arrived by phone,
 * so the call button leads and the estimate form is the second option.
 *
 * Tracking needs nothing page-specific: BaseLayout loads conversion-analytics,
 * which fires `phone_click` for the tel: links and `jobber_booking_click`
 * (booking_type inferred as `project_estimate` from form 4985623) for the
 * Jobber links, both carrying the `data-cta-location` set here. `eys_form` is
 * baked in by `jobberProjectEstimateFormUrl()`; `eys_lp` is stamped at runtime
 * by jobber-attribution.ts. `page_type` resolves to `lp_landing`.
 *
 * No prices on this page — built-ins are quoted from photos.
 */
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteTheme } from '../../data/sitePresentation';
import VanBand from '../../components/common/VanBand.astro';
import Logo from '../../components/layout/Logo.astro';
import SiteImage from '../../components/ui/SiteImage.astro';
import StartFooter from '../../components/start-landing/StartFooter.astro';
import {
  absoluteUrl,
  googleReviewCountDisplay,
  googleReviewProfileUrl,
  googleReviews,
  jobberProjectEstimateFormUrl,
  localityShort,
  site,
} from '../../data/business';
import { breadcrumbList, webPage } from '../../data/schema';
import { withBase } from '../../utils/paths';

const pagePath = '/lp/built-ins-shelving-storage/';
const pageUrl = absoluteUrl(pagePath);
const estimateUrl = jobberProjectEstimateFormUrl() ?? withBase('/book/');
const gbpUrl = googleReviewProfileUrl();
const ratingLabel = googleReviews.rating.toFixed(1);
const reviewCount = googleReviewCountDisplay();

/** Real EYS jobs from src/content/projects — no stock photography. */
const heroPhoto = {
  src: '/images/projects/navy-office-builtins/eys-custom-project-navy-builtin-office-shelving-after-p006-03.jpg',
  alt: 'Floor-to-ceiling navy custom built-in shelving and cabinets in a home office.',
  width: 3000,
  height: 4000,
  label: 'Navy office built-ins',
};

const galleryPhotos = [
  {
    src: '/images/projects/understair-curved-shelving/eys-shelving-storage-under-stair-curved-shelving-after-p007-01.jpg',
    alt: 'Custom white built-in shelves following a curved under-stairs space.',
    width: 2295,
    height: 3060,
    label: 'Curved under-stair shelving',
    href: '/our-work/understair-curved-shelving/',
  },
  {
    src: '/images/projects/understair-curved-shelving/eys-shelving-storage-custom-curved-understair-shelving-during-p007-02.jpg',
    alt: 'Unfinished curved plywood shelves being installed in an under-stair closet.',
    width: 3000,
    height: 4000,
    label: 'Shelves fitted on site',
    href: '/our-work/understair-curved-shelving/',
  },
  {
    src: '/images/projects/window-seat-built-in-hutch/eys-custom-project-white-window-seat-built-in-hutch-after-p027-01.jpg',
    alt: 'White custom built-in window seat with drawers, flanked by tall cabinetry and a glass-front hutch against a blue wall',
    width: 1200,
    height: 1600,
    label: 'Window seat & hutch',
    href: '/our-work/window-seat-built-in-hutch/',
  },
  {
    src: '/images/projects/garage-overhead-storage/eys-shelving-storage-garage-wood-shelves-overhead-rack-after-p015-03.jpg',
    alt: 'Residential garage with a long custom wooden wall shelf on triangular brackets and a black overhead wire storage rack',
    width: 3000,
    height: 4000,
    label: 'Garage shelving & overhead rack',
    href: '/our-work/garage-overhead-storage/',
  },
] as const;

const buildList = [
  'Built-in shelving & bookcases',
  'Closet, pantry & linen systems',
  'Laundry and mudroom built-ins, benches & lockers',
  'Garage overhead racks & wall storage',
  'Floating shelves anchored into studs',
] as const;

const steps = [
  {
    title: 'Send photos',
    body: 'Send a few photos of the wall, closet or garage through the estimate form — or call and talk it through.',
  },
  {
    title: 'One written estimate',
    body: 'We review the space and send one written estimate for the build.',
  },
  {
    title: 'Built on site',
    body: `We build, fit and finish it in your home in ${localityShort('&')}.`,
  },
] as const;

// No built-ins-specific review exists in src/content/reviews yet; this one is
// about on-site workmanship, which is what a built-in buyer is judging.
const review = await getEntry('reviews', 'yong-sun');

const seo = {
  title: `Built-In Shelving & Storage in ${localityShort('&')} | Elevate Your Space Handyman`,
  description:
    `Custom built-in shelving, closet, pantry, laundry, mudroom and garage storage, site-built in ` +
    `${localityShort('&')} homes. Veteran-owned and insured. Call ${site.phone} or send photos for a written estimate.`,
  canonical: pageUrl,
  ogImage: heroPhoto.src,
  ogImageAlt: heroPhoto.alt,
  noindex: true,
};

const schemaGraph = [
  webPage(seo.title, pageUrl, seo.description, heroPhoto.src),
  breadcrumbList([
    { name: 'Home', url: absoluteUrl('/') },
    { name: 'Built-In Shelving & Storage', url: pageUrl },
  ]),
].filter(Boolean);

const navLinks = [
  { label: 'Services', href: withBase('/services/') },
  { label: 'Our Work', href: withBase('/our-work/') },
  { label: 'Reviews', href: withBase('/reviews/') },
  { label: 'About', href: withBase('/about/') },
] as const;

const callPrimaryClass =
  'inline-flex min-h-12 w-full items-center justify-center rounded-md bg-brand-red px-5 py-3.5 text-center text-base font-bold text-white shadow-lg shadow-black/30 hover:bg-brand-redhover sm:w-auto';
const formSecondaryClass =
  'inline-flex min-h-12 w-full items-center justify-center rounded-md border-2 border-white/85 bg-transparent px-5 py-3.5 text-center text-base font-bold text-white hover:bg-white hover:text-brand-black sm:w-auto';
---

<BaseLayout seo={seo} schemaGraph={schemaGraph} theme={siteTheme}>
  <div class="min-h-screen bg-brand-lightbg text-brand-charcoal">
    <header class="eys-header eys-on-dark sticky top-0 z-50 bg-eys-ground">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 h-16 px-4 sm:px-6 lg:h-20 lg:px-8">
        <Logo class="shrink-0" />
        <nav class="hidden md:flex md:flex-1 md:items-center md:justify-center md:gap-6" aria-label="Site">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class="inline-flex min-h-11 items-center text-sm font-semibold text-white/75 hover:text-white"
              >
                {link.label}
              </a>
            ))
          }
        </nav>
        <a
          href={`tel:${site.phoneTel}`}
          data-cta-location="lp_header_call"
          class="eys-btn eys-btn--gold !h-11 !px-4 !text-sm shrink-0"
          aria-label={`Call Elevate Your Space Handyman at ${site.phone}`}
        >
          Call {site.phone}
        </a>
      </div>
    </header>

    <main id="main-content">
      <VanBand container="6xl" />
      <section
        class="bg-brand-black px-4 pb-10 pt-8 text-white sm:px-6 sm:pb-14 sm:pt-10 lg:px-8"
        aria-labelledby="lp-hero-heading"
        data-analytics-section="hero"
      >
        <div class="mx-auto grid max-w-6xl items-center gap-8 lg:grid-cols-2 lg:gap-12">
          <div>
            <h1
              id="lp-hero-heading"
              class="text-3xl font-bold leading-tight tracking-tight sm:text-4xl lg:text-[2.75rem]"
            >
              Built-In Shelving &amp; Storage, Built to Your Wall
            </h1>
            <p class="mt-3 max-w-xl text-base leading-relaxed text-white/85 sm:text-lg">
              Closet, pantry, laundry, mudroom and garage storage. Site-built in {localityShort('&')} homes.
            </p>

            <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap" data-lp-hero-cta>
              <a
                href={`tel:${site.phoneTel}`}
                data-cta-location="lp_hero_call"
                class={callPrimaryClass}
                aria-label={`Call Elevate Your Space Handyman at ${site.phone}`}
              >
                Call {site.phone}
              </a>
              <a
                href={estimateUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-booking-type="project_estimate"
                data-service-type="project_estimate"
                data-cta-location="lp_hero_form"
                class={formSecondaryClass}
              >
                Send photos for a written estimate
              </a>
            </div>

            <p class="mt-4 text-sm font-bold text-white/80">
              Veteran-owned · Insured ·{' '}
              {
                gbpUrl ? (
                  <a
                    href={gbpUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-track-review
                    data-cta-location="lp_hero_reviews"
                    class="text-brand-redondark hover:underline"
                  >
                    {ratingLabel} ★ from {reviewCount} Google reviews
                  </a>
                ) : (
                  <span>
                    {ratingLabel} ★ from {reviewCount} Google reviews
                  </span>
                )
              }
            </p>
          </div>

          <figure class="relative mx-auto w-full max-w-md overflow-hidden rounded-xl lg:max-w-none">
            <SiteImage
              src={heroPhoto.src}
              alt={heroPhoto.alt}
              width={heroPhoto.width}
              height={heroPhoto.height}
              loading="eager"
              fetchpriority="high"
              sizes="(max-width: 1024px) 100vw, 560px"
              class="aspect-[4/5] h-auto w-full object-cover"
            />
            <figcaption
              class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent px-4 pb-4 pt-10 text-sm font-bold text-white"
            >
              {heroPhoto.label}
            </figcaption>
          </figure>
        </div>
      </section>

      <section class="bg-white px-4 py-12 sm:px-6 sm:py-16 lg:px-8" aria-labelledby="lp-work-heading">
        <div class="mx-auto max-w-6xl">
          <h2 id="lp-work-heading" class="eys-h2 text-eys-ink">
            Recent Built-Ins &amp; Storage
          </h2>
          <ul class="mt-8 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4" role="list">
            {
              galleryPhotos.map((photo) => (
                <li>
                  <a href={withBase(photo.href)} class="group block overflow-hidden rounded-xl border border-brand-line bg-brand-lightbg">
                    <SiteImage
                      src={photo.src}
                      alt={photo.alt}
                      width={photo.width}
                      height={photo.height}
                      sizes="(max-width: 1024px) 50vw, 280px"
                      class="aspect-[3/4] h-auto w-full object-cover transition-transform group-hover:scale-[1.02]"
                    />
                    <span class="block px-3 py-2.5 text-sm font-bold text-brand-black">{photo.label}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="bg-brand-lightbg px-4 py-12 sm:px-6 sm:py-16 lg:px-8" aria-labelledby="lp-build-heading">
        <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-2">
          <div>
            <h2 id="lp-build-heading" class="eys-h2 text-eys-ink">
              What We Build
            </h2>
            <ul class="mt-6 space-y-3" role="list">
              {
                buildList.map((item) => (
                  <li class="flex gap-3 text-base text-brand-charcoal">
                    <span class="mt-2 h-2 w-2 shrink-0 bg-brand-red" aria-hidden="true" />
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div>
            <h2 class="eys-h2 text-eys-ink">How It Works</h2>
            <ol class="mt-6 space-y-4">
              {
                steps.map((step, index) => (
                  <li class="flex gap-4 rounded-xl border border-brand-line bg-white p-5">
                    <span
                      class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-black text-sm font-bold text-white"
                      aria-hidden="true"
                    >
                      {index + 1}
                    </span>
                    <div>
                      <h3 class="text-lg font-bold text-brand-black">{step.title}</h3>
                      <p class="mt-1 text-sm leading-relaxed text-brand-muted sm:text-base">{step.body}</p>
                    </div>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </section>

      <section class="bg-white px-4 py-12 sm:px-6 sm:py-16 lg:px-8" aria-labelledby="lp-review-heading">
        <div class="mx-auto max-w-3xl">
          <h2 id="lp-review-heading" class="eys-h2 text-eys-ink">
            What Homeowners Say
          </h2>
          <p class="mt-3 text-base font-bold text-brand-red">
            {ratingLabel} ★ · {reviewCount} Google reviews
          </p>
          {
            review ? (
              <blockquote class="mt-6 rounded-xl border border-brand-line bg-brand-lightbg p-6 text-base leading-relaxed text-brand-charcoal">
                <p>“{review.data.text}”</p>
                <footer class="mt-4 text-sm font-bold text-brand-black">
                  — {review.data.author}
                  {review.data.source ? (
                    <span class="font-normal text-brand-muted"> · {review.data.source}</span>
                  ) : null}
                </footer>
              </blockquote>
            ) : null
          }
        </div>
      </section>

      <section class="bg-brand-black px-4 py-12 text-white sm:px-6 sm:py-16 lg:px-8" aria-labelledby="lp-final-heading">
        <div class="mx-auto max-w-3xl text-center">
          <h2 id="lp-final-heading" class="eys-h2">
            Tell Us About the Wall
          </h2>
          <p class="mt-3 text-base text-white/80">
            Call to talk it through, or send photos and get one written estimate.
          </p>
          <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row">
            <a
              href={`tel:${site.phoneTel}`}
              data-cta-location="lp_final_call"
              class={callPrimaryClass}
              aria-label={`Call Elevate Your Space Handyman at ${site.phone}`}
            >
              Call {site.phone}
            </a>
            <a
              href={estimateUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-booking-type="project_estimate"
              data-service-type="project_estimate"
              data-cta-location="lp_final_form"
              class={formSecondaryClass}
            >
              Send photos for a written estimate
            </a>
          </div>
        </div>
      </section>
    </main>

    <StartFooter />

    <div
      class="pointer-events-none fixed inset-x-0 bottom-0 z-40 translate-y-full opacity-0 transition-all duration-300 md:hidden"
      role="region"
      aria-label="Call or send photos"
      data-lp-sticky
      hidden
    >
      <div
        class="pointer-events-auto border-t border-white/10 bg-brand-black px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] shadow-[0_-8px_24px_-12px_rgba(10,10,10,0.45)]"
      >
        <div class="mx-auto flex max-w-6xl gap-3">
          <a
            href={`tel:${site.phoneTel}`}
            data-cta-location="sticky_mobile"
            class="inline-flex min-h-12 flex-1 items-center justify-center rounded-md bg-brand-red px-3 py-3 text-center text-sm font-bold text-white hover:bg-brand-redhover"
            aria-label={`Call Elevate Your Space Handyman at ${site.phone}`}
          >
            Call EYS
          </a>
          <a
            href={estimateUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-booking-type="project_estimate"
            data-service-type="project_estimate"
            data-cta-location="sticky_mobile"
            class="inline-flex min-h-12 flex-1 items-center justify-center rounded-md border-2 border-white/85 bg-transparent px-3 py-3 text-center text-sm font-bold text-white hover:bg-white hover:text-brand-black"
          >
            Send Photos
          </a>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Same reveal rule as start-landing/StartStickyBar: show once the hero
    // buttons have scrolled away, hide again over the footer.
    function initLpStickyBar() {
      const bar = document.querySelector<HTMLElement>('[data-lp-sticky]');
      const heroCta = document.querySelector<HTMLElement>('[data-lp-hero-cta]');
      const footer = document.querySelector<HTMLElement>('[data-start-footer]');
      if (!bar || !heroCta) return;

      let heroPassed = false;
      let footerVisible = false;

      const sync = () => {
        const show = heroPassed && !footerVisible;
        bar.hidden = !show;
        bar.classList.toggle('translate-y-full', !show);
        bar.classList.toggle('opacity-0', !show);
        bar.classList.toggle('pointer-events-none', !show);
        document.body.classList.toggle('lp-sticky-pad', show);
      };

      new IntersectionObserver(([entry]) => {
        heroPassed = !entry.isIntersecting && entry.boundingClientRect.top < 0;
        sync();
      }).observe(heroCta);

      if (footer) {
        new IntersectionObserver(([entry]) => {
          footerVisible = entry.isIntersecting;
          sync();
        }).observe(footer);
      }
    }

    initLpStickyBar();
  </script>

  <style is:global>
    @media (max-width: 767px) {
      body.lp-sticky-pad {
        padding-bottom: calc(5.5rem + env(safe-area-inset-bottom));
      }
    }
  </style>
</BaseLayout>
