---
import { getCollection } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import BreadcrumbNav from '../../components/seo/BreadcrumbNav.astro';
import ServiceTrustStrip from '../../components/seo/ServiceTrustStrip.astro';
import BalancedGrid from '../../components/ui/BalancedGrid.astro';
import LocalAreaCTA from '../../components/areas/local/LocalAreaCTA.astro';
import { absoluteUrl, localityShort, site, jobberProjectEstimateFormUrl } from '../../data/business';
import { breadcrumbList, webPage } from '../../data/schema';
import { serviceCategories } from '../../data/serviceCategories';
import { customServicePages } from '../../data/sitePresentation';
import { contentMaxClass, contentPaddingClass } from '../../data/layout';

const services = await getCollection('services', ({ data }) => data.published === true);
services.sort((a, b) => a.data.title.localeCompare(b.data.title));

const customCards = Object.entries(customServicePages).map(([slug, meta]) => ({
  title: meta.title,
  description: meta.summary,
  href: `/services/${slug}/`,
  footerText: 'View service →',
  headingLevel: 3 as const,
}));

const collectionCards = services.map((entry) => ({
  title: entry.data.title,
  description: entry.data.summary,
  href: `/services/${entry.data.slug}/`,
  footerText: 'View service →',
  headingLevel: 3 as const,
}));

const serviceCards = [...customCards, ...collectionCards].sort((a, b) =>
  a.title.localeCompare(b.title),
);

const title = 'Handyman, Repair & Home-Improvement Services | EYS';
const description =
  `Explore EYS services for repair lists, installations, drywall, doors, TV mounting, curtains, carpentry and larger home upgrades in ${localityShort('and')}.`;
const canonical = absoluteUrl('/services/');

const schemaGraph = [
  webPage('Our Services', canonical, description),
  breadcrumbList([
    { name: 'Home', url: absoluteUrl('/') },
    { name: 'Services', url: canonical },
  ]),
];

const estimateUrl = jobberProjectEstimateFormUrl() ?? '/contact/';
---

<ContentLayout seo={{ title, description, canonical }} schemaGraph={schemaGraph}>
  <article>
  <header class="eys-page-hero eys-on-dark">
  <div class:list={['mx-auto', contentMaxClass, contentPaddingClass, 'pt-8 md:pt-10']}>
    <BreadcrumbNav
      items={[
        { name: 'Home', url: '/' },
        { name: 'Services', url: '/services/' },
      ]}
    />
    <h1 class="eys-h1 mb-5 mt-8 max-w-4xl md:mt-12">Handyman Services for Repairs, Installations and Home Upgrades</h1>
    <p class="eys-page-hero-lede eys-body mb-8 max-w-3xl">
      Explore repair lists, installations, drywall, doors, TV mounting, curtains, carpentry and larger home upgrades for homes in {localityShort('and')}.
    </p>
    <!-- Estimate + call row (backlog 009): same markup as PageHero's optional `ctas` row. -->
    <div class="flex flex-col sm:flex-row gap-3" data-sticky-hero-cta>
      <a
        href={estimateUrl}
        data-booking-type="project_estimate"
        data-cta-location="services_hub_hero_form"
        class="eys-hero-btn eys-hero-btn--red"
      >
        Send photos for a free estimate
      </a>
      <a
        href={`tel:${site.phoneTel}`}
        data-cta-location="services_hub_hero_call"
        class="eys-hero-btn eys-hero-btn--outline"
      >
        Call {site.phone}
      </a>
    </div>
  </div>
  <div class="eys-stripe" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
  </header>
  <ServiceTrustStrip />
  <div class:list={['mx-auto', contentMaxClass, contentPaddingClass, 'py-12 md:py-16']}>

    <section class="mb-12" aria-labelledby="service-categories">
      <h2 id="service-categories" class="text-2xl font-bold text-brand-black mb-6">Browse by category</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          serviceCategories.map((category) => (
            <a
              href={`/services/${category.slug}/`}
              class="block h-full p-6 bg-brand-black text-white rounded-xl shadow-sm hover:shadow-md transition-all group"
            >
              <h3 class="text-xl font-bold mb-2">{category.title}</h3>
              <p class="text-sm text-neutral-300 mb-4">{category.summary}</p>
              <span class="text-sm font-bold text-brand-red group-hover:underline">{category.ctaLabel} →</span>
            </a>
          ))
        }
      </div>
    </section>

    <h2 class="text-2xl font-bold text-brand-black mb-6">All services</h2>
    <BalancedGrid variant="card" items={serviceCards} cols={3} gapClass="gap-6" />
  </div>
  <LocalAreaCTA locationName={localityShort('&')} />
  </article>
</ContentLayout>
