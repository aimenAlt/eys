---
import { getCollection } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import BreadcrumbNav from '../../components/seo/BreadcrumbNav.astro';
import ServiceTrustStrip from '../../components/seo/ServiceTrustStrip.astro';
import BalancedGrid from '../../components/ui/BalancedGrid.astro';
import LocalAreaCTA from '../../components/areas/local/LocalAreaCTA.astro';
import { absoluteUrl, areaServedDisplay, localityShort, site, jobberProjectEstimateFormUrl } from '../../data/business';
import { breadcrumbList, webPage } from '../../data/schema';
import { contentMaxClass, contentPaddingClass } from '../../data/layout';

const areas = await getCollection('serviceAreas', ({ data }) => data.published === true);
// Katy first (home base), Fulshear second (its default partner), the rest alphabetical.
const leadAreas = ['katy', 'fulshear'];
const leadRank = (slug: string) => {
  const i = leadAreas.indexOf(slug);
  return i === -1 ? leadAreas.length : i;
};
areas.sort(
  (a, b) =>
    leadRank(a.data.slug) - leadRank(b.data.slug) || a.data.title.localeCompare(b.data.title),
);

const areaCards = areas.map((entry) => ({
  title: entry.data.title,
  description: entry.data.summary,
  href: `/service-areas/${entry.data.slug}/`,
  footerText: 'View area →',
  headingLevel: 2 as const,
}));

const title = `Service Areas | ${site.name}`;
const description = `Handyman service areas in ${areaServedDisplay()}, plus nearby master-planned communities.`;
const canonical = absoluteUrl('/service-areas/');

const schemaGraph = [
  webPage('Service Areas', canonical, description),
  breadcrumbList([
    { name: 'Home', url: absoluteUrl('/') },
    { name: 'Service Areas', url: canonical },
  ]),
];

const estimateUrl = jobberProjectEstimateFormUrl() ?? '/contact/';
---

<ContentLayout seo={{ title, description, canonical }} schemaGraph={schemaGraph}>
  <article>
  <div class:list={['mx-auto', contentMaxClass, contentPaddingClass, 'py-10 md:py-12']}>
    <BreadcrumbNav
      items={[
        { name: 'Home', url: '/' },
        { name: 'Service Areas', url: '/service-areas/' },
      ]}
    />
    <h1 class="text-4xl md:text-5xl font-extrabold text-brand-black mb-6 mt-6">Service Areas</h1>
    <p class="text-lg text-neutral-600 mb-6 max-w-3xl">
      Elevate Your Space Handyman serves homeowners throughout {areaServedDisplay()}.
    </p>
    <!-- Estimate + call row (backlog 009): same markup as PageHero's optional `ctas` row. -->
    <div class="mb-8 flex flex-col sm:flex-row gap-3" data-sticky-hero-cta>
      <a
        href={estimateUrl}
        data-booking-type="project_estimate"
        data-cta-location="service_areas_hero_form"
        class="inline-flex justify-center items-center bg-brand-red text-white px-6 py-3 rounded-md font-bold hover:bg-brand-redhover transition-colors"
      >
        Send photos for a free estimate
      </a>
      <a
        href={`tel:${site.phoneTel}`}
        data-cta-location="service_areas_hero_call"
        class="inline-flex justify-center items-center border-2 border-brand-black text-brand-black px-6 py-3 rounded-md font-bold hover:bg-brand-black hover:text-white transition-colors"
      >
        Call {site.phone}
      </a>
    </div>
    <div class="-mx-4 sm:-mx-6 lg:-mx-8 mb-10"><ServiceTrustStrip /></div>
    {
      areaCards.length > 0 ? (
        <BalancedGrid variant="card" items={areaCards} cols={3} gapClass="gap-6" />
      ) : (
        <p class="text-neutral-600">
          Service area pages will be listed here as local content is added.
        </p>
      )
    }
  </div>
  <LocalAreaCTA locationName={localityShort('&')} />
  </article>
</ContentLayout>
