---
/**
 * /home2/ — internal preview of the redesigned homepage (backlog 013) with the
 * new site chrome. noindex, canonical "/", excluded from the sitemap.
 * Backlog 014 flips "/" to this variant and turns /home2/ back into the
 * preview of the non-live (old) homepage.
 *
 * `?theme=black` previews the black theme: a tiny inline script sets
 * data-theme before first paint.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import SiteBottomBar from '../components/site/SiteBottomBar.astro';
import HomeRedesignPage from '../components/home/redesign/HomeRedesignPage.astro';
import { getCollection } from 'astro:content';
import { absoluteUrl } from '../data/business';
import { homePageSchema, homeFaqs } from '../data/schema';
import { buildNavMenus } from '../data/navMenus';
import { siteTheme } from '../data/sitePresentation';

const [allServices, serviceAreas, communities] = await Promise.all([
  getCollection('services'),
  getCollection('serviceAreas', ({ data }) => data.published === true),
  getCollection('communities', ({ data }) => data.published === true),
]);

const navMenus = buildNavMenus(allServices, serviceAreas, communities);

const cityLinks = serviceAreas.map((a) => ({ title: a.data.title, slug: a.data.slug }));
const communityLinks = communities.map((c) => ({
  title: c.data.title,
  citySlug: c.data.citySlug,
  slug: c.data.slug,
}));

const seo = {
  title: 'Homepage Redesign Preview | Elevate Your Space',
  description: 'Internal preview of the redesigned homepage. The live homepage is at the root URL.',
  canonical: absoluteUrl('/'),
  noindex: true,
};

const schemaGraph = homePageSchema(homeFaqs);
---

<BaseLayout seo={seo} schemaGraph={schemaGraph} theme={siteTheme}>
  <script is:inline slot="early-scripts">
    if (new URLSearchParams(location.search).get('theme') === 'black') document.documentElement.dataset.theme = 'black';
  </script>
  <SiteHeader navMenus={navMenus} />
  <main id="main-content">
    <HomeRedesignPage cityLinks={cityLinks} communityLinks={communityLinks} />
  </main>
  <SiteFooter />
  <SiteBottomBar />
</BaseLayout>
