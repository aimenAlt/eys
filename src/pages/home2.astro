---
/**
 * /home2/ — preview of the NON-live homepage variant. Since backlog 014 "/"
 * renders the redesign, so this shows the previous homepage
 * (HomeSmallRepairPage) with the same chrome as the legacy pages since backlog
 * 015: the new site chrome on the black theme.
 * noindex, canonical "/", excluded from the sitemap.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import SiteBottomBar from '../components/site/SiteBottomBar.astro';
import HomeSmallRepairPage from '../components/home/HomeSmallRepairPage.astro';
import { getCollection } from 'astro:content';
import { absoluteUrl } from '../data/business';
import { homePageSchema, homeFaqs } from '../data/schema';
import { buildNavMenus } from '../data/navMenus';

const [publishedReviews, allServices, serviceAreas, communities] = await Promise.all([
  getCollection('reviews', ({ data }) => data.published === true),
  getCollection('services'),
  getCollection('serviceAreas', ({ data }) => data.published === true),
  getCollection('communities', ({ data }) => data.published === true),
]);

const navMenus = buildNavMenus(allServices, serviceAreas, communities);

const cityLinks = serviceAreas.map((a) => ({ title: a.data.title, slug: a.data.slug }));
const communityLinks = communities.map((c) => ({
  title: c.data.title,
  citySlug: c.data.citySlug,
  slug: c.data.slug,
}));

const seo = {
  title: 'Previous Homepage Preview | Elevate Your Space',
  description: 'Internal preview of the previous homepage. The live homepage is at the root URL.',
  canonical: absoluteUrl('/'),
  noindex: true,
};

const schemaGraph = homePageSchema(homeFaqs);
---

<BaseLayout seo={seo} schemaGraph={schemaGraph} theme="black">
  <SiteHeader navMenus={navMenus} />
  <main id="main-content">
    <HomeSmallRepairPage
      projectCount={serviceAreas.length}
      publishedReviews={publishedReviews}
      cityLinks={cityLinks}
      communityLinks={communityLinks}
    />
  </main>
  <SiteFooter />
  <SiteBottomBar />
</BaseLayout>
