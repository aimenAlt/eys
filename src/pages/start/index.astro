---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StartFaq from '../../components/start-landing/StartFaq.astro';
import StartFinalCta from '../../components/start-landing/StartFinalCta.astro';
import StartFooter from '../../components/start-landing/StartFooter.astro';
import StartHeader from '../../components/start-landing/StartHeader.astro';
import StartHero from '../../components/start-landing/StartHero.astro';
import StartGeneralContracting from '../../components/start-landing/StartGeneralContracting.astro';
import StartIncluded from '../../components/start-landing/StartIncluded.astro';
import StartPaths from '../../components/start-landing/StartPaths.astro';
import StartProcess from '../../components/start-landing/StartProcess.astro';
import StartProof from '../../components/start-landing/StartProof.astro';
import StartReviews from '../../components/start-landing/StartReviews.astro';
import StartServicesStrip from '../../components/start-landing/StartServicesStrip.astro';
import StartStickyBar from '../../components/start-landing/StartStickyBar.astro';
import StartTrustStrip from '../../components/start-landing/StartTrustStrip.astro';
import StartVideoBuiltIn from '../../components/start-landing/StartVideoBuiltIn.astro';
import StartVideoSlat from '../../components/start-landing/StartVideoSlat.astro';
import StartWhy from '../../components/start-landing/StartWhy.astro';
import VideoAutoplayScript from '../../components/common/VideoAutoplayScript.astro';
import { absoluteUrl } from '../../data/business';
import { startFaqs, startLanding } from '../../data/startLanding';
import { breadcrumbList, faqPage, webPage } from '../../data/schema';

const pagePath = startLanding.path;
const pageUrl = absoluteUrl(pagePath);
// The hero's own opening frame, so a shared link previews what the page
// actually opens with. `images.hero` is the still that used to lead the page
// and now renders in StartVideoBuiltIn; it is no longer what a visitor sees
// first, so it is no longer what the link preview shows.
const heroImage = startLanding.images.videos.builtIn.poster;

// Print-QR / offline conversion landing — reached by scanning a code, never by
// organic search. Kept out of the index so it cannot compete with `/` for the
// head term ("handyman Katy"); `follow` so its outbound links still pass equity.
// Same posture as /van/ and /home2/.
const seo = {
  title: startLanding.seo.title,
  description: startLanding.seo.description,
  canonical: pageUrl,
  ogImage: heroImage,
  ogImageAlt: startLanding.images.videos.builtIn.label,
  noindex: true,
};

const schemaGraph = [
  webPage(seo.title, pageUrl, seo.description, heroImage),
  breadcrumbList([
    { name: 'Home', url: absoluteUrl('/') },
    { name: 'Start Your Project', url: pageUrl },
  ]),
  faqPage(startFaqs()),
].filter(Boolean);
---

<BaseLayout seo={seo} schemaGraph={schemaGraph}>
  <div class="start-landing min-h-screen bg-brand-lightbg text-brand-charcoal">
    <StartHeader />
    <main id="main-content">
      <StartHero />
      <StartTrustStrip />
      <StartPaths />
      <StartProof />
      <!--
        Ordered so a text-only section never follows another one. Measured at
        390x844 the old run put Process and What's Included back to back, then
        Why, Reviews, More Ways and the FAQ in an unbroken four-section stretch
        with no imagery at all — nearly four screens of grey immediately before
        the page asked for the job.
      -->
      <StartProcess />
      <StartGeneralContracting />
      <StartIncluded />
      <StartVideoBuiltIn />
      <StartWhy />
      <StartVideoSlat />
      <StartReviews />
      <StartFaq />
      <StartServicesStrip />
      <StartFinalCta />
    </main>
    <StartFooter />
    <StartStickyBar />
  </div>
  <VideoAutoplayScript />
  <script>
    import '../../scripts/curtain-attribution.ts';
  </script>
</BaseLayout>
