---
const steps = [
  {
    title: 'Pick your path',
    description: 'Book a visit, send photos, or ask for a custom estimate — whichever fits the job.',
  },
  {
    title: 'Tell us once',
    description:
      'Fill in the details one time. No repeating yourself, no phone tag to get started.',
  },
  {
    title: 'Get a date or a price',
    description:
      'Standard work you can schedule on the spot. Bigger projects get reviewed and come back with a clear next step.',
  },
] as const;
---

<section class="bg-brand-lightbg px-4 pb-8 pt-4 sm:px-6" aria-labelledby="van-process-heading">
  <div class="mx-auto max-w-3xl">
    <h2 id="van-process-heading" class="text-2xl font-extrabold tracking-tight text-brand-black sm:text-3xl">
      How it works
    </h2>
    <ol class="mt-4 flex flex-col gap-3">
      {
        steps.map((step, index) => (
          <li class="flex items-start gap-3 rounded-xl border border-brand-black/10 bg-white p-4">
            <span
              class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-black text-xs font-bold text-white"
              aria-hidden="true"
            >
              {index + 1}
            </span>
            <div>
              <h3 class="text-base font-bold text-brand-black">{step.title}</h3>
              <p class="mt-0.5 text-sm leading-relaxed text-brand-muted">{step.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
