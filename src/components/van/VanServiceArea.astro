---
import { vanCampaign } from '../../data/vanCampaign';
---

<section
  class="bg-brand-lightbg px-4 pb-10 pt-2 sm:px-6 sm:pb-12"
  aria-labelledby="van-area-heading"
>
  <div class="mx-auto max-w-3xl lg:max-w-6xl">
    <h2
      id="van-area-heading"
      class="text-2xl font-extrabold tracking-tight text-brand-black sm:text-3xl"
    >
      Serving Katy, Cypress, Fulshear, Richmond and West Houston
    </h2>
    <p class="mt-3 text-sm leading-relaxed text-brand-muted sm:text-base">
      Just outside the area or not sure? Give us the address when you book or send photos and
      we&rsquo;ll tell you straight away whether we can take it on. Or{' '}
      <a
        href={`tel:${vanCampaign.phoneTel}`}
        data-van-phone="service_area"
        data-cta-location="van_service_area"
        class="font-bold text-brand-black underline underline-offset-4 hover:text-brand-red"
      >call {vanCampaign.phoneDisplay}</a> and ask.
    </p>
  </div>
</section>
