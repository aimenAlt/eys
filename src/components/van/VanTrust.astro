---
import SiteImage from '../ui/SiteImage.astro';
import { imageOrPlaceholder } from '../../data/images';
import { withBase } from '../../utils/paths';
import { googleReviewCountDisplay, googleReviewProfileUrl, googleReviews } from '../../data/business';
import { vanImages } from '../../data/vanCampaign';

/**
 * The proof strip used to be three uncaptioned thumbnails about 110px wide on a
 * phone, which read as decoration rather than evidence. It now leads with one
 * large frame and captions every shot, so a visitor can name the kind of work
 * they are looking at. Photography lives in `vanImages` with the rest.
 */
const reviewsPageHref = withBase('/reviews/');

/**
 * The rating chip is the one indicator a visitor can check, so it opens the
 * Google Business Profile it is quoting. The other two are statements about us
 * and stay plain text, which is why these carry an optional href rather than
 * all three being links.
 */
const gbpUrl = googleReviewProfileUrl();

const trustIndicators = [
  { label: 'Veteran-Owned', href: undefined },
  {
    label: `${googleReviews.rating.toFixed(1)} stars · ${googleReviewCountDisplay()} reviews`,
    href: gbpUrl,
  },
  { label: 'Katy-Based & Locally Operated', href: undefined },
] as const;

const proof = vanImages.proof.map((image) => ({ ...image, src: imageOrPlaceholder(image.src) }));
const [lead, second, third] = proof;

const reviews = [
  {
    author: 'Vanesa Morgia',
    text: 'The curtain installation was done very well and the final result looks amazing. The price was reasonable, and he was professional throughout the process, we’re happy with the service and would definitely use his help again in the future. Thanks again Eyad!',
  },
  {
    author: 'Yong Sun',
    text: 'Essa did great jobs today. He arrived on time, maintained clean workspace. completed all work fast and neatly. If you need a reliable and efficient handyman, definitely ask for Essa at Elevate Your Space!',
  },
] as const;

const captionClass =
  'absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 via-black/35 to-transparent px-4 pb-3 pt-12 text-sm font-bold text-white';
---

<section
  class="bg-brand-lightbg px-4 pb-10 pt-10 sm:px-6 sm:pb-12 sm:pt-12"
  aria-labelledby="van-trust-heading"
>
  <div class="mx-auto max-w-3xl lg:max-w-6xl">
    <h2
      id="van-trust-heading"
      class="text-2xl font-extrabold tracking-tight text-brand-black sm:text-3xl"
    >
      Real work, in homes like yours
    </h2>
    <p class="mt-2 text-sm leading-relaxed text-brand-muted sm:text-base">
      Every photo below is a finished EYS job in Katy or West Houston.
    </p>

    <ul class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-3" role="list">
      {
        trustIndicators.map((indicator) => (
          <li class="rounded-lg border border-brand-black/10 bg-white text-center text-sm font-bold text-brand-black">
            {indicator.href ? (
              <a
                href={indicator.href}
                target="_blank"
                rel="noopener noreferrer"
                data-track-review
                data-cta-location="van_trust"
                class="flex min-h-11 items-center justify-center rounded-lg px-4 py-3 underline underline-offset-4 hover:bg-brand-black hover:text-white"
              >
                {indicator.label}
              </a>
            ) : (
              <span class="flex min-h-11 items-center justify-center px-4 py-3">
                {indicator.label}
              </span>
            )}
          </li>
        ))
      }
    </ul>

    <div class="mt-8 grid gap-3 sm:gap-4 lg:grid-cols-3">
      {
        lead ? (
          <figure class="relative overflow-hidden rounded-xl shadow-card">
            <SiteImage
              src={lead.src}
              alt={lead.alt}
              width={lead.width}
              height={lead.height}
              loading="lazy"
              sizes="(max-width: 768px) 100vw, 768px"
              class="aspect-[4/3] w-full object-cover sm:aspect-[16/10] lg:aspect-[4/5]"
            />
            <figcaption class={captionClass}>{lead.label}</figcaption>
          </figure>
        ) : null
      }
      <div class="grid grid-cols-2 gap-3 sm:gap-4 lg:col-span-2">
        {
          [second, third].filter(Boolean).map((image) => (
            <figure class="relative overflow-hidden rounded-xl shadow-card">
              <SiteImage
                src={image.src}
                alt={image.alt}
                width={image.width}
                height={image.height}
                loading="lazy"
                sizes="(max-width: 768px) 50vw, 376px"
                class="aspect-[4/5] w-full object-cover"
              />
              <figcaption class={captionClass}>{image.label}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>

    <ul class="mt-8 grid gap-4 lg:grid-cols-2">
      {
        reviews.map((review) => (
          <li class="rounded-xl border border-brand-black/10 bg-white p-5">
            <blockquote class="text-sm leading-relaxed text-brand-charcoal sm:text-base">
              <p>“{review.text}”</p>
              <footer class="mt-3 text-sm font-bold text-brand-black">— {review.author}</footer>
            </blockquote>
          </li>
        ))
      }
    </ul>

    <a
      href={reviewsPageHref}
      data-van-reviews
      data-cta-location="van_reviews"
      class="mt-6 inline-flex min-h-12 w-full items-center justify-center rounded-md border-2 border-brand-black px-4 py-3 text-center text-base font-bold text-brand-black hover:bg-brand-black hover:text-white sm:w-auto sm:px-6"
    >
      Read More Customer Reviews
    </a>
  </div>
</section>
