---
import SiteImage from '../ui/SiteImage.astro';
import { imageOrPlaceholder } from '../../data/images';
import { withBase } from '../../utils/paths';

const reviewsPageHref = withBase('/reviews/');

const trustIndicators = ['Veteran-Owned', '150+ Google Reviews', 'Katy-Based & Locally Operated'] as const;

const proofImages = [
  {
    src: imageOrPlaceholder(
      '/images/projects/double-height-curtains/eys-general-handyman-double-height-sheer-curtains-after-p023-04.jpg',
    ),
    alt: 'Floor-to-ceiling sheer white curtains installed on tall living-room windows',
    width: 1200,
    height: 1600,
  },
  {
    src: imageOrPlaceholder(
      '/images/projects/vaulted-crystal-chandelier/eys-fixture-installation-vaulted-living-crystal-chandelier-after-p008-01.jpg',
    ),
    alt: 'Crystal chandelier installed on a vaulted living-room ceiling',
    width: 1200,
    height: 1600,
  },
  {
    src: imageOrPlaceholder(
      '/images/projects/marble-wood-slat-feature-wall/eys-custom-project-living-room-marble-wood-slat-wall-after-p002-01.jpg',
    ),
    alt: 'Custom marble and wood-slat feature wall completed in a living room',
    width: 1200,
    height: 1600,
  },
] as const;

const reviews = [
  {
    author: 'Vanesa Morgia',
    text: 'The curtain installation was done very well and the final result looks amazing. The price was reasonable, and he was professional throughout the process, we’re happy with the service and would definitely use his help again in the future. Thanks again Eyad!',
  },
  {
    author: 'Yong Sun',
    text: 'Essa did great jobs today. He arrived on time, maintained clean workspace. completed all work fast and neatly. If you need a reliable and efficient handyman, definitely ask for Essa at Elevate Your Space!',
  },
] as const;
---

<section class="bg-brand-lightbg px-4 pb-10 pt-2 sm:px-6 sm:pb-12 sm:pt-4" aria-labelledby="van-trust-heading">
  <div class="mx-auto max-w-3xl">
    <h2 id="van-trust-heading" class="text-2xl font-extrabold tracking-tight text-brand-black sm:text-3xl">
      Trusted Local Work
    </h2>

    <ul class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-3" role="list">
      {
        trustIndicators.map((label) => (
          <li class="rounded-lg border border-brand-black/10 bg-white px-4 py-3 text-center text-sm font-bold text-brand-black">
            {label}
          </li>
        ))
      }
    </ul>

    <div class="mt-8 grid grid-cols-3 gap-2 sm:gap-3">
      {
        proofImages.map((image) => (
          <figure class="overflow-hidden rounded-lg bg-brand-lightbg">
            <SiteImage
              src={image.src}
              alt={image.alt}
              width={image.width}
              height={image.height}
              loading="lazy"
              sizes="(max-width: 768px) 33vw, 220px"
              class="aspect-[3/4] h-full w-full object-cover"
            />
          </figure>
        ))
      }
    </div>

    <ul class="mt-8 flex flex-col gap-4">
      {
        reviews.map((review) => (
          <li class="rounded-xl border border-brand-black/10 bg-white p-5">
            <blockquote class="text-sm leading-relaxed text-brand-charcoal sm:text-base">
              <p>“{review.text}”</p>
              <footer class="mt-3 text-sm font-bold text-brand-black">— {review.author}</footer>
            </blockquote>
          </li>
        ))
      }
    </ul>

    <a
      href={reviewsPageHref}
      data-van-reviews
      data-cta-location="van_reviews"
      class="mt-6 inline-flex min-h-12 w-full items-center justify-center rounded-md border-2 border-brand-black px-4 py-3 text-center text-base font-bold text-brand-black hover:bg-brand-black hover:text-white sm:w-auto sm:px-6"
    >
      Read More Customer Reviews
    </a>
  </div>
</section>
