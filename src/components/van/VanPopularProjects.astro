---
import { vanDestinations, type VanProjectId } from '../../data/vanCampaign';

type ProjectShortcut = {
  id: VanProjectId;
  label: string;
  href: string | undefined;
  bookingType: string;
};

/**
 * A catch-all, deliberately placed late and kept small.
 *
 * It used to run 893px of seven text links with no imagery, sitting directly
 * after the three service paths — the flattest stretch of the page in its
 * highest-intent position. It is now a compact label grid below the proof, for
 * the visitor whose job was not obviously covered above.
 *
 * Each tile keeps its own `data-van-project` and `data-booking-type`, so the
 * shortcut-level reporting in van-analytics.ts is unchanged.
 */
const projects = (
  [
    { id: 'tv_mounting', label: 'TV Mounting', href: vanDestinations.tvMounting, bookingType: 'tv_mounting' },
    { id: 'curtains_tracks', label: 'Curtains & Tracks', href: vanDestinations.photoEstimate, bookingType: 'project_estimate' },
    { id: 'lighting_fans', label: 'Lighting & Fans', href: vanDestinations.photoEstimate, bookingType: 'project_estimate' },
    { id: 'drywall_painting', label: 'Drywall & Painting', href: vanDestinations.photoEstimate, bookingType: 'project_estimate' },
    { id: 'doors_cabinets', label: 'Doors & Cabinets', href: vanDestinations.photoEstimate, bookingType: 'project_estimate' },
    { id: 'media_walls', label: 'Media Walls', href: vanDestinations.customProject, bookingType: 'custom_project' },
  ] satisfies ProjectShortcut[]
).filter((project) => Boolean(project.href));
---

<section class="bg-brand-lightbg px-4 pb-10 pt-2 sm:px-6" aria-labelledby="van-popular-heading">
  <div class="mx-auto max-w-3xl">
    <h2
      id="van-popular-heading"
      class="text-2xl font-extrabold tracking-tight text-brand-black sm:text-3xl"
    >
      Something else?
    </h2>
    <p class="mt-2 text-sm leading-relaxed text-brand-muted sm:text-base">
      Tap the job and we&rsquo;ll take it from there.
    </p>

    <ul class="mt-5 grid grid-cols-2 gap-3" role="list">
      {
        projects.map((project) => (
          <li class="flex">
            <a
              href={project.href}
              target="_blank"
              rel="noopener noreferrer"
              data-van-project={project.id}
              data-booking-type={project.bookingType}
              data-cta-location="van_popular_project"
              class="flex min-h-14 w-full items-center rounded-xl border border-brand-black/10 bg-white px-4 py-3 text-sm font-bold text-brand-black transition-colors hover:border-brand-red/50 hover:text-brand-red sm:text-base"
            >
              {project.label}
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mt-4 text-xs leading-relaxed text-brand-muted">
      Curtains &amp; tracks is installation labor — rods, tracks and curtains are supplied by you and
      need to be on site for the appointment.
    </p>
  </div>
</section>
