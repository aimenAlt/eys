---
import SiteImage from '../ui/SiteImage.astro';
import { imageOrPlaceholder } from '../../data/images';
import { vanCampaign, vanDestinations, vanImages } from '../../data/vanCampaign';

/**
 * The page used to end on the service-area paragraph and hand the visitor
 * straight to the footer, which meant the last thing they read was a caveat.
 * This closes on the two actions that matter instead. Both are repeats of the
 * hero's, which is the point — a QR visitor who scrolled the whole page should
 * not have to scroll back up to act.
 *
 * It closes on a photograph for the same reason the hero opens on one: the last
 * two screens of this page were measured at zero percent image coverage, which
 * is the weakest possible ground on which to ask for the job.
 *
 * The service-area note shares this band rather than occupying a 156px
 * full-width strip of its own above it. It belongs next to the ask anyway —
 * it is the last objection ("do you even come out here?") answered beside the
 * button that acts on the answer.
 */
const photoEstimateHref = vanDestinations.photoEstimate;
const closer = vanImages.closer;
const closerSrc = imageOrPlaceholder(closer.src);
---

<section
  class="relative overflow-hidden bg-brand-black px-4 py-12 text-white sm:px-6 sm:py-14"
  aria-labelledby="van-final-cta-heading"
>
  <div class="absolute inset-0" aria-hidden="true">
    <SiteImage
      src={closerSrc}
      alt=""
      width={closer.width}
      height={closer.height}
      loading="lazy"
      sizes="100vw"
      class="h-full w-full object-cover object-[center_35%]"
    />
    <div
      class="absolute inset-0 bg-gradient-to-b from-brand-black/75 via-brand-black/80 to-brand-black/90"
    >
    </div>
  </div>

  <div class="relative mx-auto grid max-w-3xl gap-8 lg:max-w-6xl lg:grid-cols-12 lg:items-start lg:gap-12">
    <div class="lg:col-span-7">
    <h2
      id="van-final-cta-heading"
      class="text-2xl font-extrabold tracking-tight sm:text-3xl"
    >
      Ready when you are
    </h2>
    <p class="mt-3 max-w-xl text-base leading-relaxed text-white/80">
      Send a few photos and we&rsquo;ll come back with a price and a next step. Prefer to talk it
      through? Call and we&rsquo;ll point you to the right option.
    </p>

    <div class="mt-7 flex flex-col gap-3 sm:flex-row">
      {
        photoEstimateHref && (
          <a
            href={photoEstimateHref}
            target="_blank"
            rel="noopener noreferrer"
            data-van-route="photo_estimate"
            data-booking-type="project_estimate"
            data-cta-location="van_final_cta"
            class="inline-flex min-h-12 items-center justify-center rounded-md bg-brand-red px-6 py-3 text-center text-base font-bold text-white transition-colors hover:bg-brand-redhover sm:px-7"
          >
            Send Project Photos
          </a>
        )
      }
      <a
        href={`tel:${vanCampaign.phoneTel}`}
        data-van-phone="final_cta"
        data-cta-location="van_final_cta"
        class="inline-flex min-h-12 items-center justify-center rounded-md border-2 border-white/70 px-6 py-3 text-center text-base font-bold text-white transition-colors hover:bg-white hover:text-brand-black sm:px-7"
        aria-label={`Call Elevate Your Space Handyman at ${vanCampaign.phoneDisplay}`}
      >
        Call {vanCampaign.phoneDisplay}
      </a>
    </div>
    </div>

    <div class="border-t border-white/15 pt-6 lg:col-span-5 lg:border-l lg:border-t-0 lg:pl-10 lg:pt-0">
      <h3 class="text-lg font-bold tracking-tight text-white">
        Serving Katy, Cypress, Fulshear, Richmond &amp; West Houston
      </h3>
      <p class="mt-2 text-sm leading-relaxed text-white/75">
        Just outside the area, or not sure? Give us the address when you book or send photos and
        we&rsquo;ll tell you straight away whether we can take it on. Or{' '}
        <a
          href={`tel:${vanCampaign.phoneTel}`}
          data-van-phone="service_area"
          data-cta-location="van_service_area"
          class="font-bold text-white underline underline-offset-4 hover:text-brand-redondark"
        >call {vanCampaign.phoneDisplay}</a> and ask.
      </p>
    </div>
  </div>
</section>
