---
import SiteImage from '../ui/SiteImage.astro';
import { imageOrPlaceholder } from '../../data/images';
import { formatUsd, smallRepairPricing } from '../../data/pricing/todoList';
import { vanDestinations, vanImages, type VanRouteId } from '../../data/vanCampaign';

type RouteCard = {
  id: VanRouteId;
  title: string;
  description: string;
  note?: string;
  price?: string;
  cta: string;
  href: string | undefined;
  bookingType: string;
  image: { src: string; alt: string; width: number; height: number };
  featured?: boolean;
};

/**
 * Each card leads with a finished job of the kind its button books, so the
 * choice is made by looking rather than by reading.
 *
 * Copy is held to one line on purpose. At 440-490px a card the three of them
 * spanned 2.5 screens, which meant nobody saw the full choice without
 * committing to a scroll; trimmed to a line each they land inside the second
 * screen. The photographs carry the appeal, the sentence only has to name the
 * job.
 *
 * Phones stack the card: photograph above the copy. From `lg` the three sit in
 * a row — a single column of full-width cards on a 1440px monitor is a stack of
 * letterboxes with empty space either side.
 *
 * The price renders from `smallRepairPricing`. Never type the figure here.
 */
const routes = (
  [
    {
      id: 'handyman_booking',
      title: 'Book a To-Do List Visit',
      description:
        'A reserved block of time, worked down your list in the order you choose.',
      price: `From ${formatUsd(smallRepairPricing.oneHour)} the first hour`,
      cta: 'Book a Handyman Visit',
      href: vanDestinations.handymanBooking,
      bookingType: 'handyman_to_do_list',
      image: vanImages.routes.handymanBooking,
      featured: true,
    },
    {
      id: 'photo_estimate',
      title: 'Send Photos for a Free Estimate',
      description:
        'Send photos, get a price and a next step. No visit needed to start.',
      note: 'Repairs · drywall · doors · fixtures · installs',
      cta: 'Send Project Photos',
      href: vanDestinations.photoEstimate,
      bookingType: 'project_estimate',
      image: vanImages.routes.photoEstimate,
    },
    {
      id: 'custom_project',
      title: 'Request a Custom Project Estimate',
      description:
        'Built-ins, carpentry and remodels — work that takes planning and more than a day.',
      cta: 'Request a Custom Estimate',
      href: vanDestinations.customProject,
      bookingType: 'custom_project',
      image: vanImages.routes.customProject,
    },
  ] satisfies RouteCard[]
).filter((route) => Boolean(route.href));
---

<section
  id="service-paths"
  class="scroll-mt-20 bg-brand-black px-4 pb-8 pt-8 sm:px-6 sm:pb-10 sm:pt-10"
  aria-labelledby="van-routes-heading"
>
  <div class="mx-auto max-w-3xl lg:max-w-6xl">
    <h2
      id="van-routes-heading"
      class="text-2xl font-extrabold tracking-tight text-white sm:text-3xl"
    >
      Pick the path that fits your project
    </h2>
    <p class="mt-2 text-sm leading-relaxed text-white/70 sm:text-base">
      Three ways in. Pick whichever fits how you want to start.
    </p>

    <ol class="mt-5 flex flex-col gap-4 lg:grid lg:grid-cols-3 lg:items-stretch lg:gap-5">
      {
        routes.map((route) => (
          <li class="flex">
            <article
              class:list={[
                'flex w-full flex-col overflow-hidden rounded-xl border bg-brand-charcoal',
                route.featured
                  ? 'border-brand-red/50 shadow-[0_0_0_1px_rgba(176,0,0,0.25)]'
                  : 'border-white/10',
              ]}
            >
              <SiteImage
                src={imageOrPlaceholder(route.image.src)}
                alt={route.image.alt}
                width={route.image.width}
                height={route.image.height}
                loading="lazy"
                sizes="(max-width: 768px) 100vw, 768px"
                class="h-32 w-full object-cover object-center sm:h-40 lg:h-36"
              />
              <div class="flex flex-1 flex-col p-4 sm:p-5">
                <h3 class="text-xl font-extrabold leading-snug text-white sm:text-2xl">
                  {route.title}
                </h3>
                <p class="mt-1.5 text-sm leading-relaxed text-white/80">
                  {route.description}
                </p>
                {route.note && (
                  <p class="mt-2 text-xs font-medium uppercase tracking-[0.08em] text-white/55">{route.note}</p>
                )}
                {route.price && (
                  <p class="mt-2.5 text-base font-bold text-brand-redondark">{route.price}</p>
                )}
                <div class="mt-auto pt-4">
                <a
                  href={route.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-van-route={route.id}
                  data-booking-type={route.bookingType}
                  data-cta-location="van_route_card"
                  class:list={[
                    'inline-flex min-h-12 w-full items-center justify-center rounded-md px-4 py-3 text-center text-base font-bold transition-colors',
                    route.featured
                      ? 'bg-brand-red text-white hover:bg-brand-redhover'
                      : 'bg-white text-brand-black hover:bg-white/90',
                  ]}
                >
                  {route.cta}
                </a>
                </div>
              </div>
            </article>
          </li>
        ))
      }
    </ol>
  </div>
</section>
