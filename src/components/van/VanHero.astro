---
import { googleReviewCountDisplay } from '../../data/business';
import { vanCampaign, vanImages } from '../../data/vanCampaign';

/**
 * Someone reached this page by scanning the QR code off the back of the van, so
 * the first screen has to answer "are these people any good?" before it asks
 * for anything. It used to be text on a flat panel with no photograph at all.
 *
 * It leads with footage rather than a photograph because motion is what stops
 * a thumb, and the clip is affordable over cellular only now that it has been
 * re-encoded to 534KB. The poster paints immediately so nothing waits on it.
 *
 * One gradient scrim, not a stack of two. Stops chosen by measurement, not by
 * eye: sampled across five frames of the clip these leave the body copy at
 * 4.8:1 against white on its hottest pixel, just over the 4.5:1 floor, while
 * showing about a quarter more of the footage than the darker version did.
 * Brightening further drops that band below the floor.
 */
const heroVideo = vanImages.heroVideo;
---

<section
  class="van-hero relative overflow-hidden bg-brand-black px-4 pb-6 pt-9 text-white sm:px-6 sm:pb-8 sm:pt-12"
  aria-labelledby="van-hero-heading"
  data-autoplay-video
  data-video-source-page="van"
  data-no-cross-sell-event
>
  <div class="absolute inset-0" aria-hidden="true">
    <video
      class="h-full w-full object-cover object-[center_38%]"
      data-autoplay-video-el
      poster={heroVideo.poster}
      width={heroVideo.width}
      height={heroVideo.height}
      muted
      loop
      playsinline
      preload="none"
      disablepictureinpicture
    >
      <source data-src={heroVideo.src} type="video/mp4" />
    </video>
    <div
      class="absolute inset-0 bg-gradient-to-b from-brand-black/45 via-brand-black/58 to-brand-black/92"
    >
    </div>
  </div>

  <div class="relative mx-auto max-w-3xl">
    <p class="mb-3 text-[11px] font-bold uppercase tracking-[0.14em] text-brand-redondark sm:text-xs">
      Veteran-Owned · {googleReviewCountDisplay()} Google Reviews · Katy &amp; West Houston
    </p>
    <h1
      id="van-hero-heading"
      class="text-3xl font-extrabold leading-tight tracking-tight [text-shadow:0_2px_18px_rgba(0,0,0,0.55)] sm:text-4xl"
    >
      You found the van. Let&rsquo;s get your project done.
    </h1>
    <p
      class="mt-3 max-w-xl text-base leading-relaxed text-white/90 [text-shadow:0_1px_12px_rgba(0,0,0,0.45)] sm:text-lg"
    >
      Repairs, installations, carpentry and full remodels across Katy and West Houston. Pick a path
      below, or call and we&rsquo;ll point you to the right one.
    </p>

    <div class="mt-6 flex flex-col gap-3 sm:flex-row">
      <a
        href="#service-paths"
        class="inline-flex min-h-12 items-center justify-center rounded-md bg-brand-red px-6 py-3 text-center text-base font-bold text-white transition-colors hover:bg-brand-redhover sm:px-7"
      >
        Choose My Project
      </a>
      <a
        href={`tel:${vanCampaign.phoneTel}`}
        data-van-phone="hero"
        data-cta-location="van_hero"
        class="inline-flex min-h-12 items-center justify-center rounded-md border-2 border-white/70 px-6 py-3 text-center text-base font-bold text-white transition-colors hover:bg-white hover:text-brand-black sm:px-7"
        aria-label={`Call Elevate Your Space Handyman at ${vanCampaign.phoneDisplay}`}
      >
        Call {vanCampaign.phoneDisplay}
      </a>
    </div>
  </div>
</section>
