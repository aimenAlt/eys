---
import { vanDestinations, vanImages } from '../../data/vanCampaign';

/**
 * Media walls were a single link in a six-item shortcut grid, which badly
 * undersold the most distinctive work EYS does. This names them and shows a
 * second, different clip from the one in the hero, so the page is not simply
 * replaying itself.
 *
 * The clip is lazy: `preload="none"` plus a `data-src` the shared script swaps
 * in when the section scrolls into view, so a visitor who never reaches it
 * never pays for it.
 */
const video = vanImages.mediaWallVideo;
const href = vanDestinations.customProject;
---

<section
  id="media-walls"
  class="scroll-mt-20 bg-brand-black px-4 py-10 text-white sm:px-6 sm:py-12"
  aria-labelledby="van-media-walls-heading"
  data-autoplay-video
  data-video-source-page="van"
>
  <div class="mx-auto grid max-w-3xl items-center gap-8 lg:max-w-6xl lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-5">
    <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-brand-redondark sm:text-xs">
      What we are known for
    </p>
    <h2
      id="van-media-walls-heading"
      class="mt-2 text-2xl font-extrabold tracking-tight sm:text-3xl"
    >
      Media Walls &amp; Built-Ins
    </h2>
    <p class="mt-3 text-sm leading-relaxed text-white/80 sm:text-base">
      Custom built-ins around your TV — fireplace walls, lit niches, wood-slat and shiplap feature
      walls, floating consoles. Built to look like part of the house, not bolted onto it.
    </p>

    {
      href && (
        <a
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          data-van-project="media_walls"
          data-booking-type="custom_project"
          data-cta-location="van_media_walls"
          class="mt-6 inline-flex min-h-12 w-full items-center justify-center rounded-md bg-brand-red px-4 py-3 text-center text-base font-bold text-white transition-colors hover:bg-brand-redhover sm:w-auto sm:px-7"
        >
          Request a Media Wall Estimate
        </a>
      )
    }
    </div>

    <figure class="overflow-hidden rounded-xl bg-brand-charcoal shadow-card ring-1 ring-white/10 lg:order-first lg:col-span-7">
      <video
        class="aspect-video h-auto w-full object-cover"
        data-autoplay-video-el
        poster={video.poster}
        width={video.width}
        height={video.height}
        muted
        loop
        playsinline
        preload="none"
        disablepictureinpicture
        aria-label={video.label}
      >
        <source data-src={video.src} type="video/mp4" />
      </video>
    </figure>

  </div>
</section>
