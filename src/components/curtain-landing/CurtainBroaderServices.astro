---
/**
 * Secondary bottom cross-sell — after primary curtain conversion content.
 * Curtain-landing only. Text-link CTA; never a competing red booking button.
 */
import {
  curtainAllServicesHref,
  curtainCrossSellServices,
} from '../../data/curtainLanding';
import { withBase } from '../../utils/paths';
---

<section
  class="bg-white px-4 py-10 sm:px-6 sm:py-12 lg:px-8"
  aria-labelledby="curtain-broader-services-heading"
  data-cta-location="curtain_broader_services"
>
  <div class="mx-auto max-w-6xl">
    <h2
      id="curtain-broader-services-heading"
      class="text-xl font-bold tracking-tight text-brand-black sm:text-2xl"
    >
      Curtains are just one thing we do.
    </h2>
    <p class="mt-3 max-w-2xl text-base leading-relaxed text-brand-muted">
      From TV mounting and media walls to lighting, carpentry, repairs, and complete home
      improvements, EYS gives Katy &amp; West Houston homeowners one dependable team for the work
      around their home.
    </p>

    <ul class="mt-6 grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-6" role="list">
      {
        curtainCrossSellServices.map((service) => (
          <li>
            <a
              href={withBase(service.href)}
              class:list={[
                'flex h-full min-h-14 items-center justify-center rounded-lg border px-3 py-3 text-center text-sm font-bold transition-colors',
                service.emphasize
                  ? 'border-brand-red/30 bg-brand-redsoft text-brand-black hover:border-brand-red/50'
                  : 'border-brand-line bg-brand-lightbg text-brand-black hover:border-brand-muted/40 hover:bg-white',
              ]}
            >
              {service.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-6">
      <a
        href={withBase(curtainAllServicesHref)}
        class="inline-flex text-sm font-bold text-brand-red hover:underline"
      >
        Explore All EYS Services →
      </a>
    </div>
  </div>
</section>
