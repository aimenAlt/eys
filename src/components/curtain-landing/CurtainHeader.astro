---
import Logo from '../layout/Logo.astro';
import CurtainBookLink from './CurtainBookLink.astro';
import { site } from '../../data/business';
---

<header class="eys-header eys-on-dark sticky top-0 z-50 border-b border-eys-line-dark bg-eys-ground">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 h-16 px-4 sm:px-6 lg:h-20 lg:px-8">
    <Logo class="shrink-0" />
    <div class="flex shrink-0 items-center gap-2">
      <a
        href={`tel:${site.phoneTel}`}
        data-cta-location="header"
        class="eys-btn eys-btn--gold !h-11 !px-4 !text-sm"
        aria-label={`Call Elevate Your Space Handyman at ${site.phone}`}
      >
        <span class="sm:hidden">Call</span>
        <span class="hidden sm:inline">Call {site.phone}</span>
      </a>
      <CurtainBookLink
        placement="header"
        class="!min-h-11 !w-auto !px-4 !py-2.5 !text-sm"
      >
        Book Installation
      </CurtainBookLink>
    </div>
  </div>
</header>
