---
import { curtainLanding, formatUsd } from '../../data/curtainLanding';
import CurtainBookLink from './CurtainBookLink.astro';

const { pricing } = curtainLanding;
const hc = pricing.highCeiling;
---

<section
  class="bg-white px-4 py-12 sm:px-6 sm:py-16 lg:px-8"
  aria-labelledby="curtain-compare-heading"
  id="pricing"
>
  <div class="mx-auto max-w-6xl">
    <h2
      id="curtain-compare-heading"
      class="text-2xl font-bold tracking-tight text-brand-black sm:text-3xl"
    >
      Rod or Track?
    </h2>
    <p class="mt-3 max-w-2xl text-base leading-relaxed text-brand-muted">
      Pricing differs by hardware type. Both book through the same high-ceiling form — you’ll choose
      rod or track when you book.
    </p>

    <div class="mt-8 grid gap-4 md:grid-cols-2">
      <article class="rounded-xl border border-brand-line bg-brand-lightbg p-6">
        <h3 class="text-lg font-bold uppercase tracking-[0.08em] text-brand-black">Curtain Rod</h3>
        <p class="mt-3 text-3xl font-bold text-brand-black">
          Starting at {formatUsd(hc.rod.startingAt)}
        </p>
        <p class="mt-1 text-sm text-brand-muted">
          Up to {hc.rod.includedWindows} high-ceiling windows
        </p>
        <p class="mt-2 text-sm text-brand-muted">
          Additional window: +{formatUsd(hc.rod.additionalWindow)} each
        </p>
        <p class="mt-5 text-sm leading-relaxed text-brand-charcoal">
          <span class="font-bold text-brand-black">Best for:</span> Traditional curtain and drapery
          rod installations.
        </p>
      </article>

      <article class="rounded-xl border border-brand-line bg-brand-lightbg p-6">
        <h3 class="text-lg font-bold uppercase tracking-[0.08em] text-brand-black">Curtain Track</h3>
        <p class="mt-3 text-3xl font-bold text-brand-black">
          Starting at {formatUsd(hc.track.startingAt)}
        </p>
        <p class="mt-1 text-sm text-brand-muted">
          Up to {hc.track.includedWindows} high-ceiling windows
        </p>
        <p class="mt-2 text-sm text-brand-muted">
          Additional window: +{formatUsd(hc.track.additionalWindow)} each
        </p>
        <p class="mt-5 text-sm leading-relaxed text-brand-charcoal">
          <span class="font-bold text-brand-black">Best for:</span> Ceiling-mounted track systems and
          modern floor-to-ceiling installations.
        </p>
      </article>
    </div>

    <div class="mt-8">
      <CurtainBookLink placement="pricing">
        See Available Times &amp; Book
      </CurtainBookLink>
    </div>
  </div>
</section>
