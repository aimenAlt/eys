---
const customerProvides = [
  'Curtains / drapery',
  'Curtain rods or track system',
  'Required installation hardware',
] as const;

const eysProvides = [
  'Professional installation',
  'High-ceiling access and equipment needed for the install',
  'Mounting, leveling, and alignment',
  'Clean completion',
] as const;
---

<section
  class="bg-brand-lightbg px-4 py-12 sm:px-6 sm:py-16 lg:px-8"
  aria-labelledby="curtain-included-heading"
>
  <div class="mx-auto max-w-6xl">
    <h2
      id="curtain-included-heading"
      class="text-2xl font-bold tracking-tight text-brand-black sm:text-3xl"
    >
      What’s Included
    </h2>
    <p class="mt-3 max-w-2xl text-base leading-relaxed text-brand-muted">
      This booking is for installation. Have your materials on site before the appointment.
    </p>

    <div class="mt-8 grid gap-4 md:grid-cols-2">
      <div class="rounded-xl border border-brand-line bg-white p-6">
        <h3 class="text-lg font-bold text-brand-black">Customer Provides</h3>
        <ul class="mt-4 space-y-3 text-sm leading-relaxed text-brand-charcoal sm:text-base">
          {customerProvides.map((item) => (
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-red" aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="rounded-xl border border-brand-line bg-white p-6">
        <h3 class="text-lg font-bold text-brand-black">EYS Provides</h3>
        <ul class="mt-4 space-y-3 text-sm leading-relaxed text-brand-charcoal sm:text-base">
          {eysProvides.map((item) => (
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-red" aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
