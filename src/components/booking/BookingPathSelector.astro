---
/**
 * `/book/` hierarchy. The three paths used to be presented as equal-weight
 * cards, which asked visitors who had already decided to decide again — the
 * page averaged 0-4s engaged time. Project Estimate Request is now the
 * dominant, full-width choice; the fixed-scope forms stay available beneath it.
 */
import {
  jobberHandymanToDoListFormUrl,
  jobberOnlineBookingUrl,
  jobberProjectEstimateFormUrl,
  site,
} from '../../data/business';

const estimateUrl = jobberProjectEstimateFormUrl();

const secondaryForms = [
  {
    title: 'Handyman To-Do List Visit',
    description:
      'Book a handyman to work through multiple small repairs, installations, and maintenance tasks in one visit.',
    href: jobberHandymanToDoListFormUrl(),
    bookingType: 'handyman_to_do_list',
  },
  {
    title: 'Tell Us About Your TV Mounting Project',
    description:
      'Answer a few questions and upload photos so we can verify pricing and bring the right materials.',
    href: jobberOnlineBookingUrl(),
    bookingType: 'tv_mounting',
  },
].filter((form) => Boolean(form.href));
---

<section class="py-10 md:py-12 bg-white" aria-labelledby="booking-options">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-8">
      <h1 id="booking-options" class="text-4xl md:text-5xl font-extrabold text-brand-black mb-4">
        Book or Request Service
      </h1>
      <p class="text-lg text-gray-600 mb-4">
        Start with a photo estimate from {site.name} in Katy and West Houston — or call and we will
        sort the right path with you.
      </p>
      <p class="text-base text-gray-700">
        <a
          href={`tel:${site.phoneTel}`}
          data-cta-location="booking_path_phone"
          class="inline-block py-1 font-bold text-brand-red hover:underline"
        >
          Call {site.phone}
        </a>
        <span class="text-gray-500"> · open until 11:30 PM, 7 days</span>
      </p>
    </div>

    <div
      class="rounded-xl border border-gray-200 border-l-4 border-l-brand-red bg-brand-lightbg p-6 md:p-8 mb-10"
    >
      <p class="text-xs font-bold uppercase tracking-widest text-brand-red mb-2">Start here</p>
      <h2 class="text-2xl md:text-3xl font-bold text-brand-black mb-3">Project Estimate Request</h2>
      <p class="text-gray-600 mb-6 max-w-2xl leading-relaxed">
        Tell us about your project and upload photos. We review the scope and return an itemized
        estimate — this is the right start for repairs, installations, carpentry and larger projects.
      </p>
      <a
        href={estimateUrl ?? '/contact/'}
        data-booking-type="project_estimate"
        data-cta-location="booking_path_primary"
        class="inline-flex w-full sm:w-auto justify-center items-center bg-brand-red text-white px-8 py-4 rounded-md font-bold text-base sm:text-lg shadow-lg hover:bg-brand-redhover transition-colors"
      >
        Open the estimate form
      </a>
    </div>

    {
      secondaryForms.length > 0 && (
        <div>
          <h2 class="text-lg font-bold text-brand-black mb-1">Know exactly what you need?</h2>
          <p class="text-sm text-gray-600 mb-5">
            These forms are for fixed-scope work you have already decided on.
          </p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {secondaryForms.map((form) => (
              <a
                href={form.href}
                target="_blank"
                rel="noopener noreferrer"
                data-booking-type={form.bookingType}
                data-cta-location="booking_path_selector"
                class="block p-6 bg-white rounded-xl border border-gray-200 hover:border-brand-red/30 hover:shadow-md transition-all"
              >
                <h3 class="text-lg font-bold text-brand-black mb-2">{form.title}</h3>
                <p class="text-sm text-gray-600">{form.description}</p>
              </a>
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>
