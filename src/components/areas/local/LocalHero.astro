---
import SiteImage from '../../ui/SiteImage.astro';
import { resolveCityHero } from '../../../data/images';
import { site } from '../../../data/business';
import { contentMaxClass, contentPaddingClass } from '../../../data/layout';

interface Props {
  heading: string;
  summary?: string;
  locationLabel?: string;
  promoCode?: string;
  promoOffer?: string;
  heroImage?: string;
  heroImageAlt?: string;
  citySlug?: string;
  /**
   * Optional override for the primary button. Omitted everywhere except
   * /services/repairs-and-maintenance/ (backlog 004), so every other page
   * keeps `/contact/` + `local_hero_primary` / `local_hero_phone` unchanged.
   */
  primaryCta?: { href: string; bookingType?: string; ctaLocation: string };
  phoneCtaLocation?: string;
}

const {
  heading,
  summary,
  locationLabel,
  promoCode,
  promoOffer,
  heroImage,
  heroImageAlt = 'Handyman services',
  citySlug,
  primaryCta,
  phoneCtaLocation = 'local_hero_phone',
} = Astro.props;

const imageSrc = resolveCityHero(citySlug, heroImage);
---

<section class="eys-page-hero eys-on-dark" aria-labelledby="local-hero">
  <div class:list={['mx-auto', contentMaxClass, contentPaddingClass, 'pt-10 md:pt-16']}>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <div>
        {
          locationLabel && (
            <p class="eys-eyebrow eys-kicker mb-4 text-eys-on-dark-2">
              {locationLabel}
            </p>
          )
        }
        <h1 id="local-hero" class="eys-h1 mb-5">
          {heading}
        </h1>
        {
          summary && (
            <p class="eys-page-hero-lede eys-body mb-8">{summary}</p>
          )
        }
        {
          promoCode && promoOffer && (
            <p class="inline-flex items-center gap-2 text-sm bg-eys-panel border border-eys-panel-line text-eys-on-dark px-4 py-2 rounded-full mb-6">
              <span class="font-bold text-eys-cta-bg">{promoCode}</span>
              <span class="text-eys-on-dark-2">— {promoOffer}</span>
            </p>
          )
        }
        <div class="flex flex-col sm:flex-row gap-3" data-sticky-hero-cta>
          <a
            href={primaryCta?.href ?? '/contact/'}
            data-booking-type={primaryCta?.bookingType}
            data-cta-location={primaryCta?.ctaLocation ?? 'local_hero_primary'}
            class="eys-hero-btn eys-hero-btn--red"
          >
            Request an Estimate
          </a>
          <a
            href={`tel:${site.phoneTel}`}
            data-cta-location={phoneCtaLocation}
            class="eys-hero-btn eys-hero-btn--outline"
          >
            Call {site.phone}
          </a>
        </div>
      </div>
      <div class="eys-page-hero-media"><div class="eys-page-hero-frame aspect-[4/3]">
        <SiteImage
          src={imageSrc}
          alt={heroImageAlt}
          class="w-full h-full object-cover"
          loading="eager"
          fetchpriority="high"
          sizes="(max-width: 1024px) 100vw, 600px"
          width={800}
          height={600}
        />
      </div></div>
    </div>
  </div>
  <div class="eys-stripe" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
</section>
