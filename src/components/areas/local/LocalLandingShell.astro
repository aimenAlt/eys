---
import { contentMaxClass, contentPaddingClass } from '../../../data/layout';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`bg-brand-lightbg ${className}`}>
  <div class:list={['mx-auto', contentMaxClass, contentPaddingClass, 'py-10 md:py-12 space-y-10 md:space-y-12']}>
    <slot />
  </div>
</div>
