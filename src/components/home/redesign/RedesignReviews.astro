---
/**
 * 5. WHAT CUSTOMERS SAY (warm). Three quoted Google reviews (verified verbatim
 * and 5-star on 12 Oct 2026; stars in ink, never gold). The aggregate rating
 * and count come only from `googleReviews`.
 */
import { googleReviewCountDisplay, googleReviewProfileUrl, googleReviews } from '../../../data/business';
import { homeReviews } from '../../../data/homeRedesign';

const reviewUrl = googleReviewProfileUrl();
---

<section class="eys-section bg-eys-warm text-eys-ink" data-analytics-section="reviews">
  <div class="eys-container">
    <div class="lg:flex lg:items-end lg:justify-between lg:gap-6">
      <h2 class="eys-h2">What customers say</h2>
      {
        reviewUrl && (
          <a href={reviewUrl} target="_blank" rel="noopener noreferrer" data-track-review data-cta-location="home_reviews" class="eys-text-link mt-2 inline-flex items-center gap-2 whitespace-nowrap text-sm leading-5 lg:mt-0 lg:text-[15px]">
            <span aria-hidden="true" class="text-base leading-5 lg:text-[17px]">★</span><span><strong>{googleReviews.rating.toFixed(1)}</strong> · {googleReviewCountDisplay()} Google reviews</span>
          </a>
        )
      }
    </div>

    <div class="mt-6 grid grid-cols-1 gap-4 lg:mt-8 lg:grid-cols-3 lg:gap-6">
      {
        homeReviews.map((review) => (
          <figure class="flex flex-col rounded-[6px] border border-eys-rule bg-eys-white p-5 lg:p-7">
            <div role="img" aria-label="Rated 5 out of 5" class="text-[13px] leading-4 tracking-[2px] text-eys-ink">★★★★★</div>
            <blockquote class="mt-2.5 text-[15px] leading-[22px] [text-wrap:pretty] lg:text-base lg:leading-6">“{review.quote}”</blockquote>
            <figcaption class="mt-3 text-[13px] leading-[18px] text-eys-ink-2 lg:mt-auto lg:pt-4 lg:text-sm lg:leading-5">
              {review.author ? <><strong class="text-eys-ink">{review.author}</strong> · Google review</> : 'Google review'}
            </figcaption>
          </figure>
        ))
      }
    </div>

    {
      reviewUrl && (
        <a href={reviewUrl} target="_blank" rel="noopener noreferrer" data-track-review data-cta-location="home_reviews_all" class="eys-text-link mt-5 inline-block text-[15px] font-bold leading-[22px] underline underline-offset-[3px] lg:mt-6">
          Read all {googleReviewCountDisplay()} reviews on Google →
        </a>
      )
    }
  </div>
</section>
