---
/**
 * 5. WHAT CUSTOMERS SAY (warm). Three quoted Google reviews (verified verbatim
 * and 5-star on 12 Oct 2026; stars in ink, never gold). The aggregate rating
 * and count come only from `googleReviews`.
 */
import { googleReviewCountDisplay, googleReviewProfileUrl, googleReviews } from '../../../data/business';
import { homeReviews } from '../../../data/homeRedesign';

const reviewUrl = googleReviewProfileUrl();
---

<section class="eys-section bg-eys-warm text-eys-ink" data-analytics-section="reviews">
  <div class="eys-container">
    <div class="lg:flex lg:items-end lg:justify-between lg:gap-6">
      <h2 class="eys-h2 eys-barred">What customers say</h2>
      {
        reviewUrl && (
          <a href={reviewUrl} target="_blank" rel="noopener noreferrer" data-track-review data-cta-location="home_reviews" class="eys-text-link mt-2 inline-flex items-center gap-2 whitespace-nowrap text-sm leading-5 lg:mt-0 lg:text-[15px]">
            <span aria-hidden="true" class="eys-stars--ink text-base leading-5 lg:text-lg">★</span><span><strong>{googleReviews.rating.toFixed(1)}</strong> · {googleReviewCountDisplay()} Google reviews</span>
          </a>
        )
      }
    </div>

    <div class="mt-8 grid grid-cols-1 gap-5 lg:mt-14 lg:grid-cols-3 lg:items-stretch lg:gap-8">
      {
        homeReviews.map((review, i) => {
          const dark = i === 1;
          return (
            <figure class:list={['eys-card eys-quote eys-reveal flex flex-col p-6 lg:p-9', dark && 'eys-quote--dark eys-quote--lift']} style={`--d:${i * 0.1}s`}>
              <div role="img" aria-label="Rated 5 out of 5" class:list={['eys-stars text-base leading-5', !dark && 'eys-stars--ink']}>★★★★★</div>
              <blockquote class="relative mt-4 text-base leading-[25px] [text-wrap:pretty] lg:text-[17px] lg:leading-[27px]">“{review.quote}”</blockquote>
              <figcaption class:list={['mt-5 border-t pt-4 text-[13px] leading-[18px] lg:mt-auto lg:pt-5 lg:text-sm lg:leading-5', dark ? 'border-eys-line-dark text-eys-on-dark-3' : 'border-eys-rule text-eys-ink-2']}>
                {review.author ? <><strong class={dark ? 'text-eys-on-dark' : 'text-eys-ink'}>{review.author}</strong> · Google review</> : 'Google review'}
              </figcaption>
            </figure>
          );
        })
      }
    </div>

    {
      reviewUrl && (
        <a href={reviewUrl} target="_blank" rel="noopener noreferrer" data-track-review data-cta-location="home_reviews_all" class="eys-text-link eys-arrow-link mt-8 text-[15px] font-bold leading-[22px] underline underline-offset-[3px] lg:mt-10">
          Read all {googleReviewCountDisplay()} reviews on Google →
        </a>
      )
    }
  </div>
</section>
