---
/** 10. HOW IT WORKS (white). Three steps as drawn; the phone number never breaks. */
import { site } from '../../../data/business';
import { howItWorksSteps } from '../../../data/homeRedesign';
---

<section class="eys-section bg-eys-white text-eys-ink" data-analytics-section="how_it_works">
  <div class="eys-container">
    <h2 class="eys-h2">How it works</h2>
    <ol class="mt-6 grid grid-cols-1 gap-6 lg:mt-8 lg:grid-cols-3">
      {
        howItWorksSteps.map((step, i) => (
          <li class="grid grid-cols-[48px_1fr] gap-4 lg:block lg:border-t-2 lg:border-eys-ink lg:pt-5">
            <div class="eys-figure text-eys-ink-3" aria-hidden="true">{i + 1}</div>
            <div>
              <h3 class="eys-h3 pt-[5px] lg:mt-3 lg:pt-0">{step.title}</h3>
              <p class="mt-1 text-[15px] leading-[22px] text-eys-ink-2 [text-wrap:pretty] lg:mt-2">
                {step.text}{i === 0 && <> <span class="whitespace-nowrap">{site.phone}</span>.</>}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
