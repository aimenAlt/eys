---
/** 10. HOW IT WORKS (white). Three steps as drawn; the phone number never breaks. */
import { site } from '../../../data/business';
import { howItWorksSteps } from '../../../data/homeRedesign';
---

<section class="eys-section bg-eys-warm text-eys-ink" data-analytics-section="how_it_works">
  <div class="eys-container">
    <h2 class="eys-h2 eys-barred">How it works</h2>
    <ol class="eys-steps mt-8 grid grid-cols-1 gap-8 lg:mt-14 lg:grid-cols-3 lg:gap-10">
      {
        howItWorksSteps.map((step, i) => (
          <li class="eys-reveal grid grid-cols-[64px_1fr] gap-4 lg:block" style={`--d:${i * 0.12}s`}>
            <div class="eys-step-num" aria-hidden="true">{i + 1}</div>
            <div>
              <h3 class="eys-h3 pt-2 lg:mt-5 lg:pt-0">{step.title}</h3>
              <p class="mt-1 text-[15px] leading-[22px] text-eys-ink-2 [text-wrap:pretty] lg:mt-2 lg:text-base lg:leading-6">
                {step.text}{i === 0 && <> <span class="whitespace-nowrap">{site.phone}</span>.</>}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
