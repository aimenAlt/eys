---
/**
 * 12. CLOSING CTA on a full-bleed great-room photo (decorative) under a navy
 * shade. Phone: red "Get a Free Quote", then outline Call. Desktop: centred,
 * red Call, then outline "Get a Free Quote".
 */
import SiteImage from '../../ui/SiteImage.astro';
import Button from '../../site/Button.astro';
import { jobberProjectEstimateFormUrl, site } from '../../../data/business';
import { closingCopy } from '../../../data/homeRedesign';
import { withBase } from '../../../utils/paths';

const quoteUrl = jobberProjectEstimateFormUrl() ?? withBase('/contact/');
---

<section class="eys-closing eys-on-dark text-eys-on-dark" data-analytics-section="closing_cta">
  <div class="eys-stripe !mt-0" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
  <div class="eys-closing-bg" aria-hidden="true">
    <SiteImage src="/images/home/cta-bg.jpg" alt="" width={1440} height={1920} sizes="100vw" />
  </div>
  <div class="eys-container pb-20 pt-16 lg:pb-36 lg:pt-28">
    <div class="eys-reveal lg:mx-auto lg:max-w-[760px] lg:text-center">
      <h2 class="eys-h2 eys-barred eys-barred--center text-eys-on-dark lg:text-[56px] lg:leading-[60px]">Send one project list.</h2>
      <p class="eys-body mt-5 text-eys-on-dark-2">{closingCopy}</p>
      <div class="eys-cta-pair eys-cta-pair--on-dark eys-cta-pair--center mt-8 lg:mt-10">
        <Button href={quoteUrl} data-cta-role="form" data-booking-type="project_estimate" data-cta-location="home_final_cta">Get a Free Quote</Button>
        <Button href={`tel:${site.phoneTel}`} phoneIcon data-cta-role="call" data-cta-location="home_final_cta">Call {site.phone}</Button>
      </div>
    </div>
  </div>
</section>
