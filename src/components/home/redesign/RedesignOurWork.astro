---
/**
 * 4. OUR WORK (white). Eight tiles, each linking to its project page; alt text
 * and town come from the project's content entry. Phone: 2 columns (tile 1
 * full width at 400px, tile 4 full width at 300px, the rest 200px). Desktop:
 * 3 columns (tile 1 spans two rows at 584px, the rest 272px).
 */
import SiteImage from '../../ui/SiteImage.astro';
import { homeGallery } from '../../../data/homeRedesign';
import { projectImageInfo } from './projectImage';
import { nowrapHyphens } from '../../../utils/nowrap';
import { withBase } from '../../../utils/paths';

const tiles = await Promise.all(
  homeGallery.map(async (tile) => {
    const info = tile.projectSlug ? await projectImageInfo(tile.projectSlug, tile.src) : { alt: tile.alt ?? '', city: undefined };
    return { ...tile, alt: info.alt, city: info.city };
  }),
);
---

<section class="eys-section eys-on-dark bg-eys-ground text-eys-on-dark" data-analytics-section="our_work">
  <div class="eys-container">
    <div class="lg:flex lg:items-end lg:justify-between lg:gap-6">
      <div>
        <p class="eys-eyebrow eys-kicker text-eys-on-dark-2">Our Work</p>
        <h2 class="eys-h2 mt-4 text-eys-on-dark">Real projects, real homes</h2>
      </div>
      <p class="mt-2 text-sm leading-5 text-eys-on-dark-2 lg:mt-0 lg:text-base lg:leading-6">Katy, Fulshear and West&nbsp;Houston.</p>
    </div>

    <div class="eys-gallery mt-8 lg:mt-12">
      {
        tiles.map((tile, i) => (
          <a href={withBase(tile.href)} class="eys-text-link-dark eys-reveal block" style={`--d:${(i % 3) * 0.08}s`}>
            <figure>
              <span class="eys-gallery-frame" style={`--crop-phone:${tile.crop[0]};--crop-desktop:${tile.crop[1]}`}>
                <SiteImage
                  src={tile.src}
                  alt={tile.alt}
                  width={tile.width}
                  height={tile.height}
                  sizes={i === 0 || i === 3 ? '(min-width: 1024px) 440px, 100vw' : '(min-width: 1024px) 440px, 50vw'}
                />
              </span>
              <figcaption class="text-[13px] leading-[18px] lg:text-[15px] lg:leading-5">
                <span class="block">
                  <span set:html={nowrapHyphens(tile.caption)} />
                  {tile.city && (
                    <>
                      <span class="eys-gallery-town hidden lg:inline">&nbsp;·&nbsp;</span>
                      <span class="eys-gallery-town block lg:inline" set:html={tile.city.replace(' ', '&nbsp;')} />
                    </>
                  )}
                </span>
              </figcaption>
            </figure>
          </a>
        ))
      }
    </div>
  </div>
</section>
