---
/**
 * Redesigned homepage body (backlog 013, approved Claude Design Round 3.3).
 * Sections in order; the page's chrome (SiteHeader, SiteFooter, SiteBottomBar)
 * is rendered by the page file. Static content: src/data/homeRedesign.ts.
 */
import RedesignHero from './RedesignHero.astro';
import RedesignTrustStrip from './RedesignTrustStrip.astro';
import RedesignStartVisit from './RedesignStartVisit.astro';
import RedesignOurWork from './RedesignOurWork.astro';
import RedesignReviews from './RedesignReviews.astro';
import RedesignOwner from './RedesignOwner.astro';
import RedesignServices from './RedesignServices.astro';
import RedesignAbout from './RedesignAbout.astro';
import RedesignFaq from './RedesignFaq.astro';
import RedesignHowItWorks from './RedesignHowItWorks.astro';
import RedesignServiceAreas from './RedesignServiceAreas.astro';
import RedesignClosingCta from './RedesignClosingCta.astro';

interface Props {
  /** Accepted so "/" passes every homepage variant the same data; the redesign does not use these two. */
  projectCount?: number;
  publishedReviews?: unknown[];
  cityLinks: { title: string; slug: string }[];
  communityLinks: { title: string; citySlug: string; slug: string }[];
}

const { cityLinks, communityLinks } = Astro.props;
---

{/* Scroll reveal: flag set before the sections parse so nothing flashes. */}
<script is:inline>
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.classList.add('eys-reveal-on');
  }
</script>
<RedesignHero />
<RedesignTrustStrip />
<RedesignStartVisit />
<RedesignOurWork />
<RedesignReviews />
<RedesignOwner />
<RedesignServices />
<RedesignAbout />
<RedesignFaq />
<RedesignHowItWorks />
<RedesignServiceAreas cityLinks={cityLinks} communityLinks={communityLinks} />
<RedesignClosingCta />

<script>
  // Reveal each `.eys-reveal` block once its top reaches 92% of the viewport —
  // or once it is above the viewport, so a fast fling or an anchor jump never
  // leaves a section hidden — then drop the classes so hover transitions apply.
  const root = document.documentElement;
  if (root.classList.contains('eys-reveal-on')) {
    let pending = [...document.querySelectorAll<HTMLElement>('.eys-reveal')];
    let queued = false;
    const check = () => {
      queued = false;
      const line = window.innerHeight * 0.92;
      pending = pending.filter((el) => {
        if (el.getBoundingClientRect().top > line) return true;
        el.classList.add('is-in');
        const delay = parseFloat(getComputedStyle(el).getPropertyValue('--d')) || 0;
        window.setTimeout(() => el.classList.remove('eys-reveal', 'is-in'), 900 + delay * 1000);
        return false;
      });
      if (!pending.length) window.removeEventListener('scroll', onScroll);
    };
    const onScroll = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(check);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    check();
  }
</script>
