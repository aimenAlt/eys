---
/**
 * 7. SERVICES (warm, #services). Not on the boards: the live ServiceGrid
 * content, restyled. On phone each category's service links collapse with the
 * sanctioned `.mobile-collapse` pattern (content stays in the DOM).
 */
import { serviceCategories } from '../../../data/serviceCategories';
import { localityShort } from '../../../data/business';
import { withBase } from '../../../utils/paths';
---

<section id="services" class="eys-section bg-eys-warm text-eys-ink" data-analytics-section="services">
  <div class="eys-container">
    <p class="eys-eyebrow text-eys-ink-2">What We Offer</p>
    <h2 class="eys-h2 mt-2">Our Services</h2>
    <p class="eys-body mt-3 max-w-[720px] text-eys-ink-2">
      Repairs, installations, finish carpentry, and home upgrades for houses in {localityShort('and')} — choose the service path that fits your project.
    </p>

    <div class="mt-6 grid grid-cols-1 gap-5 lg:mt-8 lg:grid-cols-3 lg:gap-6">
      {
        serviceCategories.map((category) => (
          <article class="flex flex-col rounded-[6px] border border-eys-rule bg-eys-white p-5 lg:p-7">
            <h3 class="eys-h3">{category.title}</h3>
            <p class="mt-2 text-[15px] leading-[22px] text-eys-ink-2 [text-wrap:pretty]">{category.summary}</p>
            <details class="mobile-collapse group mt-4">
              <summary class="flex items-center justify-between border-t border-eys-rule pt-3 text-[15px] font-bold leading-[22px] md:hidden">
                <span>{category.items.length} services</span>
                <svg class="chev h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              </summary>
              <ul class="mobile-collapse-body mt-3 space-y-2 text-[15px] leading-[22px] md:mt-0">
                {category.items.map((item) => (
                  <li>
                    {item.serviceSlug ? (
                      <a href={withBase(`/services/${item.serviceSlug}/`)} class="eys-text-link hover:underline">{item.title}</a>
                    ) : (
                      <span>{item.title}</span>
                    )}
                  </li>
                ))}
              </ul>
            </details>
            <a href={withBase(`/services/${category.slug}/`)} class="eys-text-link mt-5 inline-block font-bold underline underline-offset-[3px] lg:mt-auto lg:pt-6">{category.ctaLabel} →</a>
          </article>
        ))
      }
    </div>
  </div>
</section>
