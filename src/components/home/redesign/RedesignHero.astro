---
/**
 * 1. HERO (backlog 013). One DOM: phone order = Eyad-and-van photo (first
 * thing under the header, full-bleed 3:2), copy, CTAs, to-do link, review card;
 * desktop = copy (with the review card under it) | photo, vertically centred.
 * The photo is the page's LCP image: eager, fetchpriority high, never cropped,
 * cover-fit or overlaid.
 */
import SiteImage from '../../ui/SiteImage.astro';
import Button from '../../site/Button.astro';
import {
  googleReviewCountDisplay,
  googleReviewProfileUrl,
  googleReviews,
  jobberHandymanToDoListFormUrl,
  jobberProjectEstimateFormUrl,
  localityShort,
  site,
} from '../../../data/business';
import { vanEyadPhoto } from '../../../data/images';
import { heroReview } from '../../../data/homeRedesign';
import { formatUsd, smallRepairPricing } from '../../../data/pricing/todoList';
import { keepTogether } from '../../../utils/nowrap';
import { withBase } from '../../../utils/paths';

const quoteUrl = jobberProjectEstimateFormUrl() ?? withBase('/contact/');
const todoUrl = jobberHandymanToDoListFormUrl() ?? withBase('/book/');
const reviewUrl = googleReviewProfileUrl();
const locality = keepTogether(localityShort('&'));
---

<section class="eys-hero eys-on-dark bg-eys-ground text-eys-on-dark" data-analytics-section="hero">
  <div class="eys-hero-stage">
  <div class="eys-hero-slash" aria-hidden="true"></div>
  <div class="eys-container">
    <div class="eys-hero-grid">
      <div class="eys-hero-photo">
        <SiteImage
          src={vanEyadPhoto.src}
          alt={vanEyadPhoto.alt}
          width={vanEyadPhoto.width}
          height={vanEyadPhoto.height}
          loading="eager"
          fetchpriority="high"
          sizes="(min-width: 1024px) 52vw, 100vw"
        />
      </div>

      <div class="eys-hero-copy">
        <p class="eys-eyebrow eys-kicker eys-rise text-eys-on-dark-2">Veteran-Owned · {locality}</p>
        <h1 class="eys-h1 eys-rise eys-rise-2 mt-4 text-eys-on-dark lg:mt-5">Handyman Services for {locality}</h1>
        {
          reviewUrl && (
            <a
              href={reviewUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-track-review
              data-cta-location="home_hero_trust"
              class="eys-text-link-dark eys-rise eys-rise-3 mt-5 inline-flex items-center gap-2 whitespace-nowrap text-sm leading-5 text-eys-on-dark lg:text-base"
            ><span aria-hidden="true" class="eys-stars text-base leading-5 lg:text-lg">★</span><span><strong>{googleReviews.rating.toFixed(1)}</strong> · {googleReviewCountDisplay()} Google reviews</span></a>
          )
        }
        <p class="eys-body eys-rise eys-rise-3 mt-4 max-w-[540px] text-eys-on-dark-2 lg:mt-5">
          Send one project list. We handle everyday repairs, precise installations, finish carpentry, room upgrades, and larger custom projects.
        </p>

        <div class="eys-cta-pair eys-cta-pair--on-dark eys-rise eys-rise-4 mt-7 lg:mt-9" data-sticky-hero-cta>
          <Button href={quoteUrl} data-cta-role="form" data-booking-type="project_estimate" data-cta-location="home_hero_primary">Send Photos for a Free Estimate</Button>
          <Button href={`tel:${site.phoneTel}`} phoneIcon data-cta-role="call" data-cta-location="home_hero_call">Call {site.phone}</Button>
        </div>
        <a
          href={todoUrl}
          data-booking-type="handyman_to_do_list"
          data-cta-location="home_hero_secondary"
          class="eys-text-link-dark eys-rise eys-rise-4 mt-4 inline-block text-sm leading-5 text-eys-on-dark underline decoration-eys-outline-dark underline-offset-[3px] lg:text-[15px]"
        >Book a Handyman <span class="whitespace-nowrap">To-Do</span> List Visit · From {formatUsd(smallRepairPricing.oneHour)}</a>

        <figure class="eys-hero-review eys-rise eys-rise-5 mt-6 max-w-[540px] p-5 lg:mt-12 lg:p-6">
          <div role="img" aria-label="Rated 5 out of 5" class="eys-stars text-sm leading-4">★★★★★</div>
          <blockquote class="mt-2.5 text-sm leading-5 text-eys-on-dark [text-wrap:pretty] lg:text-[15px] lg:leading-[22px]">“{heroReview.quote}”</blockquote>
          <figcaption class="mt-2 text-xs leading-4 text-eys-on-dark-3 lg:text-[13px] lg:leading-[18px]"><strong class="text-eys-on-dark">{heroReview.author}</strong> · Google review</figcaption>
        </figure>
      </div>
    </div>
  </div>
  </div>
  <div class="eys-stripe" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
</section>
