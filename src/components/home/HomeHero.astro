---
import JobberRequestCard from '../booking/JobberRequestCard.astro';
import {
  googleReviewCountDisplay,
  googleReviewProfileUrl,
  googleReviews,
  jobberHandymanToDoListFormUrl,
  jobberProjectEstimateFormUrl,
} from '../../data/business';
import SiteImage from '../ui/SiteImage.astro';
import { homeImageAlts, homeImages, imageOrPlaceholder } from '../../data/images';
import { smallRepairVisitMeta } from '../../data/smallRepairVisitContent';

const heroSrc = imageOrPlaceholder(homeImages.hero);
const toDoListUrl = jobberHandymanToDoListFormUrl() ?? smallRepairVisitMeta.path;
const customProjectUrl = jobberProjectEstimateFormUrl() ?? '/contact/';
const gbpUrl = googleReviewProfileUrl();
const reviewProof = `${googleReviews.rating.toFixed(1)} ★ · ${googleReviewCountDisplay()} Google reviews`;
---

<section class="relative overflow-hidden bg-brand-black min-h-[min(78vh,760px)]">
  <div class="absolute inset-0" aria-hidden="true">
    <SiteImage
      src={heroSrc}
      alt={homeImageAlts.hero}
      width={1600}
      height={1200}
      loading="eager"
      fetchpriority="high"
      sizes="100vw"
      class="h-full w-full object-cover object-[center_40%]"
    />
    <!-- Keep most of the photo visible; only shade the copy column -->
    <div
      class="absolute inset-0 bg-gradient-to-r from-brand-black/75 via-brand-black/35 to-transparent md:via-brand-black/25"
    >
    </div>
    <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-brand-black/45 to-transparent">
    </div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-14 sm:pt-14 lg:pt-24 lg:pb-28">
    <div class="lg:grid lg:grid-cols-12 lg:gap-12 items-center">
      <div class="lg:col-span-7">
        <span
          class="inline-block py-1 px-3 rounded-md bg-black/35 text-white text-xs font-bold tracking-wider mb-4 border border-white/30 uppercase backdrop-blur-[2px]"
        >
          Veteran-Owned · Katy &amp; West Houston
        </span>
        <h1
          class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white leading-tight tracking-tight mb-4 [text-shadow:0_2px_24px_rgba(0,0,0,0.55)]"
        >
          Handyman Services for Katy &amp; West Houston
        </h1>
        <p
          class="text-lg text-white/95 mb-6 leading-relaxed max-w-2xl [text-shadow:0_1px_12px_rgba(0,0,0,0.5)]"
        >
          Send one project list. We handle everyday repairs, precise installations, finish carpentry,
          room upgrades, and larger custom projects.
        </p>
        <div data-sticky-hero-cta>
          <a
            href={customProjectUrl}
            data-booking-type="project_estimate"
            data-cta-location="home_hero_primary"
            class="inline-flex w-full sm:w-auto justify-center items-center bg-brand-red text-white border-2 border-brand-red px-7 py-4 rounded-md font-bold text-base sm:text-lg text-center shadow-lg hover:bg-brand-redhover hover:border-brand-redhover transition-all"
          >
            Request a Free Photo Estimate
          </a>
          <div class="mt-3 flex flex-col sm:flex-row sm:items-center gap-x-5 gap-y-3">
            <a
              href={toDoListUrl}
              data-cta-location="home_hero_secondary"
              class="inline-flex w-full sm:w-auto justify-center items-center bg-transparent text-white border border-white/70 px-5 py-3 rounded-md font-semibold text-sm text-center hover:bg-white hover:text-brand-black transition-all"
            >
              Book a Handyman To-Do List Visit
            </a>
            <a
              href={customProjectUrl}
              data-cta-location="home_hero_custom_project"
              class="inline-block py-1 text-white/90 text-sm font-semibold underline underline-offset-2 hover:text-white transition-colors [text-shadow:0_1px_8px_rgba(0,0,0,0.45)]"
            >
              Discuss Your Custom Project
            </a>
          </div>
        </div>
        <div
          class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm font-medium text-white/90 [text-shadow:0_1px_8px_rgba(0,0,0,0.45)]"
        >
          {
            gbpUrl ? (
              <a
                href={gbpUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-track-review
                data-cta-location="home_hero_trust"
                class="inline-flex items-center gap-1 py-1 font-bold hover:text-white transition-colors"
              >
                {reviewProof}
              </a>
            ) : (
              <span class="flex items-center gap-1 font-bold">{reviewProof}</span>
            )
          }
          <span class="hidden sm:inline text-white/40">•</span>
          <span class="flex items-center gap-1">
            <svg class="w-5 h-5 text-brand-redondark" fill="currentColor" viewBox="0 0 20 20"
              ><path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path></svg
            >
            Veteran-Owned
          </span>
          <span class="hidden sm:inline text-white/40">•</span>
          <span class="flex items-center gap-1">
            <svg class="w-5 h-5 text-brand-redondark" fill="currentColor" viewBox="0 0 20 20"
              ><path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path></svg
            >
            Clear Service Paths
          </span>
          <span class="hidden sm:inline text-white/40">•</span>
          <a
            href="/service-areas/"
            class="flex items-center gap-1 hover:text-white transition-colors"
          >
            <svg class="w-5 h-5 text-brand-redondark" fill="currentColor" viewBox="0 0 20 20"
              ><path
                fill-rule="evenodd"
                d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"
                clip-rule="evenodd"></path></svg
            >
            Katy &amp; West Houston
          </a>
        </div>
      </div>
      <div id="estimate" class="lg:col-span-5 mt-12 lg:mt-0 scroll-mt-24">
        <JobberRequestCard
          title="Get a clear estimate"
          minHeight="480px"
          ctaLocation="home_hero_card"
          class="shadow-2xl ring-1 ring-black/10"
        />
      </div>
    </div>
  </div>
</section>
