---
import Section from '../../ui/Section.astro';
import SectionHeading from '../../ui/SectionHeading.astro';
import ServicePathwayCard from './ServicePathwayCard.astro';
import {
  additionalTimeLabel,
  formatUsd,
  smallRepairPricing,
} from '../../../data/smallRepairPricing';
import { pathwayCopy, smallRepairVisitMeta } from '../../../data/smallRepairVisitContent';
import {
  jobberHandymanToDoListFormUrl,
  jobberProjectEstimateFormUrl,
} from '../../../data/business';

const toDoListBookUrl = jobberHandymanToDoListFormUrl() ?? smallRepairVisitMeta.path;
const customProjectUrl = jobberProjectEstimateFormUrl() ?? '/contact/';

type Pathway = {
  title: string;
  price: string;
  bestFor: string;
  description: string;
  features: string[];
  ctaLabel: string;
  ctaHref: string;
  ctaExternal?: boolean;
  secondaryCtaLabel?: string;
  secondaryCtaHref?: string;
  analyticsId: string;
  featured: boolean;
  orderClass: string;
};

const pathways: Pathway[] = [
  {
    title: 'Free Photo Estimate',
    price: 'Free',
    bestFor:
      'Work that can be assessed from clear photographs, measurements, product details, and a written description',
    description:
      'EYS reviews the information and confirms whether an on-site assessment is needed before a final scope can be prepared.',
    features: [
      'Submit project details and photographs',
      'Reviewed before scope is finalized',
      'No obligation to proceed',
      'On-site assessment when necessary',
    ],
    ctaLabel: 'Request a Free Photo Estimate',
    ctaHref: '#estimate',
    analyticsId: 'photo-estimate',
    featured: false,
    orderClass: 'order-1 md:order-1',
  },
  {
    title: 'Handyman To-Do List Visit',
    price: `Starting at ${formatUsd(smallRepairPricing.oneHour)}`,
    bestFor:
      'Several smaller repairs, installations, and maintenance tasks completed in priority order during one reserved visit',
    description:
      'Materials, specialty equipment, and completion beyond the booked time are handled according to the published visit terms.',
    features: [
      `One-hour visit: ${formatUsd(smallRepairPricing.oneHour)}`,
      `Two-hour visit: ${formatUsd(smallRepairPricing.twoHours)}`,
      `Additional time: ${additionalTimeLabel}`,
      'Tasks completed in priority order',
      'Materials and specialty equipment are additional',
    ],
    ctaLabel: 'Book a Handyman To-Do List Visit',
    ctaHref: toDoListBookUrl,
    ctaExternal: toDoListBookUrl.startsWith('http'),
    secondaryCtaLabel: 'See visit details',
    secondaryCtaHref: smallRepairVisitMeta.path,
    analyticsId: 'handyman-to-do-list',
    featured: false,
    orderClass: 'order-3 md:order-3',
  },
  {
    title: 'Custom Project Estimate',
    price: 'Custom Estimate',
    bestFor:
      'Custom carpentry, feature walls, larger repairs, coordinated room upgrades, material planning, or work expected to require multiple visits',
    description:
      'We review the scope, discuss constraints and materials, and prepare a tailored estimate for work that needs deeper planning or more than one visit.',
    features: [
      'Detailed scope review',
      'Written project estimate',
      'Material planning and sourcing',
      'Multi-day scheduling when required',
    ],
    ctaLabel: 'Discuss Your Custom Project',
    ctaHref: customProjectUrl,
    ctaExternal: customProjectUrl.startsWith('http'),
    analyticsId: 'custom-project',
    featured: true,
    orderClass: 'order-2 md:order-2',
  },
];
---

<Section tone="light" width="wide" spacing="lg" id="service-pathways" labelledby="pathways-heading">
  <div class="lg:flex lg:items-end lg:justify-between lg:gap-12 mb-10 md:mb-14">
    <SectionHeading
      eyebrow={pathwayCopy.eyebrow}
      title={pathwayCopy.title}
      intro={pathwayCopy.intro}
      id="pathways-heading"
      class="mb-0 md:mb-0 max-w-2xl"
    />
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-5 lg:gap-6 items-stretch">
    {
      pathways.map((pathway) => (
        <ServicePathwayCard
          title={pathway.title}
          price={pathway.price}
          bestFor={pathway.bestFor}
          description={pathway.description}
          features={pathway.features}
          ctaLabel={pathway.ctaLabel}
          ctaHref={pathway.ctaHref}
          ctaExternal={pathway.ctaExternal}
          secondaryCtaLabel={pathway.secondaryCtaLabel}
          secondaryCtaHref={pathway.secondaryCtaHref}
          featured={pathway.featured}
          analyticsId={pathway.analyticsId}
          orderClass={pathway.orderClass}
        />
      ))
    }
  </div>

  <p class="mt-8 text-center text-sm text-gray-500 max-w-2xl mx-auto">
    Additional time after two hours requires your approval. Completion of every submitted task is not
    guaranteed within the reserved visit length.
  </p>
</Section>

<script>
  import { analyticsEvents, trackEvent } from '../../../utils/analytics';

  document.querySelectorAll<HTMLAnchorElement>('[data-pathway-cta]').forEach((link) => {
    link.addEventListener('click', () => {
      const id = link.getAttribute('data-pathway-cta') || 'unknown';
      trackEvent(analyticsEvents.pathwayCtaClick, {
        pathway_id: id,
        link_text: link.textContent?.trim() || '',
      });
    });
  });
</script>
