---
import { mediaWallFaqs } from '../../data/mediaWalls';
import MediaWallEstimateLink from './MediaWallEstimateLink.astro';

const faqs = mediaWallFaqs();
---

<section
  class="bg-brand-lightbg px-4 py-12 sm:px-6 sm:py-16 lg:px-8"
  aria-labelledby="media-wall-faq-heading"
>
  <div class="mx-auto max-w-3xl">
    <h2
      id="media-wall-faq-heading"
      class="eys-h2 text-eys-ink"
    >
      Frequently Asked Questions
    </h2>

    <div class="mt-8 space-y-3">
      {
        faqs.map((faq) => (
          <details class="eys-faq-item group">
            <summary class="eys-text-link flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-5 text-left font-display text-[17px] leading-6 text-eys-ink [text-wrap:balance] lg:px-7 lg:py-6 lg:text-lg">
              <span>{faq.question}</span>
              <span class="eys-faq-plus" aria-hidden="true">+</span>
            </summary>
            <p class="eys-body px-5 pb-6 text-eys-ink-2 lg:px-7 lg:pb-7">{faq.answer}</p>
          </details>
        ))
      }
    </div>

    <p class="mt-6 text-sm text-brand-muted">
      Ready to start?
      <MediaWallEstimateLink placement="faq" variant="text" class="ml-1">
        Request a Media Wall Estimate →
      </MediaWallEstimateLink>
    </p>
  </div>
</section>
