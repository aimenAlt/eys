---
import { mediaWallFaqs } from '../../data/mediaWalls';
import MediaWallEstimateLink from './MediaWallEstimateLink.astro';

const faqs = mediaWallFaqs();
---

<section
  class="bg-brand-lightbg px-4 py-12 sm:px-6 sm:py-16 lg:px-8"
  aria-labelledby="media-wall-faq-heading"
>
  <div class="mx-auto max-w-3xl">
    <h2
      id="media-wall-faq-heading"
      class="text-2xl font-bold tracking-tight text-brand-black sm:text-3xl"
    >
      Frequently Asked Questions
    </h2>

    <div class="mt-8 divide-y divide-brand-line border-y border-brand-line">
      {
        faqs.map((faq) => (
          <details class="group py-4">
            <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 text-left text-base font-bold text-brand-black">
              <span>{faq.question}</span>
              <span
                class="shrink-0 text-brand-red transition-transform group-open:rotate-45"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-brand-muted sm:text-base">{faq.answer}</p>
          </details>
        ))
      }
    </div>

    <p class="mt-6 text-sm text-brand-muted">
      Ready to start?
      <MediaWallEstimateLink placement="faq" variant="text" class="ml-1">
        Request a Media Wall Estimate →
      </MediaWallEstimateLink>
    </p>
  </div>
</section>
