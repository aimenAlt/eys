---
/** In-view muted autoplay for landing videos (no controls). */
---

<script>
  import { analyticsEvents, trackEvent } from '../../utils/analytics';

  function prefersReducedMotion(): boolean {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function wireInViewVideos(): void {
    const sections = document.querySelectorAll<HTMLElement>(
      '[data-eys-autoplay-video], [data-media-wall-video-section]',
    );
    sections.forEach((section) => {
      if (section.dataset.wired === '1') return;
      section.dataset.wired = '1';

      const video = section.querySelector<HTMLVideoElement>(
        '[data-eys-autoplay-video-el], [data-media-wall-video]',
      );
      if (!video) return;
      const source = video.querySelector<HTMLSourceElement>('source[data-src]');
      let viewed = false;
      const sourcePage = section.dataset.videoSourcePage || 'media_walls';
      /**
       * `mediaWallCrossSellView` measures a media wall being surfaced to
       * someone who came for something else. A section that opts out still
       * autoplays and still pauses off-screen — it just does not report a
       * cross-sell, which the media walls page's own hero is not.
       */
      const tracksCrossSell = !('noCrossSellEvent' in section.dataset);

      const markView = () => {
        if (!tracksCrossSell || viewed) return;
        viewed = true;
        trackEvent(analyticsEvents.mediaWallCrossSellView, {
          source_page: sourcePage,
          cross_sell: 'media_wall',
          placement: section.id || 'video_section',
        });
      };

      const loadSource = () => {
        if (!(source instanceof HTMLSourceElement) || source.src) return;
        const src = source.dataset.src;
        if (!src) return;
        source.src = src;
        video.load();
      };

      /**
       * Start playback, retrying once the element is actually ready.
       *
       * `video.load()` aborts a play() issued in the same tick, and with
       * preload="none" nothing buffers until a play request succeeds — so
       * waiting on 'canplay' alone would wait forever. A video scrolled into
       * view survived this because scrolling generates repeat intersection
       * callbacks; one already on screen at load (the hero) gets exactly one,
       * so without a retry it sits frozen on its poster.
       *
       * rAF handles the common case and conveniently defers while the tab is
       * hidden; 'canplay' is the backstop for when the fetch is simply slower
       * than a frame.
       */
      const playIfAllowed = async () => {
        if (prefersReducedMotion()) return;
        loadSource();
        video.muted = true;

        const attempt = () => video.play().catch(() => false);
        if ((await attempt()) !== false) return;

        requestAnimationFrame(async () => {
          if ((await attempt()) !== false) return;
          video.addEventListener('canplay', () => void attempt(), { once: true });
        });
      };

      if ('IntersectionObserver' in window) {
        new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting && entry.intersectionRatio >= 0.3) {
                markView();
                void playIfAllowed();
              } else {
                video.pause();
              }
            }
          },
          { threshold: [0, 0.3, 0.6] },
        ).observe(section);
      } else {
        markView();
      }
    });
  }

  wireInViewVideos();
  document.addEventListener('astro:page-load', wireInViewVideos);
</script>
