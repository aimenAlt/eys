---
import { mediaWallsLanding } from '../../data/mediaWalls';

const { eysProvides, youProvide } = mediaWallsLanding.included;
---

<section
  class="bg-brand-lightbg px-4 py-12 sm:px-6 sm:py-16 lg:px-8"
  aria-labelledby="media-wall-included-heading"
>
  <div class="mx-auto max-w-6xl">
    <h2
      id="media-wall-included-heading"
      class="text-2xl font-bold tracking-tight text-brand-black sm:text-3xl"
    >
      What’s Included
    </h2>
    <p class="mt-3 max-w-2xl text-base leading-relaxed text-brand-muted">
      Media walls are custom projects. Scope is confirmed in your estimate before work begins.
    </p>

    <div class="mt-8 grid gap-4 md:grid-cols-2">
      <div class="rounded-xl border border-brand-line bg-white p-6">
        <h3 class="text-lg font-bold text-brand-black">EYS Provides</h3>
        <ul class="mt-4 space-y-3 text-sm leading-relaxed text-brand-charcoal sm:text-base">
          {
            eysProvides.map((item) => (
              <li class="flex gap-3">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-red" aria-hidden="true" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="rounded-xl border border-brand-line bg-white p-6">
        <h3 class="text-lg font-bold text-brand-black">You Provide</h3>
        <ul class="mt-4 space-y-3 text-sm leading-relaxed text-brand-charcoal sm:text-base">
          {
            youProvide.map((item) => (
              <li class="flex gap-3">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-red" aria-hidden="true" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
