---
import MediaWallEstimateLink from './MediaWallEstimateLink.astro';
---

<div
  id="media-wall-sticky-bar"
  class="pointer-events-none fixed inset-x-0 bottom-0 z-40 translate-y-full opacity-0 transition-all duration-300 md:hidden"
  role="region"
  aria-label="Request a media wall estimate"
  data-media-wall-sticky
  hidden
>
  <div
    class="pointer-events-auto border-t border-brand-line bg-white px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] shadow-[0_-8px_24px_-12px_rgba(10,10,10,0.25)]"
  >
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-3">
      <div class="min-w-0">
        <p class="truncate text-sm font-bold text-brand-black">Custom Media Wall</p>
        <p class="text-xs text-brand-muted">Request an estimate</p>
      </div>
      <MediaWallEstimateLink placement="sticky_mobile" variant="sticky">
        Estimate
      </MediaWallEstimateLink>
    </div>
  </div>
</div>

<script>
  function initMediaWallStickyBar() {
    const bar = document.querySelector<HTMLElement>('[data-media-wall-sticky]');
    const heroCta = document.querySelector<HTMLElement>('[data-media-wall-hero-cta]');
    const footer = document.querySelector<HTMLElement>('[data-media-wall-footer]');
    if (!bar || !heroCta) return;

    let heroPassed = false;
    let footerVisible = false;

    const sync = () => {
      const show = heroPassed && !footerVisible;
      bar.hidden = !show;
      bar.classList.toggle('translate-y-full', !show);
      bar.classList.toggle('opacity-0', !show);
      bar.classList.toggle('pointer-events-none', !show);
      document.body.classList.toggle('media-wall-sticky-pad', show);
    };

    new IntersectionObserver(
      ([entry]) => {
        heroPassed = !entry.isIntersecting && entry.boundingClientRect.top < 0;
        sync();
      },
      { threshold: 0 },
    ).observe(heroCta);

    if (footer) {
      new IntersectionObserver(
        ([entry]) => {
          footerVisible = entry.isIntersecting;
          sync();
        },
        { threshold: 0 },
      ).observe(footer);
    }
  }

  initMediaWallStickyBar();
  document.addEventListener('astro:page-load', initMediaWallStickyBar);
</script>

<style is:global>
  @media (max-width: 767px) {
    body.media-wall-sticky-pad {
      padding-bottom: calc(4.75rem + env(safe-area-inset-bottom));
    }
  }
</style>
