---
import { mediaWallsLanding } from '../../data/mediaWalls';
import MediaWallEstimateLink from './MediaWallEstimateLink.astro';

/**
 * The video stands alone. A marble/wood-slat still used to sit beside it, but
 * that build now has its own card in the portfolio grid and the project folder
 * holds no second photo to swap in — so showing it twice was the weaker option.
 */
const video = mediaWallsLanding.images.videos.builtIn;
---

<section
  id="built-in-media-walls"
  class="bg-brand-black px-4 py-12 text-white sm:px-6 sm:py-14 lg:px-8"
  aria-labelledby="media-wall-builtin-heading"
  data-media-wall-video-section
>
  <div class="mx-auto grid max-w-6xl gap-8 lg:grid-cols-12 lg:items-center lg:gap-10">
    <div class="lg:col-span-5">
      <p class="text-[11px] font-bold uppercase tracking-[0.16em] text-brand-redondark sm:text-xs">
        Featured Project
      </p>
      <h2
        id="media-wall-builtin-heading"
        class="mt-3 text-2xl font-bold tracking-tight sm:text-3xl"
      >
        Custom Built-In Media Walls
      </h2>
      <p class="mt-3 max-w-md text-base leading-relaxed text-white/80">
        Floor-to-ceiling built-ins with recessed TV placement, integrated fireplaces, and lit
        display niches — finished to look architectural, not bolted on.
      </p>
      <div class="mt-7">
        <MediaWallEstimateLink placement="video_builtin" variant="primaryOnDark">
          Request a Media Wall Estimate
        </MediaWallEstimateLink>
      </div>
    </div>

    <div class="lg:col-span-7">
      <figure class="relative mx-auto w-full max-w-sm overflow-hidden rounded-xl bg-white/5 shadow-card ring-1 ring-white/10 lg:max-w-md">
        <video
          class="aspect-[3/4] h-auto w-full object-cover"
          data-media-wall-video
          poster={video.poster}
          width={video.width}
          height={video.height}
          muted
          loop
          playsinline
          preload="none"
          disablepictureinpicture
          aria-label={video.label}
        >
          <source data-src={video.src} type="video/mp4" />
        </video>
        <figcaption class="sr-only">{video.label}</figcaption>
      </figure>
    </div>
  </div>
</section>
