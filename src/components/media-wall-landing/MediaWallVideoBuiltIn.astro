---
import SiteImage from '../ui/SiteImage.astro';
import { mediaWallsLanding } from '../../data/mediaWalls';
import { imageOrPlaceholder } from '../../data/images';
import MediaWallEstimateLink from './MediaWallEstimateLink.astro';

/**
 * Shows the lit-shelves still, which used to lead the page. The hero now opens
 * with the built-in video instead — footage of a finished wall sells the work
 * harder than a photograph — so the two simply traded places.
 */
const still = mediaWallsLanding.images.hero;
const stillSrc = imageOrPlaceholder(still.src);
---

<section
  id="built-in-media-walls"
  class="bg-brand-black px-4 py-12 text-white sm:px-6 sm:py-14 lg:px-8"
  aria-labelledby="media-wall-builtin-heading"
>
  <div class="mx-auto grid max-w-6xl gap-8 lg:grid-cols-12 lg:items-center lg:gap-10">
    <div class="lg:col-span-5">
      <p class="text-[11px] font-bold uppercase tracking-[0.16em] text-brand-redondark sm:text-xs">
        Featured Project
      </p>
      <h2
        id="media-wall-builtin-heading"
        class="mt-3 text-2xl font-bold tracking-tight sm:text-3xl"
      >
        Custom Built-In Media Walls
      </h2>
      <p class="mt-3 max-w-md text-base leading-relaxed text-white/80">
        Floor-to-ceiling built-ins with recessed TV placement, integrated fireplaces, and lit
        display niches — finished to look architectural, not bolted on.
      </p>
      <div class="mt-7">
        <MediaWallEstimateLink placement="video_builtin" variant="primaryOnDark">
          Request a Media Wall Estimate
        </MediaWallEstimateLink>
      </div>
    </div>

    <div class="lg:col-span-7">
      <figure class="relative mx-auto w-full max-w-sm overflow-hidden rounded-xl shadow-card lg:max-w-md">
        <SiteImage
          src={stillSrc}
          alt={still.alt}
          width={still.width}
          height={still.height}
          loading="lazy"
          sizes="(max-width: 640px) 100vw, 448px"
          class="aspect-[3/4] w-full object-cover"
        />
        <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/75 to-transparent px-4 pb-4 pt-12 text-sm font-bold text-white">
          {still.label}
        </figcaption>
      </figure>
    </div>
  </div>
</section>
