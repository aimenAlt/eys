---
import SiteImage from '../ui/SiteImage.astro';
import { mediaWallsLanding } from '../../data/mediaWalls';
import { imageOrPlaceholder } from '../../data/images';
import MediaWallEstimateLink from './MediaWallEstimateLink.astro';

const video = mediaWallsLanding.images.videos.builtIn;
/** Supporting texture shot — not the same wall as the portrait video. */
const still = {
  src: imageOrPlaceholder('/images/services/media-walls/marble-wood-slat.jpg'),
  alt: 'Floor-to-ceiling marble-look tile feature wall flanked by dark vertical wood slats',
  width: 1200,
  height: 1600,
  label: 'Marble & Wood-Slat Feature Wall',
};
---

<section
  id="built-in-media-walls"
  class="bg-brand-black px-4 py-12 text-white sm:px-6 sm:py-14 lg:px-8"
  aria-labelledby="media-wall-builtin-heading"
  data-media-wall-video-section
>
  <div class="mx-auto grid max-w-6xl gap-8 lg:grid-cols-12 lg:items-center lg:gap-10">
    <div class="lg:col-span-5">
      <p class="text-[11px] font-bold uppercase tracking-[0.16em] text-brand-redondark sm:text-xs">
        Featured Project
      </p>
      <h2
        id="media-wall-builtin-heading"
        class="mt-3 text-2xl font-bold tracking-tight sm:text-3xl"
      >
        Custom Built-In Media Walls
      </h2>
      <p class="mt-3 max-w-md text-base leading-relaxed text-white/80">
        Floor-to-ceiling built-ins with recessed TV placement, integrated fireplaces, and lit
        display niches — finished to look architectural, not bolted on.
      </p>
      <div class="mt-7">
        <MediaWallEstimateLink placement="video_builtin" variant="primaryOnDark">
          Request a Media Wall Estimate
        </MediaWallEstimateLink>
      </div>
    </div>

    <div class="grid grid-cols-2 items-stretch gap-3 sm:gap-4 lg:col-span-7">
      <figure class="relative col-span-2 overflow-hidden rounded-xl bg-white/5 shadow-card ring-1 ring-white/10 sm:col-span-1 sm:col-start-1">
        <video
          class="aspect-[3/4] h-auto w-full object-cover"
          data-media-wall-video
          poster={video.poster}
          width={video.width}
          height={video.height}
          muted
          loop
          playsinline
          preload="none"
          disablepictureinpicture
          aria-label={video.label}
        >
          <source data-src={video.src} type="video/mp4" />
        </video>
        <figcaption class="sr-only">{video.label}</figcaption>
      </figure>
      <figure class="relative hidden overflow-hidden rounded-xl shadow-card sm:block">
        <SiteImage
          src={still.src}
          alt={still.alt}
          width={still.width}
          height={still.height}
          loading="lazy"
          sizes="(max-width: 1024px) 50vw, 28vw"
          class="aspect-[3/4] h-full w-full object-cover"
        />
        <figcaption
          class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 via-black/35 to-transparent px-3 pb-3 pt-12 text-xs font-bold text-white sm:text-sm"
        >
          {still.label}
        </figcaption>
      </figure>
    </div>
  </div>
</section>
