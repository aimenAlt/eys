---
import { mediaWallsLanding } from '../../data/mediaWalls';

const reasons = mediaWallsLanding.why;
---

<section
  class="bg-white px-4 py-12 sm:px-6 sm:py-16 lg:px-8"
  aria-labelledby="media-wall-why-heading"
>
  <div class="mx-auto max-w-6xl">
    <h2
      id="media-wall-why-heading"
      class="text-2xl font-bold tracking-tight text-brand-black sm:text-3xl"
    >
      Why Homeowners Choose EYS
    </h2>
    <p class="mt-3 text-lg font-bold text-brand-black">Done Right. From Start to Finish.</p>

    <ul class="mt-8 grid gap-3 sm:grid-cols-2">
      {
        reasons.map((reason) => (
          <li class="flex gap-3 rounded-lg border border-brand-line bg-brand-lightbg px-4 py-3.5 text-sm font-bold text-brand-black sm:text-base">
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-red" aria-hidden="true" />
            <span>{reason}</span>
          </li>
        ))
      }
    </ul>

    <p class="mt-6 text-sm text-gray-600 sm:text-base">
      A media wall is a multi-trade build — carpentry, drywall finishing, and a
      licensed electrician for power behind the display. We run all of it under
      one estimate and one point of contact. See how
      <a
        href="/services/whole-project-remodeling/"
        class="font-semibold text-brand-red hover:underline">whole-project remodeling</a
      > works.
    </p>
  </div>
</section>
