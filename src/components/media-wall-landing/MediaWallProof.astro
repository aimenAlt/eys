---
import SiteImage from '../ui/SiteImage.astro';
import { mediaWallsLanding } from '../../data/mediaWalls';
import { imageOrPlaceholder } from '../../data/images';
import MediaWallEstimateLink from './MediaWallEstimateLink.astro';

const proof = mediaWallsLanding.images.proof.map((image) => ({
  ...image,
  src: imageOrPlaceholder(image.src),
}));
const [lead, second] = proof;
---

<section
  class="bg-brand-lightbg px-4 py-12 sm:px-6 sm:py-16 lg:px-8"
  aria-labelledby="media-wall-proof-heading"
>
  <div class="mx-auto max-w-6xl">
    <div class="max-w-2xl">
      <h2
        id="media-wall-proof-heading"
        class="text-2xl font-bold tracking-tight text-brand-black sm:text-3xl"
      >
        Real Media Walls. Real Homes.
      </h2>
      <p class="mt-3 text-base leading-relaxed text-brand-muted sm:text-lg">
        Custom built-ins, fireplace TV walls, and wood-slat features from Elevate Your Space — not
        stock photos.
      </p>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-12 lg:grid-rows-2 lg:gap-5">
      {
        lead ? (
          <figure class="relative h-full overflow-hidden rounded-xl shadow-card sm:col-span-2 lg:col-span-7 lg:row-span-2">
            <SiteImage
              src={lead.src}
              alt={lead.alt}
              width={lead.width}
              height={lead.height}
              loading="lazy"
              sizes="(max-width: 1024px) 100vw, 58vw"
              class="aspect-[4/5] w-full object-cover sm:aspect-[16/10] lg:absolute lg:inset-0 lg:h-full lg:w-full"
            />
            <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent px-4 pb-4 pt-16 text-sm font-bold text-white">
              {lead.label}
            </figcaption>
          </figure>
        ) : null
      }
      {
        second ? (
          <figure class="relative overflow-hidden rounded-xl shadow-card lg:col-span-5 lg:row-span-2">
            <SiteImage
              src={second.src}
              alt={second.alt}
              width={second.width}
              height={second.height}
              loading="lazy"
              sizes="(max-width: 1024px) 50vw, 36vw"
              class="aspect-[4/5] w-full object-cover lg:absolute lg:inset-0 lg:h-full lg:w-full"
            />
            <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent px-4 pb-4 pt-14 text-sm font-bold text-white">
              {second.label}
            </figcaption>
          </figure>
        ) : null
      }
    </div>

    <div class="mt-8">
      <MediaWallEstimateLink placement="proof">
        Request a Media Wall Estimate
      </MediaWallEstimateLink>
    </div>
  </div>
</section>
