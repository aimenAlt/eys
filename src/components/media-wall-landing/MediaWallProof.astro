---
import SiteImage from '../ui/SiteImage.astro';
import { mediaWallsLanding } from '../../data/mediaWalls';
import { imageOrPlaceholder } from '../../data/images';
import MediaWallEstimateLink from './MediaWallEstimateLink.astro';

const [lead] = mediaWallsLanding.images.proof.map((image) => ({
  ...image,
  src: imageOrPlaceholder(image.src),
}));
---

<section
  class="bg-brand-lightbg px-4 py-12 sm:px-6 sm:py-16 lg:px-8"
  aria-labelledby="media-wall-proof-heading"
>
  <div class="mx-auto grid max-w-6xl gap-8 lg:grid-cols-12 lg:items-center lg:gap-10">
    <div class="lg:col-span-5">
      <h2
        id="media-wall-proof-heading"
        class="text-2xl font-bold tracking-tight text-brand-black sm:text-3xl"
      >
        Real Built-Ins. Real Katy Homes.
      </h2>
      <p class="mt-3 text-base leading-relaxed text-brand-muted sm:text-lg">
        Custom built-ins, fireplace TV walls, and wood-slat features from Elevate Your Space — not
        stock photos.
      </p>
      <div class="mt-7">
        <MediaWallEstimateLink placement="proof">
          Send photos for a media wall estimate
        </MediaWallEstimateLink>
      </div>
    </div>

    {
      lead ? (
        <figure class="relative mx-auto w-full max-w-sm overflow-hidden rounded-xl shadow-card lg:col-span-7 lg:max-w-md">
          <SiteImage
            src={lead.src}
            alt={lead.alt}
            width={lead.width}
            height={lead.height}
            loading="lazy"
            sizes="(max-width: 640px) 100vw, 448px"
            class="aspect-[3/4] w-full object-cover"
          />
          <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent px-4 pb-4 pt-16 text-sm font-bold text-white">
            {lead.label}
          </figcaption>
        </figure>
      ) : null
    }
  </div>
</section>
