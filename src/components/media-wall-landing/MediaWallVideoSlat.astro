---
import { mediaWallsLanding } from '../../data/mediaWalls';
import MediaWallEstimateLink from './MediaWallEstimateLink.astro';

const video = mediaWallsLanding.images.videos.slat;
---

<section
  id="slat-walls-tv-integration"
  class="bg-brand-lightbg px-4 py-12 sm:px-6 sm:py-14 lg:px-8"
  aria-labelledby="media-wall-slat-heading"
  data-media-wall-video-section
>
  <div class="mx-auto grid max-w-6xl gap-8 lg:grid-cols-12 lg:items-center lg:gap-10">
    <div class="lg:col-span-4">
      <p class="text-[11px] font-bold uppercase tracking-[0.16em] text-brand-red sm:text-xs">
        Featured Project
      </p>
      <h2
        id="media-wall-slat-heading"
        class="mt-3 text-2xl font-bold tracking-tight text-brand-black sm:text-3xl"
      >
        Slat Walls &amp; TV Integration
      </h2>
      <p class="mt-3 text-base leading-relaxed text-brand-muted">
        Dark wood-slat feature walls, clean TV mounting with LED backlighting, and floating consoles
        that keep the entertainment wall sharp and intentional.
      </p>
      <div class="mt-7">
        <MediaWallEstimateLink placement="video_slat">
          Request a Media Wall Estimate
        </MediaWallEstimateLink>
      </div>
    </div>

    <figure class="relative overflow-hidden rounded-xl bg-brand-black/5 shadow-card lg:col-span-8">
      <video
        class="aspect-video h-auto w-full object-cover"
        data-media-wall-video
        poster={video.poster}
        width={video.width}
        height={video.height}
        muted
        loop
        playsinline
        preload="none"
        disablepictureinpicture
        aria-label={video.label}
      >
        <source data-src={video.src} type="video/mp4" />
      </video>
      <figcaption class="sr-only">{video.label}</figcaption>
    </figure>
  </div>
</section>
