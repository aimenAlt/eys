---
import { contentMaxClass, contentPaddingClass } from '../../data/layout';
import { jobberProjectEstimateFormUrl, site } from '../../data/business';

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  /**
   * Optional estimate + call row under the description (backlog 009). No
   * default: pages that do not pass it render exactly as before.
   */
  ctas?: { formLocation: string; callLocation: string };
}

const { eyebrow, title, description, ctas } = Astro.props;
const estimateUrl = jobberProjectEstimateFormUrl() ?? '/contact/';
---

<section class="bg-brand-lightbg border-b border-neutral-200">
  <div class:list={['mx-auto', contentMaxClass, contentPaddingClass, 'py-10 md:py-12']}>
    {
      eyebrow && (
        <p class="text-brand-red font-bold text-sm tracking-widest uppercase mb-2">
          {eyebrow}
        </p>
      )
    }
    <h1 class="text-4xl md:text-5xl font-extrabold text-brand-black mb-4">{title}</h1>
    {description && <p class="text-lg text-neutral-600 max-w-3xl">{description}</p>}
    {
      ctas && (
        <div class="mt-6 flex flex-col sm:flex-row gap-3" data-sticky-hero-cta>
          <a
            href={estimateUrl}
            data-booking-type="project_estimate"
            data-cta-location={ctas.formLocation}
            class="inline-flex justify-center items-center bg-brand-red text-white px-6 py-3 rounded-md font-bold hover:bg-brand-redhover transition-colors"
          >
            Send photos for a free estimate
          </a>
          <a
            href={`tel:${site.phoneTel}`}
            data-cta-location={ctas.callLocation}
            class="inline-flex justify-center items-center border-2 border-brand-black text-brand-black px-6 py-3 rounded-md font-bold hover:bg-brand-black hover:text-white transition-colors"
          >
            Call {site.phone}
          </a>
        </div>
      )
    }
  </div>
</section>
