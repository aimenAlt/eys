---
/**
 * Mid-content conversion band for the long stretch between a page's hero CTAs
 * and its closing `LocalAreaCTA`. Deliberately a bordered light panel rather
 * than a second full-bleed black slab, so it reads as a step inside the page
 * instead of a duplicate of the end-of-page CTA.
 *
 * `embedded` drops the outer width/padding wrapper for placement inside an
 * already-constrained stack such as `LocalLandingShell`.
 */
import { jobberProjectEstimateFormUrl, site } from '../../data/business';
import { contentMaxClass, contentPaddingClass } from '../../data/layout';

interface Props {
  locationName?: string;
  ctaLocation: string;
  heading?: string;
  embedded?: boolean;
}

const { locationName, ctaLocation, heading, embedded = false } = Astro.props;

const estimateUrl = jobberProjectEstimateFormUrl() ?? '/contact/';
const title =
  heading ??
  (locationName ? `Have a project in ${locationName}?` : 'Have a project in mind?');
const body = locationName
  ? `Send photos and your list. We scope the work and return an itemized estimate for ${locationName}.`
  : 'Send photos and your list. We scope the work and return an itemized estimate.';
---

<section
  class:list={embedded ? [] : ['bg-white py-10 md:py-12']}
  aria-labelledby={`inline-estimate-${ctaLocation}`}
>
  <div class:list={embedded ? [] : ['mx-auto', contentMaxClass, contentPaddingClass]}>
    <div class="eys-page-hero eys-on-dark rounded-[14px] p-6 md:p-10">
      <div class="flex flex-col gap-5 md:flex-row md:items-center md:justify-between md:gap-8">
        <div>
          <h2
            id={`inline-estimate-${ctaLocation}`}
            class="eys-h2-sm mb-2 text-white"
          >
            {title}
          </h2>
          <p class="eys-body text-eys-on-dark-2">{body}</p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 md:flex-shrink-0">
          <a
            href={estimateUrl}
            data-booking-type="project_estimate"
            data-cta-location={ctaLocation}
            class="eys-hero-btn eys-hero-btn--red"
          >
            Request an Estimate
          </a>
          <a
            href={`tel:${site.phoneTel}`}
            data-cta-location={ctaLocation}
            class="eys-hero-btn eys-hero-btn--outline"
          >
            Call {site.phone}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
