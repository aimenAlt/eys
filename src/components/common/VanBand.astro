---
/**
 * VanBand — Eyad Essa in front of the EYS van, the first thing inside <main>
 * on the homepage (old variant only) and on every Google Ads landing page
 * (`src/data/adsLandingPages.ts`). Backlog 011.
 *
 * A slim intro strip on every screen (Aimen, 26 Oct 2026: the van must not
 * take the first screen; the hero and its video come first): the photo small
 * at its natural 3:2 (132×88 on phone, 180×120 from 1024px) beside the owner
 * lines (no heading tags, so each page's H1 stays its first heading). Nothing
 * here is a link or a button.
 *
 * Never crop, cover-fit, blur or overlay the photo: every letter and badge on
 * the van stays visible.
 */
import SiteImage from '../ui/SiteImage.astro';
import { vanEyadPhoto } from '../../data/images';

interface Props {
  /** The page hero's container width: max-w-6xl on own-chrome pages, max-w-7xl on ContentLayout pages and "/". */
  container?: '6xl' | '7xl';
}

const { container = '7xl' } = Astro.props;
/**
 * Match the hero's own box model so the photo lines up with the H1: the
 * own-chrome heroes pad the section and centre a max-w-6xl box inside it;
 * ContentLayout pages and "/" pad inside a max-w-7xl box.
 */
const sectionPad = container === '6xl' ? 'lg:px-8' : 'lg:px-0';
const innerClass = container === '6xl' ? 'lg:max-w-6xl' : 'lg:max-w-7xl lg:px-8';
---

<section
  aria-label="Who runs your project"
  data-analytics-section="van_band"
  class:list={['border-b border-white/10 bg-brand-black px-4 sm:px-6', sectionPad]}
>
  <div class:list={['mx-auto flex items-center gap-4 py-3 lg:gap-6 lg:py-4', innerClass]}>
    <!-- Own box: SiteImage's <picture> is display:contents, so its <source> would otherwise become an empty flex item and pick up the gap. -->
    <div class="shrink-0">
      <SiteImage
        src={vanEyadPhoto.src}
        alt={vanEyadPhoto.alt}
        width={vanEyadPhoto.width}
        height={vanEyadPhoto.height}
        loading="eager"
        sizes="(min-width: 1024px) 180px, 132px"
        class="block h-[88px] w-[132px] rounded-[6px] lg:h-[120px] lg:w-[180px]"
      />
    </div>
    <div class="min-w-0">
      <p class="eys-eyebrow eys-kicker whitespace-nowrap text-[10px] tracking-[0.1em] text-eys-on-dark-2 sm:text-[11px] sm:tracking-[0.16em]">Who runs your project</p>
      <p class="mt-1.5 text-[15px] font-bold leading-snug text-white lg:text-lg">Eyad Essa · Owner · U.S. military veteran</p>
      <p class="mt-0.5 hidden text-[15px] text-white/80 sm:block">Your one point of contact on every project.</p>
    </div>
  </div>
</section>
