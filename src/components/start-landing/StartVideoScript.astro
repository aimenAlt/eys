---
/**
 * Video wiring specific to `/start/`, deliberately kept out of the shared
 * MediaWallVideoScript because `/services/media-walls/` runs on that one.
 *
 * Two jobs the shared script does not cover:
 *
 * 1. The hero renders the same clip twice — full-bleed behind the copy on
 *    mobile, as a column figure on desktop — because the two breakpoints place
 *    it differently. Only the copy actually rendered is loaded and played, so
 *    the file is fetched once.
 * 2. StartVideoBuiltIn now shows a still instead of a video, and the shared
 *    script reports `mediaWallCrossSellView` only for sections that hold one.
 *    This keeps that placement reporting.
 *
 * The hero itself does not report a cross-sell: that event counts a media wall
 * surfaced to someone who came for something else, and a hero fires on
 * essentially every pageview, which would swamp the deeper placements.
 */
---

<script>
  import { analyticsEvents, trackEvent } from '../../utils/analytics';

  function prefersReducedMotion(): boolean {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function onInView(el: HTMLElement, onEnter: () => void, onLeave?: () => void): void {
    if (!('IntersectionObserver' in window)) {
      onEnter();
      return;
    }
    new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting && entry.intersectionRatio >= 0.3) onEnter();
          else onLeave?.();
        }
      },
      { threshold: [0, 0.3, 0.6] },
    ).observe(el);
  }

  /**
   * Start playback, retrying once the element is actually ready.
   *
   * `video.load()` aborts a play() issued in the same tick, and with
   * preload="none" nothing buffers until a play request succeeds — so waiting
   * on 'canplay' alone would wait forever. The hero is already on screen at
   * load and gets exactly one intersection callback, so without the retry it
   * would sit frozen on its poster.
   */
  async function play(video: HTMLVideoElement): Promise<void> {
    if (prefersReducedMotion()) return;
    // The copy hidden at this breakpoint has no box — never fetch it.
    if (video.getClientRects().length === 0) return;

    const source = video.querySelector<HTMLSourceElement>('source[data-src]');
    if (source && !source.src && source.dataset.src) {
      source.src = source.dataset.src;
      video.load();
    }
    video.muted = true;

    const attempt = () => video.play().catch(() => false);
    if ((await attempt()) !== false) return;

    requestAnimationFrame(async () => {
      if ((await attempt()) !== false) return;
      video.addEventListener('canplay', () => void attempt(), { once: true });
    });
  }

  function wireStartVideos(): void {
    const hero = document.querySelector<HTMLElement>('[data-start-hero-video]');
    if (hero && hero.dataset.startWired !== '1') {
      hero.dataset.startWired = '1';
      const videos = Array.from(hero.querySelectorAll<HTMLVideoElement>('video'));
      onInView(
        hero,
        () => videos.forEach((video) => void play(video)),
        () => videos.forEach((video) => video.pause()),
      );
    }

    document.querySelectorAll<HTMLElement>('[data-eys-autoplay-video]').forEach((section) => {
      if (section.querySelector('video')) return;
      if (section.dataset.startWired === '1') return;
      section.dataset.startWired = '1';

      let viewed = false;
      onInView(section, () => {
        if (viewed) return;
        viewed = true;
        trackEvent(analyticsEvents.mediaWallCrossSellView, {
          source_page: section.dataset.videoSourcePage || 'start',
          cross_sell: 'media_wall',
          placement: section.id || 'video_section',
        });
      });
    });
  }

  wireStartVideos();
  document.addEventListener('astro:page-load', wireStartVideos);
</script>
