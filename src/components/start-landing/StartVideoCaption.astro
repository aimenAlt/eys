---
import StartJobberLink from './StartJobberLink.astro';
import { withBase } from '../../utils/paths';

interface Props {
  label: string;
  placement: 'video_builtin' | 'video_slat';
}

const { label, placement } = Astro.props;

// The section's main button already reports the bare placement; the caption link
// reports a `_caption` variant so the two are not merged in GA4.
const captionPlacement =
  placement === 'video_builtin' ? 'video_builtin_caption' : 'video_slat_caption';
---

<div class="flex items-center gap-3 bg-brand-black px-4 py-3">
  <img
    src={withBase('/logos/logo-mark.webp')}
    alt=""
    width="28"
    height="36"
    class="h-9 w-auto shrink-0"
    loading="lazy"
    decoding="async"
  />
  <div class="min-w-0">
    <p class="truncate text-sm font-bold text-white">{label}</p>
    <StartJobberLink service="project_estimate" placement={captionPlacement} variant="caption">
      Request an Estimate
    </StartJobberLink>
  </div>
</div>
