---
const reasons = [
  'Veteran-owned and locally based in Katy',
  'Clear paths: book a visit or send photos for an estimate',
  'Real project photos and video from West Houston homes',
  'Online scheduling through Jobber',
  'Respect for your home — clean, careful completion',
  'From punch lists to remodeling, general contracting, media walls, and curtains',
] as const;
---

<section
  class="bg-white px-4 py-12 sm:px-6 sm:py-16 lg:px-8"
  aria-labelledby="start-why-heading"
>
  <div class="mx-auto max-w-6xl">
    <h2
      id="start-why-heading"
      class="text-2xl font-bold tracking-tight text-brand-black sm:text-3xl"
    >
      Why Homeowners Choose EYS
    </h2>
    <p class="mt-3 text-lg font-bold text-brand-black">Done Right. From Start to Finish.</p>

    <ul class="mt-8 grid gap-3 sm:grid-cols-2">
      {
        reasons.map((reason) => (
          <li class="flex gap-3 rounded-lg border border-brand-line bg-brand-lightbg px-4 py-3.5 text-sm font-bold text-brand-black sm:text-base">
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-red" aria-hidden="true" />
            <span>{reason}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
