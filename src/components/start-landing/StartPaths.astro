---
import SiteImage from '../ui/SiteImage.astro';
import CurtainBookLink from '../curtain-landing/CurtainBookLink.astro';
import MediaWallEstimateLink from '../media-wall-landing/MediaWallEstimateLink.astro';
import StartJobberLink from './StartJobberLink.astro';
import { imageOrPlaceholder } from '../../data/images';
import {
  curtainRodFromPrice,
  curtainTrackFromPrice,
  startAllServicesHref,
  startCurtainsHref,
  startLanding,
  startMediaWallsHref,
  startTodoListHref,
  todoListFromPrice,
} from '../../data/startLanding';
import { withBase } from '../../utils/paths';

const todoFrom = todoListFromPrice();
const rodFrom = curtainRodFromPrice();
const trackFrom = curtainTrackFromPrice();

const mediaWallVideo = startLanding.images.videos.slat;
const generalQuotePhoto = startLanding.images.pathCards.generalQuote;
const curtainPhoto = startLanding.images.pathCards.curtain;
const todoListPhoto = startLanding.images.pathCards.todoList;

/**
 * White cards on the white section only read as boxes with a real edge, so the
 * fill is white and the definition comes from the border plus `shadow-card`.
 */
const cardClass =
  'flex h-full flex-col overflow-hidden rounded-xl border border-brand-line bg-white shadow-card transition-shadow hover:shadow-cardhover';
const mediaClass = 'h-44 w-full object-cover sm:h-40';
const bodyClass = 'flex flex-1 flex-col p-5 sm:p-6';
const eyebrowClass = 'text-xs font-bold uppercase tracking-[0.12em] text-brand-muted';
const titleClass = 'mt-2 text-xl font-bold leading-snug text-brand-black sm:text-2xl';
const copyClass = 'mt-2 text-sm leading-relaxed text-brand-muted sm:text-base';
const priceClass = 'mt-3 text-lg font-bold text-brand-red';
const linkClass =
  'mt-3 inline-flex min-h-11 items-center text-sm font-bold text-brand-black underline-offset-4 hover:underline';
---

<section
  id="start-paths"
  class="scroll-mt-24 bg-white px-4 py-12 sm:px-6 sm:py-16 lg:px-8"
  aria-labelledby="start-paths-heading"
  data-cta-location="paths"
>
  <div class="mx-auto max-w-6xl">
    <div class="max-w-2xl">
      <h2
        id="start-paths-heading"
        class="text-2xl font-bold tracking-tight text-brand-black sm:text-3xl"
      >
        Choose How to Start
      </h2>
      <p class="mt-3 text-base leading-relaxed text-brand-muted sm:text-lg">
        Get a quote on any project, start a custom media wall, book high-ceiling curtain
        installation, or reserve a visit for a list of smaller tasks.
      </p>
    </div>

    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" role="list">
      <li>
        <article class={cardClass}>
          <SiteImage
            src={imageOrPlaceholder(generalQuotePhoto.src)}
            alt={generalQuotePhoto.alt}
            width={generalQuotePhoto.width}
            height={generalQuotePhoto.height}
            loading="lazy"
            sizes="(max-width: 640px) 100vw, 45vw"
            class={mediaClass}
          />
          <div class={bodyClass}>
            <p class={eyebrowClass}>Any project, any size</p>
            <h3 class={titleClass}>General Quote</h3>
            <p class={copyClass}>
              Not sure where your project fits? Send photos and a short description. We take on all
              types of jobs — repairs, upgrades, carpentry, remodeling, and one-off work that does
              not fit a category.
            </p>
            <div class="mt-auto pt-5">
              <StartJobberLink service="project_estimate" placement="paths" featured>
                Get a Free Quote
              </StartJobberLink>
              <a
                href={withBase(startAllServicesHref)}
                data-cta-id="start_path_detail_general"
                class={linkClass}
              >
                See everything we do →
              </a>
            </div>
          </div>
        </article>
      </li>

      <li>
        <article
          id="start-path-media-wall"
          class={cardClass}
          data-eys-autoplay-video
          data-video-source-page="start"
        >
          <video
            class={mediaClass}
            data-eys-autoplay-video-el
            poster={mediaWallVideo.poster}
            width={mediaWallVideo.width}
            height={mediaWallVideo.height}
            muted
            loop
            playsinline
            preload="none"
            disablepictureinpicture
            aria-label={mediaWallVideo.label}
          >
            <source data-src={mediaWallVideo.src} type="video/mp4" />
          </video>
          <div class={bodyClass}>
            <p class={eyebrowClass}>Custom build</p>
            <h3 class={titleClass}>Media Walls</h3>
            <p class={copyClass}>
              Custom media walls, fireplace TV walls, wood-slat feature walls, and finished
              entertainment centers — designed and built for your room.
            </p>
            <div class="mt-auto pt-5">
              <MediaWallEstimateLink placement="paths" class="w-full! py-3! sm:w-full!">
                Get a Media Wall Quote
              </MediaWallEstimateLink>
              <a
                href={withBase(startMediaWallsHref)}
                data-cta-id="start_path_detail_media_wall"
                class={linkClass}
              >
                See media wall projects →
              </a>
            </div>
          </div>
        </article>
      </li>

      <li>
        <article class={cardClass}>
          <SiteImage
            src={imageOrPlaceholder(curtainPhoto.src)}
            alt={curtainPhoto.alt}
            width={curtainPhoto.width}
            height={curtainPhoto.height}
            loading="lazy"
            sizes="(max-width: 640px) 100vw, 45vw"
            class={mediaClass}
          />
          <div class={bodyClass}>
            <p class={eyebrowClass}>Book it yourself</p>
            <h3 class={titleClass}>High-Ceiling Curtains</h3>
            <p class={copyClass}>
              Tall windows and two-story walls. You supply the rod or track and the curtains — we
              bring the high-ceiling access equipment and install them level and clean. Pick a
              time and you are booked, no waiting on a callback.
            </p>
            <p class={priceClass}>Rods installed from {rodFrom} · tracks from {trackFrom}</p>
            <div class="mt-auto pt-5">
              <CurtainBookLink placement="paths" class="w-full! py-3! sm:w-full!">
                Book a Curtain Install
              </CurtainBookLink>
              <a
                href={withBase(startCurtainsHref)}
                data-cta-id="start_path_detail_high_ceiling_curtains"
                class={linkClass}
              >
                See curtain pricing &amp; details →
              </a>
            </div>
          </div>
        </article>
      </li>

      <li>
        <article class={cardClass}>
          <SiteImage
            src={imageOrPlaceholder(todoListPhoto.src)}
            alt={todoListPhoto.alt}
            width={todoListPhoto.width}
            height={todoListPhoto.height}
            loading="lazy"
            sizes="(max-width: 640px) 100vw, 45vw"
            class={mediaClass}
          />
          <div class={bodyClass}>
            <p class={eyebrowClass}>Smaller tasks</p>
            <h3 class={titleClass}>Handyman To-Do List Visit</h3>
            <p class={copyClass}>
              Several smaller repairs, installations, and maintenance tasks in priority order during
              one reserved visit.
            </p>
            <p class={priceClass}>Starting at {todoFrom}</p>
            <div class="mt-auto pt-5">
              <StartJobberLink service="todo_list" placement="paths" featured>
                Book a Handyman Visit
              </StartJobberLink>
              <a
                href={withBase(startTodoListHref)}
                data-cta-id="start_path_detail_handyman_to_do_list"
                class={linkClass}
              >
                See what a visit covers →
              </a>
            </div>
          </div>
        </article>
      </li>
    </ul>
  </div>
</section>
