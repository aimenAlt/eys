---
import SiteImage from '../ui/SiteImage.astro';
import StartCallLink from './StartCallLink.astro';
import StartChooseLink from './StartChooseLink.astro';
import { site } from '../../data/business';
import { imageOrPlaceholder } from '../../data/images';
import { startLanding } from '../../data/startLanding';

/**
 * Closes on a photograph. Measured at 390x844 the last four screens of this
 * page carried zero percent image coverage — the weakest possible ground on
 * which to ask for the job. The frame is the one displaced from the hero when
 * the video took that slot, so nothing new is loaded that the page did not
 * already carry.
 */
const closer = startLanding.images.hero;
const closerSrc = imageOrPlaceholder(closer.src);
---

<section
  class="relative overflow-hidden bg-brand-black px-4 py-14 text-white sm:px-6 sm:py-16 lg:px-8"
  aria-labelledby="start-final-heading"
>
  <div class="absolute inset-0" aria-hidden="true">
    <!--
      This section has no max-width wrapper, so the frame really does render
      edge-to-edge on mobile — 100vw there is correct. Past 768px it is still
      full-bleed, but the image sits behind a heavy 78-92% black scrim and is
      only ever a short strip, so there is no reason to fetch a resolution
      past the site's own content cap (design system max width 1180-1280px)
      just because a monitor is wider than that.
    -->
    <SiteImage
      src={closerSrc}
      alt=""
      width={closer.width}
      height={closer.height}
      loading="lazy"
      sizes="(max-width: 768px) 100vw, 1200px"
      class="h-full w-full object-cover object-[center_30%]"
    />
    <div
      class="absolute inset-0 bg-gradient-to-b from-brand-black/78 via-brand-black/84 to-brand-black/92"
    >
    </div>
  </div>

  <div class="relative mx-auto max-w-3xl text-center">
    <h2 id="start-final-heading" class="text-2xl font-bold tracking-tight sm:text-3xl">
      Ready to Elevate Your Home?
    </h2>
    <p class="mx-auto mt-3 max-w-xl text-base leading-relaxed text-white/80">
      Call now or choose a booking path. Veteran-owned handyman service for Katy, Cypress, and West
      Houston.
    </p>

    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <StartCallLink placement="final_cta" variant="final">Call {site.phone}</StartCallLink>
      <StartChooseLink placement="final_cta" variant="final">Choose a Project</StartChooseLink>
    </div>

    <p class="mt-4 max-w-md mx-auto text-sm text-white/65">
      Veteran-owned · Locally operated · Secure online booking through Jobber
    </p>
  </div>
</section>
