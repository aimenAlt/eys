---
import { site } from '../../data/business';
import type { StartCtaPlacement } from '../../data/startLanding';

interface Props {
  variant?: 'header' | 'hero' | 'sticky' | 'final' | 'text';
  placement: StartCtaPlacement;
  class?: string;
}

const { variant = 'hero', placement, class: className } = Astro.props;

const variantClasses = {
  header:
    'inline-flex min-h-11 items-center justify-center rounded-md border border-white/40 px-4 py-2.5 text-sm font-bold text-white hover:border-white hover:bg-white/10',
  hero: 'inline-flex min-h-12 w-full items-center justify-center rounded-md border-2 border-white/85 bg-transparent px-5 py-3.5 text-center text-base font-bold text-white hover:bg-white hover:text-brand-black sm:w-auto',
  sticky:
    'inline-flex min-h-12 flex-1 items-center justify-center rounded-md bg-white px-3 py-3 text-center text-sm font-bold text-brand-black',
  final:
    'inline-flex min-h-12 w-full items-center justify-center rounded-md border-2 border-white px-5 py-3.5 text-center text-base font-bold text-white hover:bg-white hover:text-brand-black sm:w-auto',
  text: 'inline-flex min-h-11 items-center text-sm font-bold text-brand-redondark underline-offset-4 hover:underline',
} as const;
---

<a
  href={`tel:${site.phoneTel}`}
  data-cta-location={placement}
  class:list={[variantClasses[variant], className]}
  aria-label={`Call Elevate Your Space Handyman at ${site.phone}`}
>
  <slot>Call {site.phone}</slot>
</a>
