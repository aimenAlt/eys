---
import { business, googleReviewProfileUrl, site } from '../../data/business';
import { withBase } from '../../utils/paths';

const gbpUrl = googleReviewProfileUrl();
const year = new Date().getFullYear();

const links = [
  { label: 'Book', href: withBase('/book/') },
  { label: 'Curtains', href: withBase('/curtain-installation/') },
  { label: 'Services', href: withBase('/services/') },
  { label: 'Our Work', href: withBase('/our-work/') },
  { label: 'Reviews', href: withBase('/reviews/') },
  { label: 'Privacy', href: withBase('/privacy/') },
  { label: 'Terms', href: withBase('/terms/') },
] as const;
---

<footer
  class="border-t border-white/10 bg-brand-black px-4 py-8 text-white sm:px-6 lg:px-8"
  data-start-footer
>
  <div class="mx-auto max-w-6xl">
    <div class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
      <div>
        <p class="text-base font-bold">{site.name}</p>
        <p class="mt-2 text-sm text-white/70">Serving {business.address.publicLocality}</p>
        {
          gbpUrl ? (
            <p class="mt-2 text-sm">
              <a
                href={gbpUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-track-review
                data-cta-location="footer"
                class="font-bold text-brand-redondark hover:underline"
              >
                {business.googleReviews.rating.toFixed(1)} ★ · {business.googleReviews.countDisplay} Google
                Reviews
              </a>
            </p>
          ) : null
        }
        <p class="mt-2 text-sm text-white/70">
          <a href={`tel:${site.phoneTel}`} data-cta-location="footer" class="hover:text-white">
            {site.phone}
          </a>
        </p>
      </div>

      <nav class="flex flex-wrap gap-x-5 gap-y-3" aria-label="Landing page footer">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="inline-flex min-h-11 items-center text-sm font-semibold text-white/75 hover:text-white"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
    <p class="mt-8 text-xs text-white/45">
      © {year} {site.name}. All rights reserved.
    </p>
  </div>
</footer>
