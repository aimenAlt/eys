---
import { startFaqs } from '../../data/startLanding';
import StartCallLink from './StartCallLink.astro';
import { site } from '../../data/business';

const faqs = startFaqs();
---

<section
  class="bg-white px-4 py-12 sm:px-6 sm:py-16 lg:px-8"
  aria-labelledby="start-faq-heading"
>
  <div class="mx-auto max-w-3xl">
    <h2
      id="start-faq-heading"
      class="text-2xl font-bold tracking-tight text-brand-black sm:text-3xl"
    >
      Frequently Asked Questions
    </h2>

    <div class="mt-8 divide-y divide-brand-line border-y border-brand-line">
      {
        faqs.map((faq) => (
          <details class="group py-4">
            <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 text-left text-base font-bold text-brand-black">
              <span>{faq.question}</span>
              <span
                class="shrink-0 text-brand-red transition-transform group-open:rotate-45"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-brand-muted sm:text-base">{faq.answer}</p>
          </details>
        ))
      }
    </div>

    <p class="mt-6 text-sm text-brand-muted">
      Prefer to talk it through?
      <StartCallLink placement="faq" variant="text" class="ml-1 !text-brand-red">
        Call {site.phone} →
      </StartCallLink>
    </p>
  </div>
</section>
