---
import SiteImage from '../ui/SiteImage.astro';
import { startLanding, startRemodelingHref } from '../../data/startLanding';
import { imageOrPlaceholder } from '../../data/images';
import { withBase } from '../../utils/paths';
import StartJobberLink from './StartJobberLink.astro';

const photo = startLanding.images.generalContracting;
const photoSrc = imageOrPlaceholder(photo.src);

const subLinkClass =
  'inline-flex min-h-11 items-center text-sm font-bold text-white/80 underline-offset-4 hover:text-white hover:underline';
---

<section
  id="general-contracting"
  class="bg-brand-black px-4 py-12 text-white sm:px-6 sm:py-14 lg:px-8"
  aria-labelledby="start-gc-heading"
  data-cta-location="general_contracting"
>
  <div class="mx-auto grid max-w-6xl gap-8 lg:grid-cols-12 lg:items-center lg:gap-10">
    <div class="lg:col-span-5">
      <p class="text-[11px] font-bold uppercase tracking-[0.16em] text-brand-redondark sm:text-xs">
        A Closer Look
      </p>
      <h2 id="start-gc-heading" class="mt-3 text-2xl font-bold tracking-tight sm:text-3xl">
        Remodeling &amp; General Contracting
      </h2>
      <p class="mt-3 max-w-md text-base leading-relaxed text-white/80">
        Kitchens, baths, room upgrades, and coordinated multi-trade work with one point of
        accountability — not a punch-list visit.
      </p>
      <p class="mt-3 max-w-md text-sm leading-relaxed text-white/65">
        Send photos of the space. We’ll review the scope, trades, and next step before anything is
        scheduled. Not a remodel? A General Quote up top covers any other project.
      </p>
      <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
        <StartJobberLink
          service="custom_project"
          placement="general_contracting"
          featured
          class="sm:w-auto"
        >
          Request a Remodeling Estimate
        </StartJobberLink>
        <a
          href={withBase(startRemodelingHref)}
          class={subLinkClass}
        >
          See remodeling services →
        </a>
      </div>

      <p class="mt-4 text-sm leading-relaxed text-white/65">
        Starting with one room?{' '}
        <a href={withBase('/services/kitchen-remodeling/')} class={subLinkClass}>
          Kitchen upgrades
        </a>{' '}
        <span aria-hidden="true">·</span>{' '}
        <a href={withBase('/services/bathroom-remodeling/')} class={subLinkClass}>
          Bathroom upgrades
        </a>
      </p>
    </div>

    <figure class="relative overflow-hidden rounded-xl shadow-card lg:col-span-7">
      <SiteImage
        src={photoSrc}
        alt={photo.alt}
        width={photo.width}
        height={photo.height}
        loading="lazy"
        sizes="(max-width: 1024px) 100vw, 58vw"
        class="aspect-[4/5] w-full object-cover sm:aspect-[16/10] lg:aspect-[5/4]"
      />
      <figcaption
        class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent px-4 pb-4 pt-16 text-sm font-bold text-white"
      >
        {photo.label}
      </figcaption>
    </figure>
  </div>
</section>
