---
import { startLanding, todoListFromPrice } from '../../data/startLanding';
import StartCallLink from './StartCallLink.astro';
import StartChooseLink from './StartChooseLink.astro';
import StartJobberLink from './StartJobberLink.astro';
import { site } from '../../data/business';

/**
 * The hero leads with footage of a finished media wall rather than a still,
 * matching `/services/media-walls/`. The poster paints immediately (~56KB) so
 * LCP is unaffected; the mp4 itself is lazy — `preload="none"` plus a `data-src`
 * the in-view script swaps in.
 *
 * It renders twice because the two breakpoints place it differently: full-bleed
 * behind the copy on mobile, and as a captioned figure in the right column on
 * desktop. Exactly one is displayed at a time and the script only loads the copy
 * that is actually rendered, so the file is never fetched twice.
 *
 * `startLanding.images.hero` is still the page's OG image and now renders
 * further down in StartVideoBuiltIn — the two simply traded places.
 *
 * Playback is wired by the shared VideoAutoplayScript, which loads only the
 * copy rendered at the current breakpoint.
 */
const heroVideo = startLanding.images.videos.builtIn;

/** Read from the pricing module — never a hardcoded dollar figure. */
const todoFrom = todoListFromPrice();

/**
 * Both tiles are links straight into the matching Jobber form — they read as
 * offers, so leaving them inert wasted the two highest-contrast blocks in the
 * hero. Hover/focus lift and the arrow in the headline signal that.
 *
 * The headline is the category and the eyebrow is the offer, not the other way
 * round: `Free Quote` and `Free Estimate` read as the same thing, so the line
 * that has to be scannable is the one that tells you which tile is yours.
 *
 * The second tile is the To-Do List visit, not media walls: /start/ now takes
 * the majority of paid handyman clicks, whose best-performing ads sell exactly
 * that ("Honey-Do Lists Done Right", the "Handyman To-Do List Visit" sitelink).
 * Media walls have their own campaign and landing page, and keep their card in
 * StartPaths — this is emphasis, not removal.
 */
const offerCardClass =
  'block rounded-xl border border-white/35 bg-black/60 p-4 backdrop-blur-[2px] transition-colors hover:border-white/55 hover:bg-black/75 lg:border-white/25 lg:bg-white/5 lg:backdrop-blur-none lg:hover:border-white/45 lg:hover:bg-white/10';
/**
 * The offer, not the category, carries the red: `free` is the word worth
 * shouting, and white/60 over the hero video was the faintest text on the page
 * sitting on its busiest background.
 */
const offerEyebrowClass =
  'text-xs font-bold uppercase tracking-[0.12em] text-brand-redondark';
const offerHeadlineClass = 'mt-2 text-2xl font-bold tracking-tight text-white';
const offerCopyClass = 'mt-1 text-sm text-white/90 lg:text-white/80';
const offerArrowClass = 'ml-1.5 text-brand-redondark';
---

<section
  class="relative overflow-hidden bg-brand-black px-4 pb-10 pt-8 text-white sm:px-6 sm:pb-14 sm:pt-10 lg:px-8"
  aria-labelledby="start-hero-heading"
  data-autoplay-video
  data-video-source-page="start"
  data-no-cross-sell-event
>
  <div class="absolute inset-0 lg:hidden" aria-hidden="true">
    <video
      class="h-full w-full object-cover object-[center_30%]"
      data-autoplay-video-el
      poster={heroVideo.poster}
      width={heroVideo.width}
      height={heroVideo.height}
      muted
      loop
      playsinline
      preload="none"
      disablepictureinpicture
    >
      <source data-src={heroVideo.src} type="video/mp4" />
    </video>
    <!--
      One scrim, not two. The previous pair — a flat 55% black under a
      50/60/80 gradient — composited to 78-91% coverage, which was fine when
      this was a still used as texture but left the video averaging 22-32 of
      255: effectively black. These stops roughly double that while staying the
      brightest the copy can carry — sampled across five frames of the clip, the
      body paragraph holds 4.6:1 against white on its hottest pixel, just over
      the 4.5:1 floor for normal text. Brighten further and that band fails.
    -->
    <div
      class="absolute inset-0 bg-gradient-to-b from-brand-black/45 via-brand-black/58 to-brand-black/75"
    >
    </div>
  </div>

  <div class="relative mx-auto grid max-w-6xl items-start gap-8 lg:grid-cols-2 lg:items-center lg:gap-12">
    <div>
      <p class="mb-3 text-[11px] font-bold uppercase tracking-[0.16em] text-brand-redondark sm:text-xs">
        Veteran-Owned · Katy &amp; West Houston
      </p>
      <h1
        id="start-hero-heading"
        class="text-3xl font-bold leading-tight tracking-tight [text-shadow:0_2px_18px_rgba(0,0,0,0.55)] sm:text-4xl lg:text-[2.75rem] lg:[text-shadow:none]"
      >
        Handyman Service in Katy &amp; West Houston
      </h1>
      <p
        class="mt-3 max-w-xl text-base leading-relaxed text-white/90 [text-shadow:0_1px_12px_rgba(0,0,0,0.45)] sm:text-lg lg:text-white/85 lg:[text-shadow:none]"
      >
        From media walls and high-ceiling curtains to remodeling, general contracting, and everyday
        repairs — call or choose a path to get started.
      </p>

      <div class="mt-7 grid gap-3 sm:grid-cols-2">
        <StartJobberLink
          service="project_estimate"
          placement="hero_offer_quote"
          variant="bare"
          class={offerCardClass}
        >
          <p class={offerEyebrowClass}>Free Quote</p>
          <p class={offerHeadlineClass}>
            Any Project<span class={offerArrowClass} aria-hidden="true">→</span>
          </p>
          <p class={offerCopyClass}>Repairs, upgrades, remodeling, and one-off work</p>
        </StartJobberLink>
        <StartJobberLink
          service="todo_list"
          placement="hero_offer_todo"
          variant="bare"
          class={offerCardClass}
        >
          <p class={offerEyebrowClass}>From {todoFrom}</p>
          <p class={offerHeadlineClass}>
            To-Do List Visit<span class={offerArrowClass} aria-hidden="true">→</span>
          </p>
          <p class={offerCopyClass}>
            Several small repairs and installs, knocked out in one visit
          </p>
        </StartJobberLink>
      </div>

      <div class="mt-6" data-start-hero-cta>
        <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <StartCallLink placement="hero" variant="hero">Call {site.phone}</StartCallLink>
          <StartChooseLink placement="hero" variant="hero">Choose a Project</StartChooseLink>
        </div>
        <p class="mt-3 max-w-md text-sm leading-relaxed text-white/80 lg:text-white/70">
          Prefer to talk it through first? Call and we’ll point you to the right next step.
        </p>
      </div>
    </div>

    <figure class="relative mx-auto hidden w-full max-w-md overflow-hidden rounded-xl lg:block lg:max-w-none">
      <video
        class="aspect-[3/4] h-auto w-full object-cover"
        data-autoplay-video-el
          poster={heroVideo.poster}
        width={heroVideo.width}
        height={heroVideo.height}
        muted
        loop
        playsinline
        preload="none"
        disablepictureinpicture
        aria-label={heroVideo.label}
      >
        <source data-src={heroVideo.src} type="video/mp4" />
      </video>
      <figcaption
        class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent px-4 pb-4 pt-10 text-sm font-bold text-white"
      >
        {heroVideo.label}
      </figcaption>
    </figure>
  </div>
</section>
