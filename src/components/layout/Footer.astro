---
import Logo from './Logo.astro';
import { footerNav } from '../../data/navigation';
import { business, googleReviewCountDisplay, googleReviewProfileUrl, site, socialProfiles } from '../../data/business';
import { withBase } from '../../utils/paths';

// Brand glyphs from Simple Icons (CC0), 24×24 viewBox, drawn in currentColor.
const socialLinks = [
  { label: 'Facebook', href: socialProfiles.facebook, icon: 'M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z' },
  { label: 'Instagram', href: socialProfiles.instagram, icon: 'M7.0301.084c-1.2768.0602-2.1487.264-2.911.5634-.7888.3075-1.4575.72-2.1228 1.3877-.6652.6677-1.075 1.3368-1.3802 2.127-.2954.7638-.4956 1.6365-.552 2.914-.0564 1.2775-.0689 1.6882-.0626 4.947.0062 3.2586.0206 3.6671.0825 4.9473.061 1.2765.264 2.1482.5635 2.9107.308.7889.72 1.4573 1.388 2.1228.6679.6655 1.3365 1.0743 2.1285 1.38.7632.295 1.6361.4961 2.9134.552 1.2773.056 1.6884.069 4.9462.0627 3.2578-.0062 3.668-.0207 4.9478-.0814 1.28-.0607 2.147-.2652 2.9098-.5633.7889-.3086 1.4578-.72 2.1228-1.3881.665-.6682 1.0745-1.3378 1.3795-2.1284.2957-.7632.4966-1.636.552-2.9124.056-1.2809.0692-1.6898.063-4.948-.0063-3.2583-.021-3.6668-.0817-4.9465-.0607-1.2797-.264-2.1487-.5633-2.9117-.3084-.7889-.72-1.4568-1.3876-2.1228C21.2982 1.33 20.628.9208 19.8378.6165 19.074.321 18.2017.1197 16.9244.0645 15.6471.0093 15.236-.005 11.977.0014 8.718.0076 8.31.0215 7.0301.0839m.1402 21.6932c-1.17-.0509-1.8053-.2453-2.2287-.408-.5606-.216-.96-.4771-1.3819-.895-.422-.4178-.6811-.8186-.9-1.378-.1644-.4234-.3624-1.058-.4171-2.228-.0595-1.2645-.072-1.6442-.079-4.848-.007-3.2037.0053-3.583.0607-4.848.05-1.169.2456-1.805.408-2.2282.216-.5613.4762-.96.895-1.3816.4188-.4217.8184-.6814 1.3783-.9003.423-.1651 1.0575-.3614 2.227-.4171 1.2655-.06 1.6447-.072 4.848-.079 3.2033-.007 3.5835.005 4.8495.0608 1.169.0508 1.8053.2445 2.228.408.5608.216.96.4754 1.3816.895.4217.4194.6816.8176.9005 1.3787.1653.4217.3617 1.056.4169 2.2263.0602 1.2655.0739 1.645.0796 4.848.0058 3.203-.0055 3.5834-.061 4.848-.051 1.17-.245 1.8055-.408 2.2294-.216.5604-.4763.96-.8954 1.3814-.419.4215-.8181.6811-1.3783.9-.4224.1649-1.0577.3617-2.2262.4174-1.2656.0595-1.6448.072-4.8493.079-3.2045.007-3.5825-.006-4.848-.0608M16.953 5.5864A1.44 1.44 0 1 0 18.39 4.144a1.44 1.44 0 0 0-1.437 1.4424M5.8385 12.012c.0067 3.4032 2.7706 6.1557 6.173 6.1493 3.4026-.0065 6.157-2.7701 6.1506-6.1733-.0065-3.4032-2.771-6.1565-6.174-6.1498-3.403.0067-6.156 2.771-6.1496 6.1738M8 12.0077a4 4 0 1 1 4.008 3.9921A3.9996 3.9996 0 0 1 8 12.0077' },
  { label: 'TikTok', href: socialProfiles.tiktok, icon: 'M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z' },
] as const;
---

    <footer id="contact" data-site-footer class="bg-brand-black text-white pt-16 pb-24 md:pb-8 border-t-4 border-brand-red">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12 mb-12">
                
                <!-- Col 1 -->
                <div>
                    <Logo variant="footer" class="mb-4" />
                    <p class="text-neutral-400 text-sm leading-relaxed mb-4">
                        Elevate Your Space Handyman is the company you call for dependable service and high-quality work. For a head start on your home renovation project, contact us right away!
                    </p>
                    {
                      googleReviewProfileUrl() && (
                        <p class="text-sm mb-3">
                          <a
                            href={googleReviewProfileUrl()}
                            target="_blank"
                            rel="noopener noreferrer"
                            data-track-review
                            data-cta-location="footer"
                            class="inline-block py-1 text-brand-red hover:underline font-medium"
                          >
                            {business.googleReviews.rating.toFixed(1)} ★ · {googleReviewCountDisplay()} Google Reviews
                          </a>
                        </p>
                      )
                    }
                    <nav aria-label="Social profiles" class="flex flex-wrap gap-3">
                      {socialLinks.map((link) => (
                        <a
                          href={link.href}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label={`Elevate Your Space Handyman on ${link.label}`}
                          title={link.label}
                          class="inline-flex items-center justify-center w-11 h-11 rounded-full border border-neutral-700 text-neutral-300 hover:text-white hover:bg-brand-red hover:border-brand-red focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-red transition-colors"
                        >
                          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={link.icon} /></svg>
                        </a>
                      ))}
                    </nav>
                </div>

                <!-- Col 2 -->
                <div>
                    <h3 class="text-lg font-bold mb-4 border-b border-neutral-800 pb-2 inline-block">Get in touch</h3>
                    <address class="not-italic">
                    <ul class="space-y-4 text-sm text-neutral-400">
                        <li class="flex items-start">
                            <svg class="w-5 h-5 text-brand-red mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                            {
                              business.publishAddress ? (
                                <a
                                  href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(business.address.formatted)}`}
                                  class="hover:text-brand-red transition-colors"
                                  target="_blank"
                                  rel="noopener noreferrer"
                                >
                                  {business.address.formatted}
                                </a>
                              ) : (
                                <span>
                                  Serving {business.address.publicLocality}
                                  {' · '}
                                  <a href={withBase('/service-areas/')} class="hover:text-brand-red transition-colors underline-offset-2 hover:underline">
                                    Service areas
                                  </a>
                                </span>
                              )
                            }
                        </li>
                        <li class="flex items-center">
                            <svg class="w-5 h-5 text-brand-red mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                            <a href={`mailto:${site.email}`} data-cta-location="footer" class="inline-block py-1 hover:text-brand-red transition-colors">{site.email}</a>
                        </li>
                        <li class="flex items-center">
                            <svg class="w-5 h-5 text-brand-red mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                            <a href={`tel:${site.phoneTel}`} data-cta-location="footer" class="inline-block py-1 hover:text-brand-red transition-colors">{site.phone}</a>
                        </li>
                    </ul>
                    </address>
                </div>

                <!-- Col 3 -->
                <div>
                    <h3 class="text-lg font-bold mb-4 border-b border-neutral-800 pb-2 inline-block">Quick Links</h3>
                    <ul class="space-y-2 text-sm text-neutral-400">
                        {footerNav.map((item) => (
                            <li>
                                <a
                                  href={withBase(item.href)}
                                  class="hover:text-brand-red transition-colors"
                                  {...(item.ctaId ? { 'data-cta-id': item.ctaId } : {})}
                                >{item.label}</a>
                            </li>
                        ))}
                    </ul>
                </div>

            </div>
            
            <div class="border-t border-neutral-800 pt-8 flex flex-col md:flex-row justify-between items-center text-xs text-neutral-400">
                <p>&copy; 2026 Elevate Your Space Handyman. All rights reserved.</p>
                <div class="mt-4 md:mt-0 space-x-4">
                    <a href={withBase('/privacy/')} class="hover:text-brand-red transition-colors">Privacy Policy</a>
                    <a href={withBase('/terms/')} class="hover:text-brand-red transition-colors">Terms of Service</a>
                    <a href={withBase('/privacy/#your-privacy-choices')} class="hover:text-brand-red transition-colors">Your Privacy Choices</a>
                </div>
            </div>
        </div>
    </footer>
