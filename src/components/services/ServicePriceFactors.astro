---
import { contentMaxClass, contentPaddingClass } from '../../data/layout';

interface Props {
  items?: string[];
  embedded?: boolean;
}

const { items, embedded = false } = Astro.props;
---

{
  items && items.length > 0 && (
    embedded ? (
      <section aria-labelledby="price-factors">
        <h2 id="price-factors" class="eys-h2 text-eys-ink mb-6">
          What affects price
        </h2>
        <div class="grid gap-4 sm:grid-cols-2">
          {items.map((item) => (
            <div class="eys-item">
              <span class="eys-item-badge" aria-hidden="true">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8V7m0 9v1m0-10a9 9 0 100 18 9 9 0 000-18z" />
                </svg>
              </span>
              <span class="eys-item-text">{item}</span>
            </div>
          ))}
        </div>
      </section>
    ) : (
      <section class="eys-section bg-white" aria-labelledby="price-factors">
        <div class:list={['mx-auto', contentMaxClass, contentPaddingClass]}>
          <p class="eys-eyebrow eys-kicker text-eys-ink-2 mb-4">Pricing</p>
          <h2 id="price-factors" class="eys-h2 text-eys-ink mb-8">
            What affects price
          </h2>
          <div class="grid gap-4 sm:grid-cols-2">
            {items.map((item) => (
              <div class="eys-item">
                <span class="eys-item-badge" aria-hidden="true">
                  <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8V7m0 9v1m0-10a9 9 0 100 18 9 9 0 000-18z" />
                  </svg>
                </span>
                <span class="eys-item-text">{item}</span>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  )
}
