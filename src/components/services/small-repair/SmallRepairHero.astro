---
import {
  additionalTimeLabel,
  formatUsd,
  smallRepairPricing,
} from '../../../data/pricing/todoList';
import { smallRepairVisitMeta } from '../../../data/smallRepairVisitContent';
import { jobberHandymanToDoListFormUrl, localityShort, site } from '../../../data/business';
import SiteImage from '../../ui/SiteImage.astro';
import { resolveServiceHero } from '../../../data/images';
import { projectEstimateRequestUrl } from '../../../data/requestFirstCtas';

const heroImage = resolveServiceHero('handyman-to-do-list');
const bookUrl = jobberHandymanToDoListFormUrl();
const requestUrl = projectEstimateRequestUrl('todo-list-request') ?? '/contact/';
---

<section class="eys-page-hero eys-on-dark">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 lg:pt-16">
    <div class="lg:grid lg:grid-cols-12 lg:gap-12 items-center">
      <div class="lg:col-span-7">
        <p class="eys-eyebrow eys-kicker mb-4 text-eys-on-dark-2">
          {smallRepairVisitMeta.heroEyebrow}
        </p>
        <h1 class="eys-h1 mb-6">
          {smallRepairVisitMeta.heroTitle}
        </h1>
        <!--
          Request-first pair right under the H1 (backlog 008, on top of 004's
          above-the-fold pair): the slot-booking form leaked (18 opens, 0
          submissions), so the primary action is the simple request form + Call;
          booking a slot stays as the secondary link below. Prices from todoList.ts only.
        -->
        <div class="mb-3 grid grid-cols-2 gap-3 sm:max-w-md">
          <a
            href={requestUrl}
            data-booking-type="project_estimate"
            data-cta-location="todo_hero_request"
            class="eys-hero-btn eys-hero-btn--red !px-3 text-sm sm:text-base"
          >
            Send your list, get a time
          </a>
          <a
            href={`tel:${site.phoneTel}`}
            data-cta-location="handyman_to_do_list_hero_call"
            class="eys-hero-btn eys-hero-btn--outline !px-3 text-sm sm:text-base"
            aria-label={`Call Elevate Your Space Handyman at ${site.phone}`}
          >
            Call {site.phone}
          </a>
        </div>
        <p class="mb-5 text-sm text-eys-on-dark-2">
          Prefer to pick a slot?{' '}
          <a
            href={bookUrl ?? '#book-visit'}
            target={bookUrl ? '_blank' : undefined}
            rel={bookUrl ? 'noopener noreferrer' : undefined}
            data-booking-type="handyman_to_do_list"
            data-cta-location="handyman_to_do_list_hero_form"
            class="eys-text-link-dark font-bold text-eys-on-dark underline underline-offset-2"
          >Book a 1- or 2-hour visit</a>{' '}
          <span class="whitespace-nowrap">(from {formatUsd(smallRepairPricing.oneHour)})</span>
        </p>
        <p class="eys-page-hero-lede eys-body mb-6 max-w-2xl">
          {smallRepairVisitMeta.heroSummary}
        </p>

        <dl class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-6">
          <div class="rounded-xl border border-eys-panel-line bg-eys-panel p-4">
            <dt class="text-xs font-bold uppercase tracking-wide text-eys-on-dark-3 mb-1">
              Starting at
            </dt>
            <dd class="text-xl font-display text-eys-on-dark">
              {formatUsd(smallRepairPricing.oneHour)}
            </dd>
            <dd class="text-xs text-eys-on-dark-3 mt-0.5">1-hour visit</dd>
          </div>
          <div class="rounded-xl border border-eys-panel-line bg-eys-panel p-4">
            <dt class="text-xs font-bold uppercase tracking-wide text-eys-on-dark-3 mb-1">
              Two-hour visit
            </dt>
            <dd class="text-xl font-display text-eys-on-dark">
              {formatUsd(smallRepairPricing.twoHours)}
            </dd>
            <dd class="text-xs text-eys-on-dark-3 mt-0.5">Most common for lists</dd>
          </div>
          <div class="rounded-xl border border-eys-panel-line bg-eys-panel p-4">
            <dt class="text-xs font-bold uppercase tracking-wide text-eys-on-dark-3 mb-1">
              Additional time
            </dt>
            <dd class="text-lg font-display text-eys-on-dark leading-snug">
              {additionalTimeLabel}
            </dd>
            <dd class="text-xs text-eys-on-dark-3 mt-0.5">Beyond your booked visit length</dd>
          </div>
        </dl>

        <p class="text-sm text-eys-on-dark-2 mb-8 border-l-4 border-eys-stripe pl-4 leading-relaxed">
          {smallRepairVisitMeta.qualification}
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          {
            bookUrl ? (
              <a
                href={bookUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="eys-hero-btn eys-hero-btn--red"
              >
                Book a Handyman Visit
              </a>
            ) : (
              <a
                href="#book-visit"
                class="eys-hero-btn eys-hero-btn--red"
              >
                Book a Handyman Visit
              </a>
            )
          }
          <a
            href="#eligible-tasks"
            class="eys-hero-btn eys-hero-btn--outline"
          >
            See Eligible Tasks
          </a>
        </div>
        <p class="mt-4 text-sm text-eys-on-dark-3">
          Serving {localityShort('&')} · <a
            href={`tel:${site.phoneTel}`}
            class="eys-text-link-dark font-semibold text-eys-on-dark hover:underline">{site.phone}</a
          >
        </p>
      </div>
      <div class="lg:col-span-5 mt-10 lg:mt-0">
        <div class="eys-page-hero-media"><div class="eys-page-hero-frame">
        <SiteImage
          src={heroImage}
          alt="Handyman completing home to-do list tasks during a reserved visit in Katy, TX"
          class="w-full h-72 sm:h-96 object-cover"
          sizes="(max-width: 1024px) 100vw, 500px"
          width={800}
          height={600}
          loading="eager"
        />
        </div></div>
      </div>
    </div>
  </div>
  <div class="eys-stripe" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
</section>
