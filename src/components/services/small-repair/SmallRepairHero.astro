---
import {
  additionalTimeLabel,
  formatUsd,
  smallRepairPricing,
} from '../../../data/pricing/todoList';
import { smallRepairVisitMeta } from '../../../data/smallRepairVisitContent';
import { jobberHandymanToDoListFormUrl, localityShort, site } from '../../../data/business';
import SiteImage from '../../ui/SiteImage.astro';
import { resolveServiceHero } from '../../../data/images';

const heroImage = resolveServiceHero('handyman-to-do-list');
const bookUrl = jobberHandymanToDoListFormUrl();
---

<section class="relative bg-white pt-12 pb-14 lg:pt-16 lg:pb-20 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="lg:grid lg:grid-cols-12 lg:gap-12 items-center">
      <div class="lg:col-span-7">
        <p class="text-brand-red font-bold text-xs tracking-widest uppercase mb-3">
          {smallRepairVisitMeta.heroEyebrow}
        </p>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-brand-black leading-tight tracking-tight mb-4">
          {smallRepairVisitMeta.heroTitle}
        </h1>
        <!--
          Compact call + book pair right under the H1 (backlog 004): the page's
          first CTA used to sit below the fold on a 390px phone, and this is a
          Google Ads sitelink landing page. Price from todoList.ts only.
        -->
        <div class="mb-5 grid grid-cols-2 gap-3 sm:max-w-md">
          <a
            href={`tel:${site.phoneTel}`}
            data-cta-location="handyman_to_do_list_hero_call"
            class="inline-flex min-h-12 items-center justify-center rounded-md bg-brand-red px-3 py-3 text-center text-sm font-bold text-white hover:bg-brand-redhover sm:text-base"
            aria-label={`Call Elevate Your Space Handyman at ${site.phone}`}
          >
            Call {site.phone}
          </a>
          <a
            href={bookUrl ?? '#book-visit'}
            target={bookUrl ? '_blank' : undefined}
            rel={bookUrl ? 'noopener noreferrer' : undefined}
            data-booking-type="handyman_to_do_list"
            data-cta-location="handyman_to_do_list_hero_form"
            class="inline-flex min-h-12 items-center justify-center rounded-md border-2 border-brand-black px-3 py-3 text-center text-sm font-bold text-brand-black hover:bg-brand-black hover:text-white sm:text-base"
          >
            Book · from {formatUsd(smallRepairPricing.oneHour)}
          </a>
        </div>
        <p class="text-lg text-neutral-600 mb-6 leading-relaxed max-w-2xl">
          {smallRepairVisitMeta.heroSummary}
        </p>

        <dl class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-6">
          <div class="rounded-lg border border-brand-line bg-brand-lightbg p-4">
            <dt class="text-xs font-bold uppercase tracking-wide text-brand-muted mb-1">
              Starting at
            </dt>
            <dd class="text-xl font-extrabold text-brand-black">
              {formatUsd(smallRepairPricing.oneHour)}
            </dd>
            <dd class="text-xs text-neutral-500 mt-0.5">1-hour visit</dd>
          </div>
          <div class="rounded-lg border border-brand-line bg-brand-lightbg p-4">
            <dt class="text-xs font-bold uppercase tracking-wide text-brand-muted mb-1">
              Two-hour visit
            </dt>
            <dd class="text-xl font-extrabold text-brand-black">
              {formatUsd(smallRepairPricing.twoHours)}
            </dd>
            <dd class="text-xs text-neutral-500 mt-0.5">Most common for lists</dd>
          </div>
          <div class="rounded-lg border border-brand-line bg-brand-lightbg p-4">
            <dt class="text-xs font-bold uppercase tracking-wide text-brand-muted mb-1">
              Additional time
            </dt>
            <dd class="text-lg font-extrabold text-brand-black leading-snug">
              {additionalTimeLabel}
            </dd>
            <dd class="text-xs text-neutral-500 mt-0.5">Beyond your booked visit length</dd>
          </div>
        </dl>

        <p class="text-sm text-neutral-600 mb-8 border-l-4 border-brand-red pl-4 leading-relaxed">
          {smallRepairVisitMeta.qualification}
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          {
            bookUrl ? (
              <a
                href={bookUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="gradient-btn text-white px-8 py-3.5 rounded-md font-bold text-center transition-all shadow-lg hover:shadow-xl"
              >
                Book a Handyman Visit
              </a>
            ) : (
              <a
                href="#book-visit"
                class="gradient-btn text-white px-8 py-3.5 rounded-md font-bold text-center transition-all shadow-lg hover:shadow-xl"
              >
                Book a Handyman Visit
              </a>
            )
          }
          <a
            href="#eligible-tasks"
            class="bg-white text-brand-black border-2 border-brand-black px-8 py-3.5 rounded-md font-bold text-center hover:bg-brand-black hover:text-white transition-all"
          >
            See Eligible Tasks
          </a>
        </div>
        <p class="mt-4 text-sm text-neutral-500">
          Serving {localityShort('&')} · <a
            href={`tel:${site.phoneTel}`}
            class="font-semibold text-brand-red hover:underline">{site.phone}</a
          >
        </p>
      </div>
      <div class="lg:col-span-5 mt-10 lg:mt-0">
        <SiteImage
          src={heroImage}
          alt="Handyman completing home to-do list tasks during a reserved visit in Katy, TX"
          class="w-full h-72 sm:h-96 object-cover rounded-xl shadow-card border border-brand-line"
          sizes="(max-width: 1024px) 100vw, 500px"
          width={800}
          height={600}
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>
