---
import type { FaqItem } from '../../data/schema';

interface Props {
  faqs?: FaqItem[];
}

const { faqs } = Astro.props;
---

{
  faqs && faqs.length > 0 && (
    <section class="eys-section bg-white" aria-labelledby="service-faq">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 id="service-faq" class="eys-h2 text-eys-ink mb-12 text-center">
          Frequently Asked Questions
        </h2>
        <div class="space-y-3">
          {faqs.map((faq) => (
            <details class="eys-faq-item group">
              <summary class="eys-text-link flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-5 text-left font-display text-[17px] leading-6 text-eys-ink [text-wrap:balance] lg:px-7 lg:py-6 lg:text-lg">
                {faq.question}
                <span class="eys-faq-plus" aria-hidden="true"></span>
              </summary>
              <div class="eys-body px-5 pb-6 text-eys-ink-2 lg:px-7 lg:pb-7">
                <p>{faq.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}
