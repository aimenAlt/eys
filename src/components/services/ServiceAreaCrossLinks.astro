---
import { localityShort } from '../../data/business';
import { contentMaxClass, contentPaddingClass } from '../../data/layout';

interface CommunityLink {
  title: string;
  href: string;
}

interface Props {
  communities: CommunityLink[];
}

const { communities } = Astro.props;
---

{
  communities.length > 0 && (
    <section class="py-14 md:py-20 bg-brand-lightbg" aria-labelledby="service-areas-served">
      <div class:list={['mx-auto', contentMaxClass, contentPaddingClass]}>
        <h2 id="service-areas-served" class="eys-h2-sm text-eys-ink mb-4">
          Communities we serve
        </h2>
        <p class="eys-body text-eys-ink-2 mb-6 max-w-3xl">
          This service is available throughout {localityShort('and')}, including these master-planned communities:
        </p>
        <ul class="flex flex-wrap gap-2.5">
          {communities.map((c) => (
            <li>
              <a href={c.href} class="eys-pill">
                {c.title}
              </a>
            </li>
          ))}
        </ul>
        <a href="/service-areas/" class="eys-text-link mt-6 inline-block text-[15px] font-bold text-eys-ink underline decoration-eys-stripe decoration-2 underline-offset-4">View all service areas &rarr;</a>
      </div>
    </section>
  )
}
