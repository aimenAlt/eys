---
import BalancedGrid from '../ui/BalancedGrid.astro';
import { contentMaxClass, contentPaddingClass } from '../../data/layout';

interface Props {
  items?: string[];
  embedded?: boolean;
  heading?: string;
  locationName?: string;
  /** Overrides the small red label above the heading. Defaults to 'What We Do'. */
  eyebrow?: string;
  /**
   * Optional line between heading and list, for pages where the list needs
   * attributing as a whole — electrical-services names the licensed electrician
   * here rather than repeating it on all six items.
   */
  note?: string;
}

const {
  items,
  embedded = false,
  heading = 'What We Do',
  locationName,
  eyebrow = 'What We Do',
  note,
} = Astro.props;

const title = locationName ? `What we handle in ${locationName}` : heading;
const checklistItems = (items ?? []).map((text) => ({ text }));
---

{
  checklistItems.length > 0 &&
    (embedded ? (
      <section aria-labelledby="included" data-analytics-section="included_services">
        <h2 id="included" class="eys-h2 text-eys-ink mb-6">
          {title}
        </h2>
        {note && <p class="mb-6 max-w-3xl text-base leading-relaxed text-brand-muted">{note}</p>}
        <BalancedGrid variant="checklist" items={checklistItems} cols={2} gapClass="gap-4" />
      </section>
    ) : (
      <section class="py-16 md:py-20 bg-brand-lightbg" aria-labelledby="included" data-analytics-section="included_services">
        <div class:list={['mx-auto', contentMaxClass, contentPaddingClass]}>
          <p class="eys-eyebrow eys-kicker text-eys-ink-2 mb-2">{eyebrow}</p>
          <h2 id="included" class="eys-h2 text-eys-ink mb-8">
            {title}
          </h2>
          {note && <p class="mt-4 mb-8 max-w-3xl text-base leading-relaxed text-brand-muted">{note}</p>}
          <BalancedGrid variant="checklist" items={checklistItems} cols={2} gapClass="gap-4" />
        </div>
      </section>
    ))
}
