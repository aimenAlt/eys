---
import {
  jobberBathroomRemodelFormUrl,
  jobberKitchenRemodelFormUrl,
  jobberOnlineBookingUrl,
  site,
} from '../../data/business';
import SiteImage from '../ui/SiteImage.astro';
import { imagePlaceholder, resolveServiceHero } from '../../data/images';
import { contentMaxClass, contentPaddingClass } from '../../data/layout';
import { projectEstimateRequestUrl, requestFirstServiceHero } from '../../data/requestFirstCtas';
import { highCeilingJobberUrl } from '../../data/curtainLanding';

interface ServiceData {
  heroTitle?: string;
  title: string;
  summary?: string;
  primaryCTA?: string;
  secondaryCTA?: string;
  bookingType?: string;
  jobberForm?: 'kitchen-remodel' | 'bathroom-remodel';
  slug: string;
  heroImage?: string;
  /** Required by the services content schema — see content.config.ts. */
  heroImageAlt: string;
}

interface Props {
  service: ServiceData;
}

const { service } = Astro.props;
const heading = service.heroTitle ?? service.title;
const bookingUrl = jobberOnlineBookingUrl();
const imageSrc = resolveServiceHero(service.slug, service.heroImage);
/**
 * Alt must describe what actually renders. `resolveServiceHero` silently falls
 * back to the branded placeholder when a registered photo has not been uploaded,
 * and two pages were shipping alt text describing a grab bar and an anti-tip
 * strap that were not in any image. Pages keep their real alt in frontmatter so
 * it is ready the day the photo lands; until then the placeholder describes
 * itself. There is deliberately NO title/geography fallback here - omitting alt
 * used to generate "<title> in Katy and West Houston", a claim about EYS's work
 * attached to whatever image happened to be showing. heroImageAlt is required by
 * the schema, so absence is now a build error rather than a silent claim.
 */
const isPlaceholderImage = imageSrc === imagePlaceholder;
const imageAlt = isPlaceholderImage
  ? 'Elevate Your Space Handyman logo'
  : service.heroImageAlt;

type CtaConfig = {
  href: string;
  label: string;
  external?: boolean;
  /** Set only for dedicated Jobber request forms — drives conversion tracking. */
  jobberService?: string;
};

/** Dedicated Jobber request forms, opted into per service via `jobberForm`. */
const jobberForms = {
  'kitchen-remodel': {
    url: jobberKitchenRemodelFormUrl(),
    service: 'kitchen_remodel',
    label: 'Request a Kitchen Estimate',
  },
  'bathroom-remodel': {
    url: jobberBathroomRemodelFormUrl(),
    service: 'bathroom_remodel',
    label: 'Request a Bathroom Estimate',
  },
} as const;

function primaryCta(): CtaConfig {
  const dedicated = service.jobberForm ? jobberForms[service.jobberForm] : undefined;
  if (dedicated?.url) {
    return {
      href: dedicated.url,
      label: service.primaryCTA ?? dedicated.label,
      external: true,
      jobberService: dedicated.service,
    };
  }

  switch (service.bookingType) {
    case 'direct-book':
      return {
        href: bookingUrl ?? '/book/',
        label: service.primaryCTA ?? 'Book Online',
        external: Boolean(bookingUrl),
      };
    case 'assessment':
      return {
        href: '/contact/',
        label: service.primaryCTA ?? 'Schedule Assessment',
      };
    case 'call-only':
      return {
        href: `tel:${site.phoneTel}`,
        label: service.primaryCTA ?? `Call ${site.phone}`,
      };
    default:
      return {
        href: '/contact/',
        label: service.primaryCTA ?? 'Request a Quote',
      };
  }
}

const primary = primaryCta();

/**
 * Request-first override (backlog 008), opted into per slug in
 * src/data/requestFirstCtas.ts — only /services/curtain-installation/ today.
 * Every other service page renders exactly as before.
 */
const requestFirst = requestFirstServiceHero[service.slug];
const requestFirstUrl = requestFirst ? projectEstimateRequestUrl(requestFirst.eysForm) ?? '/contact/' : undefined;
const bookingSecondaryUrl = requestFirst ? highCeilingJobberUrl() : undefined;
---

<section class="eys-page-hero eys-on-dark" aria-labelledby="service-hero" data-analytics-section="hero">
  <div class:list={['mx-auto', contentMaxClass, contentPaddingClass, 'pt-10 md:pt-16']}>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <div>
        <h1 id="service-hero" class="eys-h1 mb-5">
          {heading}
        </h1>
        {
          service.summary && (
            <p class="eys-page-hero-lede eys-body mb-8">{service.summary}</p>
          )
        }
        <div class="flex flex-col sm:flex-row gap-3" data-sticky-hero-cta>
          {requestFirst ? (
          <a
            href={requestFirstUrl}
            data-cta-location={requestFirst.ctaLocation}
            data-booking-type="project_estimate"
            class="eys-hero-btn eys-hero-btn--red"
          >
            {requestFirst.label}
          </a>
          ) : (
          <a
            href={primary.href}
            target={primary.external ? '_blank' : undefined}
            rel={primary.external ? 'noopener noreferrer' : undefined}
            data-cta-location="service_hero"
            data-booking-type={primary.jobberService}
            data-service-type={primary.jobberService}
            data-curtain-cta={primary.jobberService}
            class="eys-hero-btn eys-hero-btn--red"
          >
            {primary.label}
          </a>
          )}
          <a
            href={`tel:${site.phoneTel}`}
            class="eys-hero-btn eys-hero-btn--outline"
          >
            {service.secondaryCTA ?? `Call ${site.phone}`}
          </a>
        </div>
        {
          requestFirst && bookingSecondaryUrl && (
            <p class="mt-4 text-sm text-eys-on-dark-2">
              <a
                href={bookingSecondaryUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-booking-type="high_ceiling_curtain"
                data-service-type="high_ceiling_curtain"
                data-curtain-cta="high_ceiling"
                data-cta-location="service_hero_booking"
                class="eys-text-link-dark font-bold text-eys-on-dark underline underline-offset-2"
              >{requestFirst.secondaryLabel}</a>
            </p>
          )
        }
      </div>
      <div class="eys-page-hero-media"><div class="eys-page-hero-frame aspect-[4/3]">
        <SiteImage
          src={imageSrc}
          alt={imageAlt}
          class="w-full h-full object-cover"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          sizes="(max-width: 1024px) 100vw, 600px"
          width={800}
          height={600}
        />
      </div></div>
    </div>
  </div>
  <div class="eys-stripe" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
</section>
